import Atlas.Comparisons.Exceptional.E6.Lattice
import Atlas.LinearGroups.Orthogonal.Basic

/-! Actual lattice isometries and the subgroup they generate. -/
namespace Atlas.Comparisons.E6Lattice

variable (R : Type*) [CommRing R]

def reflectionLinearEquiv (i : Fin 6) : (Fin 6 → R) ≃ₗ[R] (Fin 6 → R) where
  toFun := reflection i
  invFun := reflection i
  left_inv := reflection_involutive i
  right_inv := reflection_involutive i
  map_add' x y := by
    funext j
    fin_cases i <;> fin_cases j <;> simp [reflection] <;> ring
  map_smul' a x := by
    funext j
    fin_cases i <;> fin_cases j <;> simp [reflection] <;> ring

def simpleReflection (i : Fin 6) : Atlas.Orthogonal.isometrySubgroup (form R) :=
  ⟨reflectionLinearEquiv R i, fun x => by
    change form R (reflection i x) = form R x
    simpa only [form_apply] using reflection_norm i x⟩

/-- The actual group generated by the six displayed reflections. -/
def weyl : Subgroup (Atlas.Orthogonal.isometrySubgroup (form R)) :=
  Subgroup.closure (Set.range (simpleReflection R))

theorem simpleReflection_mem (i : Fin 6) : simpleReflection R i ∈ weyl R :=
  Subgroup.subset_closure ⟨i,rfl⟩

@[simp] theorem simpleReflection_apply (i : Fin 6) (x : Fin 6 → R) :
    (simpleReflection R i).val x = reflection i x := rfl

end Atlas.Comparisons.E6Lattice
