import Atlas.LinearGroups.Chevalley.Adjoint
import Atlas.LinearGroups.Chevalley.Integral.HeightTriangular

/-! Filtration control for the subgroup generated by the actual positive
simple-root elements. This file does not identify that subgroup with the
full positive-root unipotent subgroup, especially in small characteristic. -/

noncomputable section
namespace Atlas.Chevalley
open Integral

variable {ι M N : Type*} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (R : Type*) [CommRing R]

/-- The subgroup of the actual adjoint group generated by its positive
simple-root families. No all-positive-root generation theorem is implicit. -/
def positiveSimpleAdjointSubgroup : Subgroup (Adjoint P b R) :=
  Subgroup.closure {g | ∃ i t, g = adjointX P b R i t}

theorem adjointX_mem_positiveSimpleAdjointSubgroup (i : b.support) (t : R) :
    adjointX P b R i t ∈ positiveSimpleAdjointSubgroup P b R :=
  Subgroup.subset_closure ⟨i, t, rfl⟩

/-- Every positive-simple word and its inverse is height-unitriangular. -/
theorem positiveSimpleAdjointSubgroup_le_heightUnitriangular :
    positiveSimpleAdjointSubgroup P b R ≤
      (Atlas.Matrix.heightUnitriangularSubgroup (geckHeight P b)).comap
        (adjointSubgroup P b R).subtype := by
  rw [positiveSimpleAdjointSubgroup, Subgroup.closure_le]
  rintro g ⟨i, t, rfl⟩
  exact raisingRootElement_mem_heightUnitriangular P b R i t

theorem positiveSimpleAdjoint_heightUnitriangular (g : Adjoint P b R)
    (hg : g ∈ positiveSimpleAdjointSubgroup P b R) :
    Atlas.Matrix.HeightUnitriangular (geckHeight P b) g.val.val :=
  (positiveSimpleAdjointSubgroup_le_heightUnitriangular P b R hg).1

/-- No nonidentity element in the positive-simple subgroup can be diagonal.
This applies to any later diagonal torus, without assuming a torus/kernel
identification or a positive-root normal form. -/
theorem positiveSimpleAdjoint_eq_one_of_diagonal (g : Adjoint P b R)
    (hg : g ∈ positiveSimpleAdjointSubgroup P b R)
    (hdiag : ∀ row col, row ≠ col → g.val.val row col = 0) : g = 1 := by
  apply Subtype.ext
  apply Units.ext
  exact Atlas.Matrix.HeightUnitriangular.eq_one_of_offDiagonal_zero
    (positiveSimpleAdjoint_heightUnitriangular P b R g hg) hdiag

end Atlas.Chevalley
