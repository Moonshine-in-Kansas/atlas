import Atlas.LinearGroups.Chevalley.WeightCompanionPositiveRootCoherence
import Atlas.LinearGroups.Chevalley.PositiveWitnessedSubgroup

/-! One chosen witness for each positive root generates exactly the existing
all-witness subgroup. Chosen parameter maps are retained, not identified. -/
noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hc : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hm : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R] [Nontrivial R]

/-- A fixed existing witness for each positive root; this makes no canonical
choice of a signed root parameter. -/
def positiveRootChosenLift (β : {β : ι // b.IsPos β}) :
    WeightCompanionRootLift P b O hc hm R β.val :=
  Classical.choice (positiveRoot_has_weightCompanionRootLift P b O hc hm R β.val β.property)

/-- The literal positive-root subgroup, defined using one chosen witness.
Its independence from every witness choice is proved below. -/
def positiveWeightCompanionRootSubgroup (β : {β : ι // b.IsPos β}) :
    Subgroup (WeightCompanion P b O hc hm R) :=
  weightCompanionRootLiftSubgroup P b O hc hm R
    (positiveRootChosenLift P b O hc hm R β)

theorem rootLiftSubgroup_eq_positiveWeightCompanionRootSubgroup
    (hdiamond : SimpleDiamondProducts P b) (β : {β : ι // b.IsPos β})
    (L : WeightCompanionRootLift P b O hc hm R β.val) :
    weightCompanionRootLiftSubgroup P b O hc hm R L =
      positiveWeightCompanionRootSubgroup P b O hc hm R β :=
  weightCompanionRootLiftSubgroup_eq_of_positive P b O hc hm R hdiamond β.property
    L (positiveRootChosenLift P b O hc hm R β)

theorem positiveWeightCompanionRootSubgroup_le_witnessed
    (β : {β : ι // b.IsPos β}) :
    positiveWeightCompanionRootSubgroup P b O hc hm R β ≤
      positiveWitnessedWeightCompanionSubgroup P b O hc hm R := by
  rintro g ⟨t, rfl⟩
  exact rootLiftHom_mem_positiveWitnessedWeightCompanionSubgroup P b O hc hm R
    β.property (positiveRootChosenLift P b O hc hm R β) t

/-- The old all-witness subgroup equals the subgroup generated by one actual
root subgroup for each member of the finite positive-root index type. -/
theorem positiveWitnessedWeightCompanion_eq_iSup_positiveRoots
    (hdiamond : SimpleDiamondProducts P b) :
    positiveWitnessedWeightCompanionSubgroup P b O hc hm R =
      ⨆ β : {β : ι // b.IsPos β}, positiveWeightCompanionRootSubgroup P b O hc hm R β := by
  apply le_antisymm
  · rw [positiveWitnessedWeightCompanionSubgroup, Subgroup.closure_le]
    rintro g ⟨β, hβ, L, t, rfl⟩
    apply Subgroup.mem_iSup_of_mem (⟨β, hβ⟩ : {β : ι // b.IsPos β})
    rw [← rootLiftSubgroup_eq_positiveWeightCompanionRootSubgroup
      P b O hc hm R hdiamond ⟨β, hβ⟩ L]
    exact ⟨t, rfl⟩
  · exact iSup_le (positiveWeightCompanionRootSubgroup_le_witnessed P b O hc hm R)

/-- A subgroup contains U precisely when it contains the finitely indexed
literal positive-root subgroups. This is generation, not collection. -/
theorem positiveWitnessedWeightCompanion_le_iff_positiveRoots
    (hdiamond : SimpleDiamondProducts P b) (H : Subgroup (WeightCompanion P b O hc hm R)) :
    positiveWitnessedWeightCompanionSubgroup P b O hc hm R ≤ H ↔
      ∀ β : {β : ι // b.IsPos β}, positiveWeightCompanionRootSubgroup P b O hc hm R β ≤ H := by
  rw [positiveWitnessedWeightCompanion_eq_iSup_positiveRoots P b O hc hm R hdiamond,
    iSup_le_iff]

end Atlas.Chevalley
