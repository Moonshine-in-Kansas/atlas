import Atlas.GroupTheory.RootScalingKernel
import Atlas.LinearGroups.Chevalley.WeightCompanionCrossTorus
import Mathlib.GroupTheory.Subgroup.Center
/-! Actual torus part of the projection kernel is central.
No assertion that the full kernel is contained in the torus is made. -/
noncomputable section
namespace Atlas.Chevalley
open Group Classical Integral Integral.Minuscule Atlas.GroupTheory


universe u
variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hclosed : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hmin : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨ μ (corootElement P i) = 1)
  (R : Type*) [CommRing R]

/-- The literal subgroup generated by the simultaneous torus words. -/
def weightCompanionTorusSubgroup : Subgroup (WeightCompanion P b O hclosed hmin R) :=
  Subgroup.closure {g | ∃ i a, g=weightCompanionTorus P b O hclosed hmin R i a}

theorem weightCompanionTorusSubgroup_le_X_scaling (i : b.support) :
    weightCompanionTorusSubgroup P b O hclosed hmin R ≤
      rootScalingSubgroup (weightCompanionX P b O hclosed hmin R i) := by
  rw [weightCompanionTorusSubgroup, Subgroup.closure_le]
  rintro g ⟨j,a,rfl⟩
  exact ⟨a ^ b.cartanMatrix i j, weightCompanionTorus_mul_X_cross P b O hclosed hmin R i j a⟩

theorem weightCompanionTorusSubgroup_le_Y_scaling (i : b.support) :
    weightCompanionTorusSubgroup P b O hclosed hmin R ≤
      rootScalingSubgroup (weightCompanionY P b O hclosed hmin R i) := by
  rw [weightCompanionTorusSubgroup, Subgroup.closure_le]
  rintro g ⟨j,a,rfl⟩
  exact ⟨a ^ (-b.cartanMatrix i j), weightCompanionTorus_mul_Y_cross P b O hclosed hmin R i j a⟩

/-- Every actual torus element killed by the adjoint projection is central.
The missing full-kernel-to-torus assertion is deliberately not an assumption. -/
theorem weightCompanion_torus_kernel_central
    (g : WeightCompanion P b O hclosed hmin R)
    (hg : g ∈ weightCompanionTorusSubgroup P b O hclosed hmin R)
    (hker : weightCompanionRho P b O hclosed hmin R g=1) :
    g ∈ Subgroup.center (WeightCompanion P b O hclosed hmin R) := by
  have hx (i : b.support) (t : R) : Commute g (weightCompanionX P b O hclosed hmin R i t) := by
    apply rootScaling_kernel_commute _ (weightCompanionRho P b O hclosed hmin R) ?_
      (weightCompanionTorusSubgroup_le_X_scaling P b O hclosed hmin R i hg) hker
    simpa only [weightCompanionRho_X] using adjointX_injective P b R i
  have hy (i : b.support) (t : R) : Commute g (weightCompanionY P b O hclosed hmin R i t) := by
    apply rootScaling_kernel_commute _ (weightCompanionRho P b O hclosed hmin R) ?_
      (weightCompanionTorusSubgroup_le_Y_scaling P b O hclosed hmin R i hg) hker
    simpa only [weightCompanionRho_Y] using adjointY_injective P b R i
  apply Subgroup.mem_center_iff.mpr
  intro h
  have hh : Commute g h := weightCompanion_induction P b O hclosed hmin R hx hy
    (Commute.one_right g) (fun _ _ h₁ h₂ => h₁.mul_right h₂)
    (fun _ h₁ => h₁.inv_right) h
  exact hh.eq.symm

/-- Equivalent subgroup formulation for later Bruhat reduction. -/
theorem weightCompanion_torus_inf_kernel_le_center :
    weightCompanionTorusSubgroup P b O hclosed hmin R ⊓
      (weightCompanionRho P b O hclosed hmin R).ker ≤
        Subgroup.center (WeightCompanion P b O hclosed hmin R) := by
  rintro g ⟨hg,hker⟩
  exact weightCompanion_torus_kernel_central P b O hclosed hmin R g hg hker
end Atlas.Chevalley
