import Atlas.LinearGroups.Chevalley.PositiveRootLocalConeDispatch
import Atlas.LinearGroups.Chevalley.PositiveRootPairReduction
import Atlas.LinearGroups.Chevalley.PositiveRootCollectionOfHeightCommutators

/-! Collection for the actual all-witness positive subgroup. Complete local
rank-two tables, positively oriented Levi reduction and normalizer transport
discharge the height-commutator premise. No whole-group order is asserted. -/
noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule RootData
open scoped commutatorElement

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hc : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hm : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R] [Nontrivial R]
  (hdiamond : SimpleDiamondProducts P b)

include hdiamond

/-- The commutator of any two distinct positive root subgroups lies in the
subgroup generated by roots in their strict positive integral cone. -/
theorem positiveRootSubgroup_commutator_cone
    (α β : {γ : ι // b.IsPos γ}) (hne : α ≠ β) :
    ⁅positiveWeightCompanionRootSubgroup P b O hc hm R α,
      positiveWeightCompanionRootSubgroup P b O hc hm R β⁆ ≤
      positiveWeightCompanionConeSubgroup P b O hc hm R α.val β.val :=
  positiveRootSubgroup_commutator_cone_of_rankTwo_tables P b O hc hm R hdiamond
    (positiveRootSubgroup_two_simple_support_cone P b O hc hm R hdiamond) α β hne

/-- These actual root-subgroup commutators strictly raise the original
positive-root height, in every coefficient-ring characteristic. -/
theorem positiveRootSubgroup_height_commutators
    (α β : {γ : ι // b.IsPos γ}) (hne : α ≠ β) :
    ⁅positiveWeightCompanionRootSubgroup P b O hc hm R α,
      positiveWeightCompanionRootSubgroup P b O hc hm R β⁆ ≤
      ⨆ γ : {γ : {γ : ι // b.IsPos γ} // b.height β.val < b.height γ.val},
        positiveWeightCompanionRootSubgroup P b O hc hm R γ.val :=
  (positiveRootSubgroup_commutator_cone P b O hc hm R hdiamond α β hne).trans
    (positiveWeightCompanionConeSubgroup_le_height_tail P b O hc hm R α β)

/-- The fixed ordered root product covers the existing all-witness U. -/
theorem positiveRootChosenProduct_surjective :
    Function.Surjective (positiveRootChosenProduct P b O hc hm R) :=
  positiveRootChosenProduct_surjective_of_height_commutators P b O hc hm R hdiamond
    (positiveRootSubgroup_height_commutators P b O hc hm R hdiamond)

/-- The same ordered product has unique parameters, using the independently
checked adjoint parameter recovery as well as actual collection. -/
theorem positiveRootChosenProduct_bijective :
    Function.Bijective (positiveRootChosenProduct P b O hc hm R) :=
  ⟨positiveRootChosenProduct_injective P b O hc hm R,
    positiveRootChosenProduct_surjective P b O hc hm R hdiamond⟩

/-- A set equivalence, not an additive-product group isomorphism. -/
def positiveRootChosenProductEquiv :
    ({β : ι // b.IsPos β} → R) ≃
      positiveWitnessedWeightCompanionSubgroup P b O hc hm R :=
  Equiv.ofBijective (positiveRootChosenProduct P b O hc hm R)
    (positiveRootChosenProduct_bijective P b O hc hm R hdiamond)

theorem positiveWitnessedWeightCompanionSubgroup_finite [Finite R] :
    Finite (positiveWitnessedWeightCompanionSubgroup P b O hc hm R) :=
  Finite.of_equiv ({β : ι // b.IsPos β} → R)
    (positiveRootChosenProductEquiv P b O hc hm R hdiamond)

/-- Exact order of the actual positive subgroup over a finite coefficient
ring. This is a subgroup-order theorem, not the full Chevalley order. -/
theorem positiveWitnessedWeightCompanionSubgroup_card [Finite R] :
    Nat.card (positiveWitnessedWeightCompanionSubgroup P b O hc hm R) =
      Nat.card R ^ Nat.card {β : ι // b.IsPos β} := by
  calc
    Nat.card (positiveWitnessedWeightCompanionSubgroup P b O hc hm R) =
        Nat.card ({β : ι // b.IsPos β} → R) :=
      (Nat.card_congr (positiveRootChosenProductEquiv P b O hc hm R hdiamond)).symm
    _ = _ := Nat.card_fun

end Atlas.Chevalley
