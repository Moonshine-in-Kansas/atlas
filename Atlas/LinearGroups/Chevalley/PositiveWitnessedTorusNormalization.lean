import Atlas.LinearGroups.Chevalley.PositiveWitnessedSubgroup
import Mathlib.Tactic.Group

/-! The actual torus normalizes the subgroup generated by all witnessed
positive-root families. Left multiplication of the lift changes the witness,
without identifying any previously different root-family choices. -/

noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hc : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hm : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R] [Nontrivial R]

/-- Left torus multiplication retains the actual simple origin and root label.
The new N element is recorded explicitly as part of the new witness. -/
def weightCompanionRootLift_torusMul {β : ι}
    (L : WeightCompanionRootLift P b O hc hm R β)
    (t : WeightCompanion P b O hc hm R)
    (ht : t ∈ weightCompanionTorusSubgroup P b O hc hm R) :
    WeightCompanionRootLift P b O hc hm R β := by
  let tn : weightCompanionExtendedWeylSubgroup P b O hc hm R :=
    ⟨t, weightCompanionTorusSubgroup_le_extendedWeyl P b O hc hm R ht⟩
  have hroot : weightCompanionNRootPermHom P b O hc hm R tn = 1 :=
    weightCompanionTorus_le_rootPermKer P b O hc hm R ht
  refine ⟨L.simple, tn * L.lift, ?_⟩
  rw [map_mul, hroot, one_mul]
  exact L.root_eq

/-- Conjugating a witnessed root element by the torus gives exactly the element
with the left-multiplied lift. No unit-reparametrization or coherence is needed. -/
theorem weightCompanionRootLiftHom_torusMul {β : ι}
    (L : WeightCompanionRootLift P b O hc hm R β)
    (t : WeightCompanion P b O hc hm R)
    (ht : t ∈ weightCompanionTorusSubgroup P b O hc hm R) (s : Multiplicative R) :
    weightCompanionRootLiftHom P b O hc hm R
        (weightCompanionRootLift_torusMul P b O hc hm R L t ht) s =
      t * weightCompanionRootLiftHom P b O hc hm R L s * t⁻¹ := by
  change (t * L.lift.val) * weightCompanionX P b O hc hm R L.simple s.toAdd *
      (t * L.lift.val)⁻¹ =
    t * (L.lift.val * weightCompanionX P b O hc hm R L.simple s.toAdd * L.lift.val⁻¹) * t⁻¹
  group

/-- Each actual torus element normalizes the full all-witness positive subgroup.
This depends only on T being contained in the root-action kernel, not on the
converse kernel equality, the simple-diamond hypothesis, or collection. -/
theorem weightCompanionTorus_le_positiveWitnessedNormalizer :
    weightCompanionTorusSubgroup P b O hc hm R ≤
      Subgroup.normalizer (↑(positiveWitnessedWeightCompanionSubgroup P b O hc hm R) : Set _) := by
  rw [positiveWitnessedWeightCompanionSubgroup, Subgroup.le_normalizer_closure_iff]
  rintro t ht g ⟨β, hβ, L, s, rfl⟩
  rw [← weightCompanionRootLiftHom_torusMul P b O hc hm R L t ht s]
  exact Subgroup.subset_closure
    ⟨β, hβ, weightCompanionRootLift_torusMul P b O hc hm R L t ht, s, rfl⟩

end Atlas.Chevalley
