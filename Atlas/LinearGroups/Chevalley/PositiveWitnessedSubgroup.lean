import Atlas.LinearGroups.Chevalley.PositiveRootCompanionHeight

/-! The subgroup generated by all retained positive-root witnesses is
unitriangular on the actual faithful companion representation. This does not
assert collection, unique coordinates or independence of root witnesses. -/

noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hc : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hm : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R] [Nontrivial R]

/-- Literal subgroup generated by every positive-root conjugate with its
specified witness. No canonical choice of a root subgroup is built in. -/
def positiveWitnessedWeightCompanionSubgroup :
    Subgroup (WeightCompanion P b O hc hm R) :=
  Subgroup.closure {g | ∃ β, b.IsPos β ∧
    ∃ (L : WeightCompanionRootLift P b O hc hm R β) (t : Multiplicative R),
      g = weightCompanionRootLiftHom P b O hc hm R L t}

theorem rootLiftHom_mem_positiveWitnessedWeightCompanionSubgroup {β : ι}
    (hβ : b.IsPos β) (L : WeightCompanionRootLift P b O hc hm R β)
    (t : Multiplicative R) :
    weightCompanionRootLiftHom P b O hc hm R L t ∈
      positiveWitnessedWeightCompanionSubgroup P b O hc hm R :=
  Subgroup.subset_closure ⟨β, hβ, L, t, rfl⟩

variable [Fintype κ]

/-- Every finite product of witnessed positive-root elements and their inverses
belongs to the same height-unitriangular matrix subgroup. -/
theorem positiveWitnessedWeightCompanion_le_heightUnitriangular
    (hdiamond : SimpleDiamondProducts P b) :
    positiveWitnessedWeightCompanionSubgroup P b O hc hm R ≤
      (Atlas.Matrix.heightUnitriangularSubgroup (weightCompanionHeight P b O)).comap
        (weightCompanionMatrixRepresentation P b O hc hm R) := by
  rw [positiveWitnessedWeightCompanionSubgroup, Subgroup.closure_le]
  rintro g ⟨β, hβ, L, t, rfl⟩
  exact weightCompanion_rootLiftHom_mem_heightUnitriangular P b O hc hm R hdiamond hβ L t

theorem positiveWitnessedWeightCompanion_heightUnitriangular
    (hdiamond : SimpleDiamondProducts P b) (g : WeightCompanion P b O hc hm R)
    (hg : g ∈ positiveWitnessedWeightCompanionSubgroup P b O hc hm R) :
    Atlas.Matrix.HeightUnitriangular (weightCompanionHeight P b O)
      (weightCompanionMatrixRepresentation P b O hc hm R g).val :=
  (positiveWitnessedWeightCompanion_le_heightUnitriangular P b O hc hm R hdiamond hg).1

/-- No nonidentity element of this subgroup has a diagonal matrix in the
actual faithful companion representation. No global adjoint kernel is used. -/
theorem positiveWitnessedWeightCompanion_eq_one_of_diagonal
    (hdiamond : SimpleDiamondProducts P b) (g : WeightCompanion P b O hc hm R)
    (hg : g ∈ positiveWitnessedWeightCompanionSubgroup P b O hc hm R)
    (hdiag : ∀ row col, row ≠ col →
      (weightCompanionMatrixRepresentation P b O hc hm R g).val row col = 0) :
    g = 1 := by
  apply weightCompanionMatrixRepresentation_injective P b O hc hm R
  apply Units.ext
  simpa only [map_one, Units.val_one] using
    Atlas.Matrix.HeightUnitriangular.eq_one_of_offDiagonal_zero
      (positiveWitnessedWeightCompanion_heightUnitriangular P b O hc hm R hdiamond g hg)
      hdiag

end Atlas.Chevalley
