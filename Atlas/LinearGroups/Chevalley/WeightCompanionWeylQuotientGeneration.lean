import Atlas.LinearGroups.Chevalley.WeightCompanionWeylQuotientInvolutions
import Atlas.LinearGroups.Chevalley.WeightCompanionWeylQuotientAction
import Mathlib.Algebra.Group.Subgroup.Ker

/-! Generation of the literal quotient N/T by its actual simple Weyl cosets,
and their images under the existing root-permutation action. No assertion of
faithfulness, a Coxeter presentation or equality of the action kernel with T. -/

noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule
variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hclosed : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hmin : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R]

local instance quotientGenerationTorusNormal :
    ((weightCompanionTorusSubgroup P b O hclosed hmin R).subgroupOf
      (weightCompanionExtendedWeylSubgroup P b O hclosed hmin R)).Normal :=
  weightCompanionTorusSubgroup_normal_extendedWeyl P b O hclosed hmin R

/-- The literal torus quotient is generated by the literal simple Weyl cosets.
This statement remains valid for a trivial coefficient ring. -/
theorem weightCompanionSimpleWeylCoset_closure :
    Subgroup.closure (Set.range (weightCompanionSimpleWeylCoset P b O hclosed hmin R)) =
      ⊤ := by
  let T := weightCompanionTorusSubgroup P b O hclosed hmin R
  let W := weightCompanionWeylSubgroup P b O hclosed hmin R
  let N₀ := weightCompanionExtendedWeylSubgroup P b O hclosed hmin R
  let T₀ := T.subgroupOf N₀
  let S : b.support → N₀ := weightCompanionSimpleWeylInN P b O hclosed hmin R
  let H : Subgroup N₀ := Subgroup.closure (Set.range S)
  let q : N₀ →* N₀ ⧸ T₀ := QuotientGroup.mk' T₀
  have hW : W.subgroupOf N₀ = H := by
    apply Subgroup.map_injective N₀.subtype_injective
    rw [Subgroup.map_subgroupOf_eq_of_le (show W ≤ N₀ from le_sup_right)]
    change Subgroup.closure {g | ∃ i, g = weightCompanionWeyl P b O hclosed hmin R i 1} =
      (Subgroup.closure (Set.range S)).map N₀.subtype
    rw [MonoidHom.map_closure]
    congr 1
    ext g
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨S i, ⟨i, rfl⟩, rfl⟩
    · rintro ⟨n, ⟨i, rfl⟩, h⟩
      exact ⟨i, h.symm⟩
  have hjoin : T₀ ⊔ H = ⊤ := by
    rw [← hW]
    change T.subgroupOf N₀ ⊔ W.subgroupOf N₀ = ⊤
    rw [← Subgroup.subgroupOf_sup (show T ≤ N₀ from le_sup_left)
      (show W ≤ N₀ from le_sup_right)]
    exact Subgroup.subgroupOf_self N₀
  have hT : T₀.map q = ⊥ := by
    apply bot_unique
    rintro x ⟨n, hn, rfl⟩
    change q n = 1
    exact (QuotientGroup.eq_one_iff n).mpr hn
  have hH : H.map q =
      Subgroup.closure (Set.range (weightCompanionSimpleWeylCoset P b O hclosed hmin R)) := by
    change (Subgroup.closure (Set.range S)).map q = _
    rw [MonoidHom.map_closure]
    congr 1
    ext x
    constructor
    · rintro ⟨n, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨S i, ⟨i, rfl⟩, rfl⟩
  have h := congrArg (fun K : Subgroup N₀ => K.map q) hjoin
  rw [Subgroup.map_sup, hT, hH, bot_sup_eq,
    Subgroup.map_top_of_surjective q (QuotientGroup.mk'_surjective T₀)] at h
  exact h

variable [Nontrivial R]

/-- The existing quotient action sends each named generator to its actual
simple-root reflection. Surjectivity was proved earlier; injectivity is not
assumed or concluded here. -/
theorem weightCompanionWeylQuotientAction_simple (i : b.support) :
    weightCompanionWeylQuotientAction P b O hclosed hmin R
      (weightCompanionSimpleWeylCoset P b O hclosed hmin R i) =
        ⟨P.reflectionPerm i.val, Subgroup.subset_closure ⟨i, rfl⟩⟩ := by
  apply Subtype.ext
  change weightCompanionNRootPermHom P b O hclosed hmin R
    (weightCompanionSimpleWeylInN P b O hclosed hmin R i) = P.reflectionPerm i.val
  exact weightCompanionNRootPermHom_simple P b O hclosed hmin R i

end Atlas.Chevalley
