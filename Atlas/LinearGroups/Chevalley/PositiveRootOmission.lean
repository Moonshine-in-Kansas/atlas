import Atlas.LinearGroups.Chevalley.PositiveRootNormalizerTransport

/-! The subgroup generated by all positive roots except one actual simple
root. Its definition and simple-reflection transport do not use collection. -/
noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule Atlas.GroupTheory

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hc : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hm : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R] [Nontrivial R]

def positiveRootOmissionSubgroup (i : b.support) :
    Subgroup (WeightCompanion P b O hc hm R) :=
  ⨆ β : {β : {β : ι // b.IsPos β} // β.val ≠ i.val},
    positiveWeightCompanionRootSubgroup P b O hc hm R β.val

theorem positiveRootSubgroup_le_omission (i : b.support)
    (β : {β : ι // b.IsPos β}) (hne : β.val ≠ i.val) :
    positiveWeightCompanionRootSubgroup P b O hc hm R β ≤
      positiveRootOmissionSubgroup P b O hc hm R i :=
  le_iSup (fun γ : {γ : {β : ι // b.IsPos β} // γ.val ≠ i.val} =>
    positiveWeightCompanionRootSubgroup P b O hc hm R γ.val) ⟨β,hne⟩

theorem positiveRootOmissionSubgroup_le_witnessed (i : b.support) :
    positiveRootOmissionSubgroup P b O hc hm R i ≤
      positiveWitnessedWeightCompanionSubgroup P b O hc hm R := by
  apply iSup_le
  intro β
  exact positiveWeightCompanionRootSubgroup_le_witnessed P b O hc hm R β.val

variable (hdiamond : SimpleDiamondProducts P b)
include hdiamond

/-- Reintroducing the omitted simple-root subgroup recovers the same actual U. -/
theorem positiveWitnessedWeightCompanion_eq_omission_sup_simple (i : b.support) :
    positiveWitnessedWeightCompanionSubgroup P b O hc hm R =
      positiveRootOmissionSubgroup P b O hc hm R i ⊔
        positiveWeightCompanionRootSubgroup P b O hc hm R
          ⟨i.val,b.isPos_of_mem_support i.property⟩ := by
  apply le_antisymm
  · rw [positiveWitnessedWeightCompanion_eq_iSup_positiveRoots P b O hc hm R hdiamond]
    apply iSup_le
    intro β
    by_cases he : β.val = i.val
    · have hβ : β = ⟨i.val,b.isPos_of_mem_support i.property⟩ := Subtype.ext he
      rw [hβ]
      exact le_sup_right
    · exact (positiveRootSubgroup_le_omission P b O hc hm R i β he).trans le_sup_left
  · exact sup_le (positiveRootOmissionSubgroup_le_witnessed P b O hc hm R i)
      (positiveWeightCompanionRootSubgroup_le_witnessed P b O hc hm R
        ⟨i.val,b.isPos_of_mem_support i.property⟩)

/-- The literal n_i sends every positive root other than i to a positive root,
so its conjugation sends the whole omitted subgroup into the actual U. -/
theorem weightCompanionWeyl_conjugate_omission_le_witnessed (i : b.support) :
    conjugateSubgroup (weightCompanionWeyl P b O hc hm R i 1)
      (positiveRootOmissionSubgroup P b O hc hm R i) ≤
        positiveWitnessedWeightCompanionSubgroup P b O hc hm R := by
  let n := weightCompanionSimpleWeylInN P b O hc hm R i
  change (positiveRootOmissionSubgroup P b O hc hm R i).map
    (MulAut.conj n.val).toMonoidHom ≤ _
  rw [positiveRootOmissionSubgroup,Subgroup.map_iSup]
  apply iSup_le
  intro β
  have hpos : b.IsPos (weightCompanionNRootPermHom P b O hc hm R n β.val.val) := by
    rw [weightCompanionNRootPermHom_simple]
    exact β.val.property.reflectionPerm i.property β.property
  change conjugateSubgroup n.val (positiveWeightCompanionRootSubgroup P b O hc hm R β.val) ≤ _
  rw [positiveWeightCompanionRootSubgroup_conjugate P b O hc hm R hdiamond n β.val hpos]
  exact positiveWeightCompanionRootSubgroup_le_witnessed P b O hc hm R
    ⟨weightCompanionNRootPermHom P b O hc hm R n β.val.val,hpos⟩

end Atlas.Chevalley
