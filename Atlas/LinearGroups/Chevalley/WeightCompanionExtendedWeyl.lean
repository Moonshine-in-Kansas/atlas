import Atlas.LinearGroups.Chevalley.WeightCompanionTorusNormalizer
import Mathlib.GroupTheory.QuotientGroup.Basic

/-! The literal subgroup N generated by T and the simple pinned
Weyl representatives. The theorem below only gives T normal in N; identifying
N/T with the reflection group, and Bruhat decomposition, remain separate. -/
noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule
variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hclosed : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hmin : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨ μ (corootElement P i) = 1)
  (R : Type*) [CommRing R]

/-- The subgroup generated by the literal simple Weyl representatives. -/
def weightCompanionWeylSubgroup : Subgroup (WeightCompanion P b O hclosed hmin R) :=
  Subgroup.closure {g | ∃ i, g = weightCompanionWeyl P b O hclosed hmin R i 1}

/-- The actual subgroup conventionally denoted N, before a BN-pair is proved. -/
def weightCompanionExtendedWeylSubgroup :
    Subgroup (WeightCompanion P b O hclosed hmin R) :=
  weightCompanionTorusSubgroup P b O hclosed hmin R ⊔
    weightCompanionWeylSubgroup P b O hclosed hmin R

theorem weightCompanionWeylSubgroup_le_torusNormalizer :
    weightCompanionWeylSubgroup P b O hclosed hmin R ≤
      Subgroup.normalizer (↑(weightCompanionTorusSubgroup P b O hclosed hmin R) : Set _) := by
  rw [weightCompanionWeylSubgroup, Subgroup.closure_le]
  rintro g ⟨i,rfl⟩
  exact weightCompanionWeyl_mem_torusNormalizer P b O hclosed hmin R i

theorem weightCompanionTorusSubgroup_le_extendedWeyl :
    weightCompanionTorusSubgroup P b O hclosed hmin R ≤
      weightCompanionExtendedWeylSubgroup P b O hclosed hmin R := le_sup_left

theorem weightCompanionExtendedWeylSubgroup_le_torusNormalizer :
    weightCompanionExtendedWeylSubgroup P b O hclosed hmin R ≤
      Subgroup.normalizer (↑(weightCompanionTorusSubgroup P b O hclosed hmin R) : Set _) :=
  sup_le Subgroup.le_normalizer
    (weightCompanionWeylSubgroup_le_torusNormalizer P b O hclosed hmin R)

theorem weightCompanionTorusSubgroup_normal_extendedWeyl :
    ((weightCompanionTorusSubgroup P b O hclosed hmin R).subgroupOf
      (weightCompanionExtendedWeylSubgroup P b O hclosed hmin R)).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer
    (weightCompanionTorusSubgroup_le_extendedWeyl P b O hclosed hmin R)).mpr
      (weightCompanionExtendedWeylSubgroup_le_torusNormalizer P b O hclosed hmin R)

end Atlas.Chevalley
