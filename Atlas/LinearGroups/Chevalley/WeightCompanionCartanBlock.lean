import Atlas.LinearGroups.Chevalley.WeightCompanionRootPermutation

/-! Preservation of the entire actual adjoint Cartan block by N and its inverse.
This supplies the non-root-column information needed for filtration transport. -/

noncomputable section
open scoped Matrix
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (R : Type*) [CommRing R]

/-- Literal Cartan vectors are the corresponding coordinate basis vectors. -/
theorem cartanVector_eq_single (j : b.support) :
    cartanVector P b R j = (Pi.single (Sum.inl j) 1 : b.support ⊕ ι → R) := by
  ext row
  by_cases h : row = Sum.inl j <;>
    simp [cartanVector, RootPairing.GeckConstruction.u, Function.comp_def, Pi.single_apply, h]

/-- A complete adjoint matrix preserves the span of the literal Cartan columns. -/
def AdjointCartanBlockZero (g : Adjoint P b R) : Prop :=
  ∀ (r : ι) (c : b.support), g.val.val (Sum.inr r) (Sum.inl c) = 0

theorem adjointCartanBlockZero_one : AdjointCartanBlockZero P b R 1 := by
  intro r c
  change (1 : Matrix (b.support ⊕ ι) _ R) (Sum.inr r) (Sum.inl c) = 0
  simp

theorem adjointCartanBlockZero_mul {g h : Adjoint P b R}
    (hg : AdjointCartanBlockZero P b R g)
    (hh : AdjointCartanBlockZero P b R h) :
    AdjointCartanBlockZero P b R (g * h) := by
  intro r c
  change (g.val.val * h.val.val) (Sum.inr r) (Sum.inl c) = 0
  rw [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro k hk
  cases k with
  | inl a => simp only [hg r a, zero_mul]
  | inr a => simp only [hh a c, mul_zero]

/-- The actual Cartan-block stabilizer, retaining the inverse condition explicitly. -/
def adjointCartanBlockSubgroup : Subgroup (Adjoint P b R) where
  carrier := {g | AdjointCartanBlockZero P b R g ∧ AdjointCartanBlockZero P b R g⁻¹}
  one_mem' := ⟨adjointCartanBlockZero_one P b R, by
    simpa only [inv_one] using adjointCartanBlockZero_one P b R⟩
  mul_mem' {g h} hg hh := ⟨adjointCartanBlockZero_mul P b R hg.1 hh.1, by
    simpa only [mul_inv_rev] using adjointCartanBlockZero_mul P b R hh.2 hg.2⟩
  inv_mem' {g} hg := ⟨hg.2, by simpa only [inv_inv] using hg.1⟩

/-- Both the Weyl matrix and its inverse preserve the whole Cartan block. -/
theorem adjointWeyl_mem_cartanBlockSubgroup (i : b.support) :
    adjointWeyl P b R i 1 ∈ adjointCartanBlockSubgroup P b R := by
  constructor
  · intro r c
    have he := congrFun (adjointWeyl_cartan P b R i c 1) (Sum.inr r)
    simpa [cartanVector_eq_single, Matrix.mulVec_single_one, Matrix.col,
      Pi.single_apply] using he
  · intro r c
    have he := congrFun (adjointWeyl_one_inv_cartan P b R i c) (Sum.inr r)
    simpa [cartanVector_eq_single, Matrix.mulVec_single_one, Matrix.col,
      Pi.single_apply] using he

/-- The literal torus word and its inverse fix all Cartan columns. -/
theorem adjointTorus_mem_cartanBlockSubgroup (i : b.support) (a : Rˣ) :
    adjointTorus P b R i a ∈ adjointCartanBlockSubgroup P b R := by
  constructor
  · intro r c
    have he := congrFun (adjointTorus_cartan P b R i c a) (Sum.inr r)
    simpa [cartanVector_eq_single, Matrix.mulVec_single_one, Matrix.col,
      Pi.single_apply] using he
  · intro r c
    have hi := adjoint_inv_mulVec_eq_of_mulVec_eq P b R
      (adjointTorus P b R i a) (cartanVector P b R c) (cartanVector P b R c)
      (adjointTorus_cartan P b R i c a)
    have he := congrFun hi (Sum.inr r)
    simpa [cartanVector_eq_single, Matrix.mulVec_single_one, Matrix.col,
      Pi.single_apply] using he

variable (O : κ → Finset (WeightLattice P))
  (hclosed : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hmin : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)

/-- The full actual N, generated by T and the pinned simple Weyl words, preserves
the literal Cartan block on the adjoint summand. No kernel statement is used. -/
theorem weightCompanionExtendedWeyl_le_cartanBlock :
    weightCompanionExtendedWeylSubgroup P b O hclosed hmin R ≤
      (adjointCartanBlockSubgroup P b R).comap
        (weightCompanionRho P b O hclosed hmin R) := by
  change weightCompanionTorusSubgroup P b O hclosed hmin R ⊔
    weightCompanionWeylSubgroup P b O hclosed hmin R ≤ _
  apply sup_le
  · rw [weightCompanionTorusSubgroup, Subgroup.closure_le]
    rintro g ⟨i, a, rfl⟩
    change weightCompanionRho P b O hclosed hmin R
      (weightCompanionTorus P b O hclosed hmin R i a) ∈ adjointCartanBlockSubgroup P b R
    rw [weightCompanionRho_torus]
    exact adjointTorus_mem_cartanBlockSubgroup P b R i a
  · rw [weightCompanionWeylSubgroup, Subgroup.closure_le]
    rintro g ⟨i, rfl⟩
    change weightCompanionRho P b O hclosed hmin R
      (weightCompanionWeyl P b O hclosed hmin R i 1) ∈ adjointCartanBlockSubgroup P b R
    rw [weightCompanionRho_weyl]
    exact adjointWeyl_mem_cartanBlockSubgroup P b R i

end Atlas.Chevalley
