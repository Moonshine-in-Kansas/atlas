def readCoordinates {R : Type*} [CommRing R]
    (M : Matrix (Fin 27) (Fin 27) R) (i : Fin 52) : R :=
  if h : i.val < 4 then
    (![M 3 3 + M 4 4,
       -2 * M 3 3 - M 4 4 - M 5 5,
       M 3 3 + M 4 4 + M 5 5,
       -M 3 3 - M 4 4 - M 5 5 + M 11 11] : Fin 4 → R) ⟨i.val,h⟩
  else
    let p := rootPivot ⟨i.val-4,by omega⟩
    (p.2.2 : R) * M p.1 p.2.1

