import Atlas.LinearGroups.Chevalley.PositiveWitnessedWeylCellDecomposition
import Atlas.LinearGroups.Chevalley.RootData.ParabolicWordReduction
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-! Standard parabolics in the actual full companion. Generation by B and
selected literal simple Tits representatives agrees with the union of the
existing double cells whose actual Weyl label lies in the root parabolic.
No BN-pair, parabolic order or simplicity assertion is assumed. -/
noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule RootData
open Atlas.GroupTheory.ReducedWords
open scoped Pointwise

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hc : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hm : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (K : Type*) [Field K]

/-- The subgroup generated by the established B and the chosen simple Tits
representatives. The original full companion remains the ambient group. -/
def positiveWitnessedStandardParabolic (J : Finset b.support) :
    Subgroup (WeightCompanion P b O hc hm K) :=
  Subgroup.closure ((positiveWitnessedTorusJoin P b O hc hm K : Set _) ∪
    ((fun i => weightCompanionWeyl P b O hc hm K i 1) '' (J : Set b.support)))

/-- The existing canonical double cells restricted to the actual root parabolic. -/
def positiveWitnessedParabolicCells (J : Finset b.support) :
    Set (WeightCompanion P b O hc hm K) :=
  {g | ∃ w : P.weylGroupToPerm.range, w ∈ rootParabolicSubgroup P b J ∧
    g ∈ positiveWitnessedWeylCell P b O hc hm K w}

theorem positiveWitnessedTorusJoin_le_standardParabolic (J : Finset b.support) :
    positiveWitnessedTorusJoin P b O hc hm K ≤
      positiveWitnessedStandardParabolic P b O hc hm K J := by
  intro g hg
  exact Subgroup.subset_closure (Or.inl hg)

theorem weightCompanionWeyl_mem_standardParabolic
    (J : Finset b.support) (i : b.support) (hi : i ∈ J) :
    weightCompanionWeyl P b O hc hm K i 1 ∈
      positiveWitnessedStandardParabolic P b O hc hm K J :=
  Subgroup.subset_closure (Or.inr ⟨i, hi, rfl⟩)

private theorem simple_mem_rootParabolic
    (J : Finset b.support) (i : b.support) (hi : i ∈ J) :
    simpleWeylReflection P b i ∈ rootParabolicSubgroup P b J :=
  Subgroup.subset_closure ⟨i, hi, rfl⟩

theorem weightCompanionTitsLift_mem_standardParabolic
    (hdiamond : SimpleDiamondProducts P b) (J : Finset b.support)
    (w : P.weylGroupToPerm.range) (hw : w ∈ rootParabolicSubgroup P b J) :
    (weightCompanionTitsLift P b O hc hm K w).val ∈
      positiveWitnessedStandardParabolic P b O hc hm K J := by
  obtain ⟨l, hl, heq, hred⟩ := rootParabolic_exists_reduced_word P b J w hw
  rw [weightCompanionTitsLift_eq_wordEval P b O hc hm K hdiamond w l heq hred,
    weightCompanionSimpleWeylInN_wordEval_val]
  clear heq hred
  induction l with
  | nil => exact (positiveWitnessedStandardParabolic P b O hc hm K J).one_mem
  | cons i l ih =>
    change weightCompanionWeyl P b O hc hm K i 1 *
      wordEval (fun j => weightCompanionWeyl P b O hc hm K j 1) l ∈ _
    exact (positiveWitnessedStandardParabolic P b O hc hm K J).mul_mem
      (weightCompanionWeyl_mem_standardParabolic P b O hc hm K J i
        (hl i List.mem_cons_self))
      (ih (fun j hj => hl j (List.mem_cons_of_mem i hj)))

private theorem parabolicCells_one (J : Finset b.support) :
    (1 : WeightCompanion P b O hc hm K) ∈
      positiveWitnessedParabolicCells P b O hc hm K J := by
  refine ⟨1, (rootParabolicSubgroup P b J).one_mem, ?_⟩
  change 1 ∈ DoubleCoset.doubleCoset
    (weightCompanionTitsLift P b O hc hm K 1).val _ _
  rw [weightCompanionTitsLift_one]
  exact DoubleCoset.mem_doubleCoset_self _ _ _

private theorem parabolicCells_mul_left_B
    (J : Finset b.support) (a g : WeightCompanion P b O hc hm K)
    (ha : a ∈ positiveWitnessedTorusJoin P b O hc hm K)
    (hg : g ∈ positiveWitnessedParabolicCells P b O hc hm K J) :
    a * g ∈ positiveWitnessedParabolicCells P b O hc hm K J := by
  obtain ⟨w, hw, hg⟩ := hg
  refine ⟨w, hw, ?_⟩
  simpa only [mul_one, positiveWitnessedWeylCell] using Atlas.GroupTheory.doubleCoset_mul_left_right
    (positiveWitnessedTorusJoin P b O hc hm K)
    (weightCompanionTitsLift P b O hc hm K w).val hg a 1 ha
    (positiveWitnessedTorusJoin P b O hc hm K).one_mem

variable [Fintype κ]

private theorem parabolicCells_mul_left_simple_cell
    (hdiamond : SimpleDiamondProducts P b) (J : Finset b.support)
    (i : b.support) (hi : i ∈ J) (a g : WeightCompanion P b O hc hm K)
    (ha : a ∈ DoubleCoset.doubleCoset (weightCompanionWeyl P b O hc hm K i 1)
      (positiveWitnessedTorusJoin P b O hc hm K)
      (positiveWitnessedTorusJoin P b O hc hm K))
    (hg : g ∈ positiveWitnessedParabolicCells P b O hc hm K J) :
    a * g ∈ positiveWitnessedParabolicCells P b O hc hm K J := by
  obtain ⟨w, hw, hg⟩ := hg
  have hprod := positiveWitnessed_simple_doubleCoset_mul_weyl_subset
    P b O hc hm K hdiamond i (weightCompanionTitsLift P b O hc hm K w)
    (show a * g ∈ _ from ⟨a, ha, g, hg, rfl⟩)
  rcases hprod with hnew | hold
  · refine ⟨simpleWeylReflection P b i * w,
      (rootParabolicSubgroup P b J).mul_mem
        (simple_mem_rootParabolic P b J i hi) hw, ?_⟩
    have he := positiveWitnessedWeylCell_eq_of_lift P b O hc hm K hdiamond
      (simpleWeylReflection P b i * w)
      (weightCompanionSimpleWeylInN P b O hc hm K i *
        weightCompanionTitsLift P b O hc hm K w) (by
        change weightCompanionNRootPermHom P b O hc hm K
          (weightCompanionSimpleWeylInN P b O hc hm K i *
            weightCompanionTitsLift P b O hc hm K w) =
          P.reflectionPerm i.val * w.val
        rw [map_mul, weightCompanionNRootPermHom_simple,
          weightCompanionNRootPermHom_titsLift])
    rw [← he]
    exact hnew
  · exact ⟨w, hw, hold⟩

private theorem simple_inv_mem_simple_cell
    (hdiamond : SimpleDiamondProducts P b) (i : b.support) :
    (weightCompanionWeyl P b O hc hm K i 1)⁻¹ ∈
      DoubleCoset.doubleCoset (weightCompanionWeyl P b O hc hm K i 1)
        (positiveWitnessedTorusJoin P b O hc hm K)
        (positiveWitnessedTorusJoin P b O hc hm K) := by
  apply (weightCompanionN_mem_doubleCoset_iff_rootPerm_eq P b O hc hm K hdiamond
    (weightCompanionSimpleWeylInN P b O hc hm K i)⁻¹
    (weightCompanionSimpleWeylInN P b O hc hm K i)).mpr
  simp only [map_inv, weightCompanionNRootPermHom_simple, P.reflectionPerm_inv]

/-- Every element of the literally generated standard parabolic remains in a
double cell with a root-parabolic Weyl label. This uses left-generator induction,
not an assumed multiplicative closure of the cell union. -/
theorem standardParabolic_subset_parabolicCells
    (hdiamond : SimpleDiamondProducts P b) (J : Finset b.support) :
    (positiveWitnessedStandardParabolic P b O hc hm K J : Set _) ⊆
      positiveWitnessedParabolicCells P b O hc hm K J := by
  intro g hg
  change g ∈ Subgroup.closure _ at hg
  induction hg using Subgroup.closure_induction_left with
  | one => exact parabolicCells_one P b O hc hm K J
  | mul_left a ha g hg ih =>
    rcases ha with ha | ⟨i, hi, rfl⟩
    · exact parabolicCells_mul_left_B P b O hc hm K J a g ha ih
    · exact parabolicCells_mul_left_simple_cell P b O hc hm K hdiamond J i hi
        _ g (DoubleCoset.mem_doubleCoset_self _ _ _) ih
  | inv_mul_cancel a ha g hg ih =>
    rcases ha with ha | ⟨i, hi, rfl⟩
    · exact parabolicCells_mul_left_B P b O hc hm K J a⁻¹ g
        ((positiveWitnessedTorusJoin P b O hc hm K).inv_mem ha) ih
    · exact parabolicCells_mul_left_simple_cell P b O hc hm K hdiamond J i hi
        _ g (simple_inv_mem_simple_cell P b O hc hm K hdiamond i) ih

/-- A root-parabolic label has a reduced word using only the selected letters.
Its actual Tits representative, and hence its whole B double cell, lies in the
literally generated standard parabolic. -/
theorem parabolicCells_subset_standardParabolic
    (hdiamond : SimpleDiamondProducts P b) (J : Finset b.support) :
    positiveWitnessedParabolicCells P b O hc hm K J ⊆
      (positiveWitnessedStandardParabolic P b O hc hm K J : Set _) := by
  rintro g ⟨w, hw, hg⟩
  obtain ⟨a, ha, c, hc', rfl⟩ := DoubleCoset.mem_doubleCoset.mp hg
  exact (positiveWitnessedStandardParabolic P b O hc hm K J).mul_mem
    ((positiveWitnessedStandardParabolic P b O hc hm K J).mul_mem
      (positiveWitnessedTorusJoin_le_standardParabolic P b O hc hm K J ha)
      (weightCompanionTitsLift_mem_standardParabolic P b O hc hm K hdiamond J w hw))
    (positiveWitnessedTorusJoin_le_standardParabolic P b O hc hm K J hc')

theorem positiveWitnessedStandardParabolic_eq_cells
    (hdiamond : SimpleDiamondProducts P b) (J : Finset b.support) :
    (positiveWitnessedStandardParabolic P b O hc hm K J : Set _) =
      positiveWitnessedParabolicCells P b O hc hm K J :=
  Set.Subset.antisymm
    (standardParabolic_subset_parabolicCells P b O hc hm K hdiamond J)
    (parabolicCells_subset_standardParabolic P b O hc hm K hdiamond J)

/-- The Weyl label of any existing double cell is in W_J exactly when one
(equivalently every) element of that cell belongs to the standard parabolic. -/
theorem mem_standardParabolic_iff_of_mem_weylCell
    (hdiamond : SimpleDiamondProducts P b) (J : Finset b.support)
    (w : P.weylGroupToPerm.range) (g : WeightCompanion P b O hc hm K)
    (hg : g ∈ positiveWitnessedWeylCell P b O hc hm K w) :
    g ∈ positiveWitnessedStandardParabolic P b O hc hm K J ↔
      w ∈ rootParabolicSubgroup P b J := by
  constructor
  · intro hp
    obtain ⟨v, hv, hgv⟩ :=
      standardParabolic_subset_parabolicCells P b O hc hm K hdiamond J hp
    have he : v = w := by
      by_contra hne
      exact Set.disjoint_left.mp
        (positiveWitnessedWeylCell_disjoint P b O hc hm K hdiamond v w hne) hgv hg
    exact he ▸ hv
  · intro hw
    exact parabolicCells_subset_standardParabolic P b O hc hm K hdiamond J ⟨w, hw, hg⟩

end Atlas.Chevalley
