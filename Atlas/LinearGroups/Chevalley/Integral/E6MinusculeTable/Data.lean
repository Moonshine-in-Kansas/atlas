def coordinates (a : Weight) (i : Fin 6) : ℤ := (coordinateTable[a.val]!)[i.val]!
def decode (x : Vector) : Weight := if x 0 = (-1 : ℤ) then if x 1 = (-1 : ℤ) then 21 else if x 1 = (0 : ℤ) then if x 2 = (0 : ℤ) then if x 3 = (0 : ℤ) then if x 4 = (0 : ℤ) then 12 else 15 else 17 else 1 else 19 else if x 0 = (0 : ℤ) then if x 1 = (-1 : ℤ) then if x 2 = (-1 : ℤ) then 23 else if x 3 = (0 : ℤ) then 4 else if x 4 = (-1 : ℤ) then 6 else 9 else if x 1 = (0 : ℤ) then if x 2 = (-1 : ℤ) then 2 else if x 2 = (0 : ℤ) then if x 3 = (-1 : ℤ) then 24 else if x 4 = (-1 : ℤ) then 25 else 26 else if x 3 = (-1 : ℤ) then if x 4 = (0 : ℤ) then 8 else 11 else 14 else if x 2 = (-1 : ℤ) then 22 else if x 3 = (-1 : ℤ) then 3 else if x 4 = (-1 : ℤ) then 5 else 7 else if x 1 = (-1 : ℤ) then 20 else if x 1 = (0 : ℤ) then if x 2 = (-1 : ℤ) then if x 3 = (0 : ℤ) then if x 4 = (0 : ℤ) then 10 else 13 else 16 else 0 else 18
def rootCoefficients (a : CorootIndex) (i : Fin 6) : ℤ := Atlas.Comparisons.E6Lattice.rootRepresentative a (E6Data.nodeEquiv.symm i)
def grade (a : Weight) (r : CorootIndex) : ℤ := ∑ i, coordinates a i * rootCoefficients r i
def reflectSimple (i : Fin 6) (x : Vector) : Vector := fun k => x k - x i * CartanMatrix.E 6 i k
def reflectRoot (r : CorootIndex) (x : Vector) : Vector := fun k => x k - (∑ i, x i * rootCoefficients r i) * (∑ i, rootCoefficients r i * CartanMatrix.E 6 i k)
