def xa (t : ℤ) : Matrix (Fin 10) (Fin 10) ℤ :=
  1 + t • ea + t^2 • ea2

def xb (t : ℤ) : Matrix (Fin 10) (Fin 10) ℤ :=
  1 + t • eb + t^2 • eb2

def z (t : ℤ) : Matrix (Fin 10) (Fin 10) ℤ :=
  1 + t • za + t^2 • za2

def w (t : ℤ) : Matrix (Fin 10) (Fin 10) ℤ :=
  1 + t • wb + t^2 • wb2

def ya (t : ℤ) := (omega : Matrix (Fin 10) (Fin 10) ℤ) * xa t * omega
def yb (t : ℤ) := (omega : Matrix (Fin 10) (Fin 10) ℤ) * xb t * omega


