import Atlas.LinearGroups.Chevalley.PositiveRootCanonicalFamily
import Atlas.LinearGroups.Chevalley.RootData.PositiveIntegralRootCone

/-! The subgroup generated by the positive roots in the strict integral cone
on two specified original root labels. No collection assertion is included. -/
noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule RootData

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (O : κ → Finset (WeightLattice P))
  (hc : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hm : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R] [Nontrivial R]

def positiveWeightCompanionConeSubgroup (α β : ι) :
    Subgroup (WeightCompanion P b O hc hm R) :=
  ⨆ γ : {γ : {γ : ι // b.IsPos γ} // PositiveIntegralRootCone P b α β γ.val},
    positiveWeightCompanionRootSubgroup P b O hc hm R γ.val

theorem positiveWeightCompanionRootSubgroup_le_cone
    (α β : ι) (γ : {γ : ι // b.IsPos γ})
    (hγ : PositiveIntegralRootCone P b α β γ.val) :
    positiveWeightCompanionRootSubgroup P b O hc hm R γ ≤
      positiveWeightCompanionConeSubgroup P b O hc hm R α β :=
  le_iSup (fun δ : {δ : {γ : ι // b.IsPos γ} // PositiveIntegralRootCone P b α β δ.val} =>
    positiveWeightCompanionRootSubgroup P b O hc hm R δ.val) ⟨γ, hγ⟩

theorem positiveWeightCompanionConeSubgroup_comm (α β : ι) :
    positiveWeightCompanionConeSubgroup P b O hc hm R α β =
      positiveWeightCompanionConeSubgroup P b O hc hm R β α := by
  apply le_antisymm
  · apply iSup_le
    intro γ
    exact positiveWeightCompanionRootSubgroup_le_cone P b O hc hm R β α γ.val
      ((positiveIntegralRootCone_comm P b α β γ.val.val).mp γ.property)
  · apply iSup_le
    intro γ
    exact positiveWeightCompanionRootSubgroup_le_cone P b O hc hm R α β γ.val
      ((positiveIntegralRootCone_comm P b α β γ.val.val).mpr γ.property)

/-- Original-pair cone containment implies the height-tail containment used
by the independently proved conditional collection theorem. -/
theorem positiveWeightCompanionConeSubgroup_le_height_tail
    (α β : {γ : ι // b.IsPos γ}) :
    positiveWeightCompanionConeSubgroup P b O hc hm R α.val β.val ≤
      ⨆ γ : {γ : {γ : ι // b.IsPos γ} // b.height β.val < b.height γ.val},
        positiveWeightCompanionRootSubgroup P b O hc hm R γ.val := by
  apply iSup_le
  intro γ
  exact le_iSup (fun δ : {δ : {γ : ι // b.IsPos γ} // b.height β.val < b.height δ.val} =>
    positiveWeightCompanionRootSubgroup P b O hc hm R δ.val)
    ⟨γ.val, (positiveIntegralRootCone_height_gt P b γ.property α.property β.property).2⟩

end Atlas.Chevalley
