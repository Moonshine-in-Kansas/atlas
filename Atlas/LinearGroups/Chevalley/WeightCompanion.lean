import Atlas.LinearGroups.Chevalley.Adjoint
import Atlas.LinearGroups.Chevalley.Integral.MinusculeOrbitRepresentation
import Mathlib.Data.Matrix.Block
import Mathlib.Algebra.DirectSum.Module
import Mathlib.LinearAlgebra.Pi

/-! Concrete simultaneous adjoint/minuscule root group, with a faithful block
matrix realization and specified surjection onto the actual adjoint group.
The root and weight ambient types share a universe; the coefficient ring may be in any universe.\nNo center, kernel, order, or simply-connectedness identification is assumed. -/
noncomputable section
universe u
namespace Atlas.Chevalley
open scoped DirectSum
open Classical Integral Integral.Minuscule
variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base)
  (O : κ → Finset (WeightLattice P))
  (hclosed : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hmin : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨ μ (corootElement P i) = 1)
  (R : Type*) [CommRing R]

abbrev WeightCompanionAmbient := Adjoint P b R ×
  (∀ a, (Matrix (WeightOrbit P (O a)) (WeightOrbit P (O a)) R)ˣ)

def weightCompanionRootX (i : b.support) (t : R) : WeightCompanionAmbient P b O R :=
  (adjointX P b R i t, fun a => weightOrbitRootElement P (O a) (hclosed a) (hmin a)
    R i.val (-1) (by decide) t)

def weightCompanionRootY (i : b.support) (t : R) : WeightCompanionAmbient P b O R :=
  (adjointY P b R i t, fun a => weightOrbitRootElement P (O a) (hclosed a) (hmin a)
    R i.val 1 (by decide) t)

def weightCompanionGenerators : Set (WeightCompanionAmbient P b O R) :=
  {g | (∃ i t, g = weightCompanionRootX P b O hclosed hmin R i t) ∨
    (∃ i t, g = weightCompanionRootY P b O hclosed hmin R i t)}

def weightCompanionSubgroup : Subgroup (WeightCompanionAmbient P b O R) :=
  Subgroup.closure (weightCompanionGenerators P b O hclosed hmin R)

/-- Actual subgroup generated by simultaneous operators, before SC claims. -/
abbrev WeightCompanion := ↥(weightCompanionSubgroup P b O hclosed hmin R)

def weightCompanionX (i : b.support) (t : R) : WeightCompanion P b O hclosed hmin R :=
  ⟨weightCompanionRootX P b O hclosed hmin R i t,
    Subgroup.subset_closure (Or.inl ⟨i,t,rfl⟩)⟩

def weightCompanionY (i : b.support) (t : R) : WeightCompanion P b O hclosed hmin R :=
  ⟨weightCompanionRootY P b O hclosed hmin R i t,
    Subgroup.subset_closure (Or.inr ⟨i,t,rfl⟩)⟩

/-- Restriction to the literal adjoint summand. -/
def weightCompanionRho : WeightCompanion P b O hclosed hmin R →* Adjoint P b R :=
  (MonoidHom.fst _ _).comp (weightCompanionSubgroup P b O hclosed hmin R).subtype

@[simp] theorem weightCompanionRho_X (i : b.support) (t : R) :
    weightCompanionRho P b O hclosed hmin R (weightCompanionX P b O hclosed hmin R i t) =
      adjointX P b R i t := rfl

@[simp] theorem weightCompanionRho_Y (i : b.support) (t : R) :
    weightCompanionRho P b O hclosed hmin R (weightCompanionY P b O hclosed hmin R i t) =
      adjointY P b R i t := rfl

theorem weightCompanionRho_surjective :
    Function.Surjective (weightCompanionRho P b O hclosed hmin R) :=
  adjointHom_surjective_of_root_lifts P b R _
    (weightCompanionX P b O hclosed hmin R) (weightCompanionY P b O hclosed hmin R)
    (weightCompanionRho_X P b O hclosed hmin R) (weightCompanionRho_Y P b O hclosed hmin R)

variable [Fintype κ]

/-- Index None is the actual adjoint block; each Some a is its actual weight orbit. -/
def WeightCompanionBlock : Option κ → Type _
  | none => b.support ⊕ ι
  | some a => WeightOrbit P (O a)

instance weightCompanionBlockFintype (a : Option κ) : Fintype (WeightCompanionBlock P b O a) := by
  cases a <;> dsimp [WeightCompanionBlock] <;> infer_instance

instance weightCompanionBlockDecidableEq (a : Option κ) : DecidableEq (WeightCompanionBlock P b O a) := by
  cases a <;> dsimp [WeightCompanionBlock] <;> infer_instance

abbrev WeightCompanionCoordinates := Σ a, WeightCompanionBlock P b O a

def weightCompanionBlockUnit (g : WeightCompanionAmbient P b O R) (a : Option κ) :
    (Matrix (WeightCompanionBlock P b O a) (WeightCompanionBlock P b O a) R)ˣ :=
  match a with
  | none => g.1.val
  | some a => g.2 a

/-- Actual block-diagonal invertible matrix on the finite direct-sum coordinates. -/
def weightCompanionAmbientMatrix (g : WeightCompanionAmbient P b O R) :
    (Matrix (WeightCompanionCoordinates P b O) (WeightCompanionCoordinates P b O) R)ˣ where
  val := Matrix.blockDiagonal' (fun a => (weightCompanionBlockUnit P b O R g a).val)
  inv := Matrix.blockDiagonal' (fun a => (weightCompanionBlockUnit P b O R g a).inv)
  val_inv := by
    rw [← Matrix.blockDiagonal'_mul]
    simp only [Units.val_inv]
    exact Matrix.blockDiagonal'_one
  inv_val := by
    rw [← Matrix.blockDiagonal'_mul]
    simp only [Units.inv_val]
    exact Matrix.blockDiagonal'_one

def weightCompanionAmbientMatrixHom : WeightCompanionAmbient P b O R →*
    (Matrix (WeightCompanionCoordinates P b O) (WeightCompanionCoordinates P b O) R)ˣ where
  toFun := weightCompanionAmbientMatrix P b O R
  map_one' := by
    apply Units.ext
    dsimp only [weightCompanionAmbientMatrix]
    have h : (fun a => (weightCompanionBlockUnit P b O R 1 a).val) = (fun a => (1 : Matrix (WeightCompanionBlock P b O a) _ R)) := by
      funext a
      cases a <;> rfl
    rw [h]
    exact Matrix.blockDiagonal'_one
  map_mul' g h := by
    apply Units.ext
    dsimp only [weightCompanionAmbientMatrix, Units.val_mul]
    rw [← Matrix.blockDiagonal'_mul]
    congr 1
    funext a
    cases a <;> rfl

theorem weightCompanionAmbientMatrixHom_injective :
    Function.Injective (weightCompanionAmbientMatrixHom P b O R) := by
  intro g h he
  have hm := congrArg Units.val he
  dsimp only [weightCompanionAmbientMatrixHom, MonoidHom.coe_mk, OneHom.coe_mk, weightCompanionAmbientMatrix] at hm
  have hb := Matrix.blockDiagonal'_injective hm
  apply Prod.ext
  · apply Subtype.ext
    apply Units.ext
    exact congrFun hb none
  · funext a
    apply Units.ext
    exact congrFun hb (some a)

/-- Faithful actual finite-matrix representation of the generated companion. -/
def weightCompanionMatrixRepresentation : WeightCompanion P b O hclosed hmin R →*
    (Matrix (WeightCompanionCoordinates P b O) (WeightCompanionCoordinates P b O) R)ˣ :=
  (weightCompanionAmbientMatrixHom P b O R).comp
    (weightCompanionSubgroup P b O hclosed hmin R).subtype

theorem weightCompanionMatrixRepresentation_injective :
    Function.Injective (weightCompanionMatrixRepresentation P b O hclosed hmin R) :=
  (weightCompanionAmbientMatrixHom_injective P b O R).comp Subtype.val_injective

instance weightCompanionFinite [Finite R] : Finite (WeightCompanion P b O hclosed hmin R) :=
  Finite.of_injective (weightCompanionMatrixRepresentation P b O hclosed hmin R)
    (weightCompanionMatrixRepresentation_injective P b O hclosed hmin R)


theorem weightCompanionMatrixRepresentation_block
    (g : WeightCompanion P b O hclosed hmin R) (a : Option κ)
    (r c : WeightCompanionBlock P b O a) :
    (weightCompanionMatrixRepresentation P b O hclosed hmin R g).val ⟨a,r⟩ ⟨a,c⟩ =
      (weightCompanionBlockUnit P b O R g.val a).val r c :=
  by
    dsimp only [weightCompanionMatrixRepresentation, MonoidHom.coe_comp, Function.comp_apply, Subgroup.coe_subtype, weightCompanionAmbientMatrixHom, MonoidHom.coe_mk, OneHom.coe_mk, weightCompanionAmbientMatrix]
    exact Matrix.blockDiagonal'_apply_eq _ _ _ _

theorem weightCompanionMatrixRepresentation_off_block
    (g : WeightCompanion P b O hclosed hmin R) {a a' : Option κ} (ha : a ≠ a')
    (r : WeightCompanionBlock P b O a) (c : WeightCompanionBlock P b O a') :
    (weightCompanionMatrixRepresentation P b O hclosed hmin R g).val ⟨a,r⟩ ⟨a',c⟩ = 0 :=
  by
    dsimp only [weightCompanionMatrixRepresentation, MonoidHom.coe_comp, Function.comp_apply, Subgroup.coe_subtype, weightCompanionAmbientMatrixHom, MonoidHom.coe_mk, OneHom.coe_mk, weightCompanionAmbientMatrix]
    exact Matrix.blockDiagonal'_apply_ne _ _ _ ha

/-- The coordinate module is explicitly the finite direct sum of the actual blocks. -/
def weightCompanionDirectSumEquiv :
    (WeightCompanionCoordinates P b O → R) ≃ₗ[R]
      (⨁ a : Option κ, (WeightCompanionBlock P b O a → R)) :=
  (LinearEquiv.piCurry R (fun (a : Option κ) (_ : WeightCompanionBlock P b O a) => R)).trans
    (DirectSum.linearEquivFunOnFintype R (Option κ)
      (fun a => WeightCompanionBlock P b O a → R)).symm

/-- Faithful linear realization on the actual direct-sum module. -/
def weightCompanionDirectSumRepresentation : WeightCompanion P b O hclosed hmin R →*
    LinearMap.GeneralLinearGroup R
      (⨁ a : Option κ, (WeightCompanionBlock P b O a → R)) :=
  (Units.map (weightCompanionDirectSumEquiv P b O R).conjRingEquiv.toMonoidHom).comp
    (Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp
      (weightCompanionMatrixRepresentation P b O hclosed hmin R))

theorem weightCompanionDirectSumRepresentation_injective :
    Function.Injective (weightCompanionDirectSumRepresentation P b O hclosed hmin R) :=
  (Units.map_injective (weightCompanionDirectSumEquiv P b O R).conjRingEquiv.injective).comp
    (Matrix.GeneralLinearGroup.toLin.injective.comp
      (weightCompanionMatrixRepresentation_injective P b O hclosed hmin R))

end Atlas.Chevalley
