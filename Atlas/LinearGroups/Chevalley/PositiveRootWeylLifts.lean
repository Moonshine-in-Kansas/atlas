import Atlas.LinearGroups.Chevalley.WeightCompanionRootPermutation
import Mathlib.Algebra.Group.Subgroup.Ker
import Mathlib.SetTheory.Cardinal.Finite

/-! Actual Weyl lifts and root families with their lift witness retained.
No independence of different lifts, positive-simple generation of the full
positive subgroup, or positive-root collection theorem is assumed. -/

noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule

variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base)

/-- Every positive root is in the orbit of a simple root under the actual
subgroup generated by simple-reflection permutations. Root lengths are not
forgotten: the originating simple root is part of the witness. -/
theorem positiveRoot_mem_simpleReflectionOrbit (β : ι) (hβ : b.IsPos β) :
    ∃ i : b.support, ∃ w : simpleRootPermutationSubgroup P b, w.val i.val = β := by
  apply hβ.induction_on_reflect
  · intro j hj
    exact ⟨⟨j, hj⟩, 1, rfl⟩
  · rintro j k ⟨i, w, hw⟩ hk
    let s : simpleRootPermutationSubgroup P b :=
      ⟨P.reflectionPerm k, Subgroup.subset_closure ⟨⟨k, hk⟩, rfl⟩⟩
    refine ⟨i, s * w, ?_⟩
    change P.reflectionPerm k (w.val i.val) = P.reflectionPerm k j
    rw [hw]

variable (O : κ → Finset (WeightLattice P))
  (hclosed : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hmin : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R] [Nontrivial R]

/-- A literal element of N taking a literal simple-root label to β. Different
witnesses are not identified; root-group independence is a later theorem. -/
structure WeightCompanionRootLift (β : ι) where
  simple : b.support
  lift : weightCompanionExtendedWeylSubgroup P b O hclosed hmin R
  root_eq : weightCompanionNRootPermHom P b O hclosed hmin R lift simple.val = β

/-- Every positive label has an actual N lift in the existing companion,
including over coefficient fields of characteristic two and three. -/
theorem positiveRoot_has_weightCompanionRootLift (β : ι) (hβ : b.IsPos β) :
    Nonempty (WeightCompanionRootLift P b O hclosed hmin R β) := by
  obtain ⟨i, w, hw⟩ := positiveRoot_mem_simpleReflectionOrbit P b β hβ
  obtain ⟨n, hn⟩ := weightCompanionNToSimpleRootPerm_surjective
    P b O hclosed hmin R w
  refine ⟨⟨i, n, ?_⟩⟩
  have he : weightCompanionNRootPermHom P b O hclosed hmin R n = w.val :=
    congrArg Subtype.val hn
  rw [he]
  exact hw

/-- The additive simple-root group conjugated by the specified actual lift.
The construction keeps the lift explicit, rather than claiming a canonical
root parametrization before the coherence theorem is proved. -/
def weightCompanionRootLiftHom {β : ι}
    (L : WeightCompanionRootLift P b O hclosed hmin R β) :
    Multiplicative R →* WeightCompanion P b O hclosed hmin R :=
  (MulAut.conj L.lift.val).toMonoidHom.comp
    (weightCompanionXHom P b O hclosed hmin R L.simple)

theorem weightCompanionRootLiftHom_apply {β : ι}
    (L : WeightCompanionRootLift P b O hclosed hmin R β) (t : Multiplicative R) :
    weightCompanionRootLiftHom P b O hclosed hmin R L t =
      L.lift.val * weightCompanionX P b O hclosed hmin R L.simple t.toAdd *
        L.lift.val⁻¹ := rfl

/-- The actual adjoint projection is injective on each witnessed root
family; no injectivity of the whole companion projection is needed. -/
theorem weightCompanionRho_rootLiftHom_injective {β : ι}
    (L : WeightCompanionRootLift P b O hclosed hmin R β) :
    Function.Injective ((weightCompanionRho P b O hclosed hmin R).comp
      (weightCompanionRootLiftHom P b O hclosed hmin R L)) := by
  intro s t h
  simp only [MonoidHom.comp_apply, weightCompanionRootLiftHom_apply,
    map_mul, map_inv, weightCompanionRho_X] at h
  have hx : adjointX P b R L.simple s.toAdd = adjointX P b R L.simple t.toAdd :=
    mul_left_cancel (mul_right_cancel h)
  exact Multiplicative.toAdd.injective (adjointX_injective P b R L.simple hx)

theorem weightCompanionRootLiftHom_injective {β : ι}
    (L : WeightCompanionRootLift P b O hclosed hmin R β) :
    Function.Injective (weightCompanionRootLiftHom P b O hclosed hmin R L) := by
  intro s t h
  apply weightCompanionRho_rootLiftHom_injective P b O hclosed hmin R L
  exact congrArg (weightCompanionRho P b O hclosed hmin R) h

/-- The witnessed actual root subgroup, as the image of its additive
parameter homomorphism inside the existing companion group. -/
def weightCompanionRootLiftSubgroup {β : ι}
    (L : WeightCompanionRootLift P b O hclosed hmin R β) :
    Subgroup (WeightCompanion P b O hclosed hmin R) :=
  (weightCompanionRootLiftHom P b O hclosed hmin R L).range

/-- An explicit isomorphism between the additive coefficient group and
the witnessed actual root subgroup. -/
def weightCompanionRootLiftEquiv {β : ι}
    (L : WeightCompanionRootLift P b O hclosed hmin R β) :
    Multiplicative R ≃* weightCompanionRootLiftSubgroup P b O hclosed hmin R L :=
  MonoidHom.ofInjective (weightCompanionRootLiftHom_injective P b O hclosed hmin R L)

/-- This is the order of a single witnessed root subgroup, not of U or G. -/
theorem weightCompanionRootLiftSubgroup_card {β : ι}
    (L : WeightCompanionRootLift P b O hclosed hmin R β) :
    Nat.card (weightCompanionRootLiftSubgroup P b O hclosed hmin R L) = Nat.card R := by
  calc
    _ = Nat.card (Multiplicative R) :=
      (Nat.card_congr (weightCompanionRootLiftEquiv P b O hclosed hmin R L).toEquiv).symm
    _ = Nat.card R := Nat.card_congr Multiplicative.toAdd

end Atlas.Chevalley
