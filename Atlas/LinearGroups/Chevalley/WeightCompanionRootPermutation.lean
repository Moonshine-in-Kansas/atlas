import Atlas.LinearGroups.Chevalley.WeylRootPermutation
import Atlas.LinearGroups.Chevalley.WeightCompanionExtendedWeyl
import Mathlib.LinearAlgebra.RootSystem.WeylGroup

/-! Source-only candidate. The actual N acts on the literal root labels.
The image is the subgroup generated by the simple-root reflection permutations.
No identification of the action kernel with T is asserted here. -/
noncomputable section
universe u
namespace Atlas.Chevalley
open Classical Integral Integral.Minuscule
variable {ι M N κ : Type u} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base)

/-- Finite root-permutation group generated by the pinned simple reflections.
Equality with the full mathlib Weyl image is a separate root-system assertion. -/
def simpleRootPermutationSubgroup : Subgroup (Equiv.Perm ι) :=
  Subgroup.closure (Set.range (fun i : b.support => P.reflectionPerm i.val))

theorem simpleRootPermutationSubgroup_le_weylImage :
    simpleRootPermutationSubgroup P b ≤ P.weylGroupToPerm.range := by
  rw [P.range_weylGroupToPerm]
  apply Subgroup.closure_mono
  rintro w ⟨i, rfl⟩
  exact ⟨i.val, rfl⟩

variable (O : κ → Finset (WeightLattice P))
  (hclosed : ∀ a i μ, μ ∈ O a → weightReflection P i μ ∈ O a)
  (hmin : ∀ a μ, μ ∈ O a → ∀ i,
    μ (corootElement P i) = -1 ∨ μ (corootElement P i) = 0 ∨
      μ (corootElement P i) = 1)
  (R : Type*) [CommRing R]

theorem weightCompanionRho_weyl (i : b.support) (a : Rˣ) :
    weightCompanionRho P b O hclosed hmin R
      (weightCompanionWeyl P b O hclosed hmin R i a) =
        adjointWeyl P b R i a := by
  simp only [weightCompanionWeyl, adjointWeyl, map_mul,
    weightCompanionRho_X, weightCompanionRho_Y]

/-- The actual torus fixes every root coordinate line, not merely its weights. -/
theorem weightCompanionTorus_rootPermutation
    (g : WeightCompanion P b O hclosed hmin R)
    (hg : g ∈ weightCompanionTorusSubgroup P b O hclosed hmin R) :
    AdjointRootPermutation P b R (weightCompanionRho P b O hclosed hmin R g) 1 := by
  change g ∈ Subgroup.closure _ at hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨i, a, rfl⟩ := hg
    rw [weightCompanionRho_torus]
    exact adjointRootPermutation_torus P b R i a
  | one =>
    rw [map_one]
    exact adjointRootPermutation_one P b R
  | mul g h hg hh ihg ihh =>
    rw [map_mul]
    simpa only [one_mul] using adjointRootPermutation_mul P b R ihg ihh
  | inv g hg ihg =>
    rw [map_inv]
    simpa only [inv_one] using adjointRootPermutation_inv P b R ihg

variable [Nontrivial R]

theorem weightCompanionExtendedWeyl_le_rootPermutation :
    weightCompanionExtendedWeylSubgroup P b O hclosed hmin R ≤
      (adjointRootPermutationSubgroup P b R
        (simpleRootPermutationSubgroup P b)).comap
          (weightCompanionRho P b O hclosed hmin R) := by
  change weightCompanionTorusSubgroup P b O hclosed hmin R ⊔
      weightCompanionWeylSubgroup P b O hclosed hmin R ≤ _
  apply sup_le
  · intro g hg
    exact ⟨1, (simpleRootPermutationSubgroup P b).one_mem,
      weightCompanionTorus_rootPermutation P b O hclosed hmin R g hg⟩
  · rw [weightCompanionWeylSubgroup, Subgroup.closure_le]
    rintro g ⟨i, rfl⟩
    refine ⟨P.reflectionPerm i, Subgroup.subset_closure ⟨i, rfl⟩, ?_⟩
    rw [weightCompanionRho_weyl]
    exact adjointRootPermutation_weyl P b R i

theorem weightCompanionExtendedWeyl_exists_rootPermutation
    (g : weightCompanionExtendedWeylSubgroup P b O hclosed hmin R) :
    ∃ w ∈ simpleRootPermutationSubgroup P b,
      AdjointRootPermutation P b R (weightCompanionRho P b O hclosed hmin R g.val) w :=
  weightCompanionExtendedWeyl_le_rootPermutation P b O hclosed hmin R g.property

def weightCompanionNRootPerm
    (g : weightCompanionExtendedWeylSubgroup P b O hclosed hmin R) : Equiv.Perm ι :=
  Classical.choose (weightCompanionExtendedWeyl_exists_rootPermutation
    P b O hclosed hmin R g)

theorem weightCompanionNRootPerm_spec
    (g : weightCompanionExtendedWeylSubgroup P b O hclosed hmin R) :
    weightCompanionNRootPerm P b O hclosed hmin R g ∈
        simpleRootPermutationSubgroup P b ∧
      AdjointRootPermutation P b R (weightCompanionRho P b O hclosed hmin R g.val)
        (weightCompanionNRootPerm P b O hclosed hmin R g) :=
  Classical.choose_spec (weightCompanionExtendedWeyl_exists_rootPermutation
    P b O hclosed hmin R g)

/-- Actual root-label permutation representation, including in characteristics
two and three. The adjoint root-coordinate lines distinguish the labels. -/
def weightCompanionNRootPermHom :
    weightCompanionExtendedWeylSubgroup P b O hclosed hmin R →* Equiv.Perm ι where
  toFun := weightCompanionNRootPerm P b O hclosed hmin R
  map_one' := by
    apply adjointRootPermutation_unique P b R
      (weightCompanionNRootPerm_spec P b O hclosed hmin R 1).2
    change AdjointRootPermutation P b R
      (weightCompanionRho P b O hclosed hmin R 1) 1
    rw [map_one]
    exact adjointRootPermutation_one P b R
  map_mul' g h := by
    apply adjointRootPermutation_unique P b R
      (weightCompanionNRootPerm_spec P b O hclosed hmin R (g * h)).2
    change AdjointRootPermutation P b R
      (weightCompanionRho P b O hclosed hmin R (g.val * h.val)) _
    rw [map_mul]
    exact adjointRootPermutation_mul P b R
      (weightCompanionNRootPerm_spec P b O hclosed hmin R g).2
      (weightCompanionNRootPerm_spec P b O hclosed hmin R h).2

theorem weightCompanionNRootPermHom_eq
    (g : weightCompanionExtendedWeylSubgroup P b O hclosed hmin R)
    (w : Equiv.Perm ι)
    (hw : AdjointRootPermutation P b R
      (weightCompanionRho P b O hclosed hmin R g.val) w) :
    weightCompanionNRootPermHom P b O hclosed hmin R g = w :=
  adjointRootPermutation_unique P b R
    (weightCompanionNRootPerm_spec P b O hclosed hmin R g).2 hw

/-- Literal simple Weyl word, viewed inside the actual subgroup N. -/
def weightCompanionSimpleWeylInN (i : b.support) :
    weightCompanionExtendedWeylSubgroup P b O hclosed hmin R :=
  ⟨weightCompanionWeyl P b O hclosed hmin R i 1,
    (show weightCompanionWeylSubgroup P b O hclosed hmin R ≤
      weightCompanionExtendedWeylSubgroup P b O hclosed hmin R from le_sup_right)
        (Subgroup.subset_closure ⟨i, rfl⟩)⟩

theorem weightCompanionNRootPermHom_simple (i : b.support) :
    weightCompanionNRootPermHom P b O hclosed hmin R
      (weightCompanionSimpleWeylInN P b O hclosed hmin R i) = P.reflectionPerm i := by
  apply weightCompanionNRootPermHom_eq
  change AdjointRootPermutation P b R (adjointWeyl P b R i 1) (P.reflectionPerm i)
  exact adjointRootPermutation_weyl P b R i

/-- Exact image of the actual N action. This is not a kernel theorem. -/
theorem weightCompanionNRootPermHom_range :
    (weightCompanionNRootPermHom P b O hclosed hmin R).range =
      simpleRootPermutationSubgroup P b := by
  apply le_antisymm
  · rintro w ⟨g, rfl⟩
    exact (weightCompanionNRootPerm_spec P b O hclosed hmin R g).1
  · rw [simpleRootPermutationSubgroup, Subgroup.closure_le]
    rintro w ⟨i, rfl⟩
    exact ⟨weightCompanionSimpleWeylInN P b O hclosed hmin R i,
      weightCompanionNRootPermHom_simple P b O hclosed hmin R i⟩

theorem weightCompanionTorus_le_rootPermKer :
    ((weightCompanionTorusSubgroup P b O hclosed hmin R).subgroupOf
      (weightCompanionExtendedWeylSubgroup P b O hclosed hmin R)) ≤
        (weightCompanionNRootPermHom P b O hclosed hmin R).ker := by
  intro g hg
  change weightCompanionNRootPermHom P b O hclosed hmin R g = 1
  apply weightCompanionNRootPermHom_eq
  exact weightCompanionTorus_rootPermutation P b O hclosed hmin R g.val hg

/-- Codomain-restricted surjection onto the finite simple-reflection image. -/
def weightCompanionNToSimpleRootPerm :
    weightCompanionExtendedWeylSubgroup P b O hclosed hmin R →*
      simpleRootPermutationSubgroup P b :=
  (weightCompanionNRootPermHom P b O hclosed hmin R).codRestrict
    (simpleRootPermutationSubgroup P b)
    (fun g => (weightCompanionNRootPerm_spec P b O hclosed hmin R g).1)

theorem weightCompanionNToSimpleRootPerm_surjective :
    Function.Surjective (weightCompanionNToSimpleRootPerm P b O hclosed hmin R) := by
  intro w
  have hw : w.val ∈ (weightCompanionNRootPermHom P b O hclosed hmin R).range := by
    rw [weightCompanionNRootPermHom_range]
    exact w.property
  obtain ⟨g, hg⟩ := hw
  exact ⟨g, Subtype.ext hg⟩

end Atlas.Chevalley
