import Atlas.LinearGroups.Chevalley.RootData.ClassicalBasesD
import Atlas.LinearGroups.Chevalley.RootData.DominantFunctionalStabilizer

/-! The first coordinate functional on the actual D root lattice in rank at
least three. Its stabilizer in the actual root-permutation Weyl group is the
parabolic generated by all simple nodes except the first. -/
noncomputable section
namespace Atlas.Chevalley.ClassicalDParabolic
open Classical ClassicalData RootData

/-- The first coordinate is an additive rational functional on the actual
integral root span, without extending that span to the full coordinate lattice. -/
def coordinateFunctional (n : ℕ) : (pairingD (n + 3)).rootSpan ℤ →+ ℚ where
  toFun x := (x.val 0 : ℚ)
  map_zero' := by simp
  map_add' x y := by simp

/-- All simple nodes except node zero, with the existing D fork numbering. -/
def J (n : ℕ) : Finset (baseD (n + 1)).support :=
  Finset.univ.erase (baseDIndexEquiv (n + 1) 0)

private theorem simpleD_first (n : ℕ) (i : Fin (n + 3)) :
    (simpleD (n + 1) i).val 0 = if i = 0 then 1 else 0 := by
  rw [simpleD_vector]
  by_cases hi : i.val = n + 1 + 1
  · simp only [hi, dite_true]
    have hi0 : i ≠ 0 := by
      intro h
      subst i
      simp only [Fin.val_zero] at hi
      omega
    have hp : (0 : Fin (n + 3)) ≠ ⟨n + 1, by omega⟩ := by
      intro h
      have hh := congrArg Fin.val h
      simp only [Fin.val_zero, Fin.val_mk] at hh
      omega
    have hq : (0 : Fin (n + 3)) ≠ ⟨n + 1 + 1, by omega⟩ := by
      intro h
      have hh := congrArg Fin.val h
      simp only [Fin.val_zero, Fin.val_mk] at hh
      omega
    simp [Pi.add_apply, Pi.single_apply, hp, hq, hi0]
  · simp only [hi, dite_false]
    have hnext : (0 : Fin (n + 3)) ≠ ⟨i.val + 1, by omega⟩ := by
      intro h
      have hh := congrArg Fin.val h
      simp only [Fin.val_zero, Fin.val_mk] at hh
      omega
    simp [Pi.sub_apply, Pi.single_apply, hnext, eq_comm]

theorem coordinateFunctional_simple (n : ℕ) (i : Fin (n + 3)) :
    coordinateFunctional n
      ((pairingD (n + 3)).rootSpanMem ℤ (baseDIndexEquiv (n + 1) i).val) =
        if i = 0 then 1 else 0 := by
  change ((simpleD (n + 1) i).val 0 : ℚ) = _
  rw [simpleD_first]
  split_ifs <;> norm_num

theorem coordinateFunctional_nonneg (n : ℕ) (i : (baseD (n + 1)).support) :
    0 ≤ coordinateFunctional n ((pairingD (n + 3)).rootSpanMem ℤ i.val) := by
  obtain ⟨k, rfl⟩ := (baseDIndexEquiv (n + 1)).surjective i
  rw [coordinateFunctional_simple]
  split_ifs <;> norm_num

theorem coordinateFunctional_zero_simple (n : ℕ) :
    rootFunctionalZeroSimple (pairingD (n + 3)) (baseD (n + 1))
      (coordinateFunctional n) = J n := by
  ext i
  obtain ⟨k, rfl⟩ := (baseDIndexEquiv (n + 1)).surjective i
  simp only [rootFunctionalZeroSimple, Finset.mem_filter, Finset.mem_univ, true_and,
    coordinateFunctional_simple, J, Finset.mem_erase, and_true]
  by_cases hk : k = 0
  · subst k
    simp
  · have hne : baseDIndexEquiv (n + 1) k ≠ baseDIndexEquiv (n + 1) 0 := by
      intro he
      exact hk ((baseDIndexEquiv (n + 1)).injective he)
    simp [hk, hne]

/-- The actual functional stabilizer is the parabolic omitting the first node. -/
theorem coordinateFunctional_stabilizer (n : ℕ) :
    rootFunctionalStabilizer (pairingD (n + 3)) (coordinateFunctional n) =
      rootParabolicSubgroup (pairingD (n + 3)) (baseD (n + 1)) (J n) := by
  simpa only [coordinateFunctional_zero_simple] using
    rootFunctionalStabilizer_eq_parabolic (pairingD (n + 3)) (baseD (n + 1))
      (coordinateFunctional n) (coordinateFunctional_nonneg n)

/-- A Weyl element is in this parabolic exactly when it preserves the first
coordinate of every actual D root. No signed-permutation recognition is used. -/
theorem mem_parabolic_iff_preserves_first (n : ℕ)
    (w : (pairingD (n + 3)).weylGroupToPerm.range) :
    w ∈ rootParabolicSubgroup (pairingD (n + 3)) (baseD (n + 1)) (J n) ↔
      ∀ β : DRoot (n + 3), (w.val β).val 0 = β.val 0 := by
  rw [← coordinateFunctional_stabilizer]
  change (∀ β : DRoot (n + 3), ((w.val β).val 0 : ℚ) = (β.val 0 : ℚ)) ↔ _
  constructor
  · intro h β
    exact Int.cast_injective (h β)
  · intro h β
    exact congrArg (fun z : ℤ => (z : ℚ)) (h β)

end Atlas.Chevalley.ClassicalDParabolic
