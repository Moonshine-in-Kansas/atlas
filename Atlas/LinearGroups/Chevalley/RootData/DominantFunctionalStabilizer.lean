import Atlas.LinearGroups.Chevalley.RootData.ParabolicWordReduction
import Atlas.LinearGroups.Chevalley.RootData.PositiveSupportedRootImage
import Mathlib.Tactic.Linarith

/-! The stabilizer of a dominant additive functional on the actual root
lattice is the actual parabolic subgroup generated by its zero simple roots.
The proof uses actual root signs and length descent, not orbit recognition. -/
noncomputable section
namespace Atlas.Chevalley.RootData
open Classical
variable {ι M N : Type*} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base)

/-- Simple reflection acts on the functional by the literal root pairing. -/
theorem rootLatticeFunctional_reflection (f : P.rootSpan ℤ →+ ℚ)
    (i β : ι) :
    f (P.rootSpanMem ℤ (P.reflectionPerm i β)) =
      f (P.rootSpanMem ℤ β) - (P.pairing β i : ℚ) * f (P.rootSpanMem ℤ i) := by
  have hs : P.rootSpanMem ℤ (P.reflectionPerm i β) =
      P.rootSpanMem ℤ β - P.pairing β i • P.rootSpanMem ℤ i := by
    apply Subtype.ext
    simp only [Submodule.coe_sub, Submodule.coe_smul,
      P.root_reflectionPerm, P.reflection_apply_root]
  rw [hs, map_sub, map_zsmul, zsmul_eq_mul]

/-- Actual root permutations preserving the functional on every root. -/
def rootFunctionalStabilizer (f : P.rootSpan ℤ →+ ℚ) :
    Subgroup P.weylGroupToPerm.range where
  carrier := {w | ∀ β, f (P.rootSpanMem ℤ (w.val β)) = f (P.rootSpanMem ℤ β)}
  one_mem' β := rfl
  mul_mem' {g h} hg hh β := (hg (h.val β)).trans (hh β)
  inv_mem' {g} hg β := by
    have h := hg ((g⁻¹).val β)
    have he : g.val ((g⁻¹).val β) = β := g.val.apply_symm_apply β
    simpa only [he] using h.symm

/-- The simple-root wall set of the actual functional. -/
def rootFunctionalZeroSimple (f : P.rootSpan ℤ →+ ℚ) : Finset b.support :=
  Finset.univ.filter (fun i => f (P.rootSpanMem ℤ i.val) = 0)

theorem rootParabolicZero_le_functionalStabilizer (f : P.rootSpan ℤ →+ ℚ) :
    rootParabolicSubgroup P b (rootFunctionalZeroSimple P b f) ≤
      rootFunctionalStabilizer P f := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, hi, rfl⟩ β
  have hi0 : f (P.rootSpanMem ℤ i.val) = 0 := (Finset.mem_filter.mp hi).2
  change f (P.rootSpanMem ℤ (P.reflectionPerm i.val β)) = _
  rw [rootLatticeFunctional_reflection P f, hi0, mul_zero, sub_zero]

/-- A dominant functional's actual stabilizer is generated by its zero walls.
No faithfulness of a representation or classification of parabolics is assumed. -/
theorem rootFunctionalStabilizer_eq_parabolic
    (f : P.rootSpan ℤ →+ ℚ)
    (hf : ∀ i : b.support, 0 ≤ f (P.rootSpanMem ℤ i.val)) :
    rootFunctionalStabilizer P f =
      rootParabolicSubgroup P b (rootFunctionalZeroSimple P b f) := by
  apply le_antisymm
  · intro w hw
    have haux : ∀ n : ℕ, ∀ v : P.weylGroupToPerm.range,
        rootWeylLength P b v = n → v ∈ rootFunctionalStabilizer P f →
          v ∈ rootParabolicSubgroup P b (rootFunctionalZeroSimple P b f) := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro v hvn hv
        by_cases hv1 : v = 1
        · simpa only [hv1] using
            (rootParabolicSubgroup P b (rootFunctionalZeroSimple P b f)).one_mem
        · have hex : ∃ i : b.support, ¬ b.IsPos (v.val i.val) := by
            by_contra hn
            apply hv1
            apply (rootWeyl_preserves_positive_iff_one P b v).mp
            intro β hβ
            apply rootWeyl_isPos_of_simple_support P b Finset.univ v _ hβ
              (Finset.subset_univ _)
            intro i hi
            by_contra hneg
            exact hn ⟨i, hneg⟩
          obtain ⟨i, hi⟩ := hex
          have hop : b.IsPos (P.reflectionPerm (v.val i.val) (v.val i.val)) :=
            (RootPairing.Base.IsPos.neg_iff_not b (v.val i.val)).mpr hi
          have hn := positiveRoot_functional_nonneg P b f hf hop
          rw [P.rootSpanMem_reflectionPerm_self, map_neg] at hn
          have he : f (P.rootSpanMem ℤ (v.val i.val)) =
              f (P.rootSpanMem ℤ i.val) := hv i.val
          have hi0 : f (P.rootSpanMem ℤ i.val) = 0 := by
            have hnonneg := hf i
            linarith
          have himem : i ∈ rootFunctionalZeroSimple P b f :=
            Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi0⟩
          have hs : simpleWeylReflection P b i ∈
              rootParabolicSubgroup P b (rootFunctionalZeroSimple P b f) :=
            Subgroup.subset_closure ⟨i, himem, rfl⟩
          have hstable : simpleWeylReflection P b i ∈ rootFunctionalStabilizer P f :=
            rootParabolicZero_le_functionalStabilizer P b f hs
          have hstep := rootWeylLength_mul_simple_of_negative P b v i hi
          have hlt : rootWeylLength P b (v * simpleWeylReflection P b i) < n := by
            omega
          have hmem := ih _ hlt _ rfl
            ((rootFunctionalStabilizer P f).mul_mem hv hstable)
          have hm := (rootParabolicSubgroup P b (rootFunctionalZeroSimple P b f)).mul_mem
            hmem hs
          simpa only [mul_assoc, simpleWeylReflection_mul_self, mul_one] using hm
    exact haux _ w rfl hw
  · exact rootParabolicZero_le_functionalStabilizer P b f

end Atlas.Chevalley.RootData
