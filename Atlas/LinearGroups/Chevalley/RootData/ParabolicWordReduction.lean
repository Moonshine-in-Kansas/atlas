import Atlas.LinearGroups.Chevalley.RootData.SimpleReflectionReducedWords

/-! Actual standard parabolic subgroups and reduced words retaining their
simple support. The shortening step is the already proved root exchange. -/
noncomputable section
namespace Atlas.Chevalley.RootData
open Classical
variable {ι M N : Type*} [Fintype ι] [DecidableEq ι]
  [AddCommGroup M] [AddCommGroup N]
  (P : RootPairing ι ℤ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base)

/-- The subgroup of the actual Weyl image generated by the selected simple reflections. -/
def rootParabolicSubgroup (J : Finset b.support) : Subgroup P.weylGroupToPerm.range :=
  Subgroup.closure ((simpleWeylReflection P b) '' (J : Set b.support))

private theorem word_append_simple (l : List b.support) (i : b.support) :
    rootWeylWord P b (l ++ [i]) = rootWeylWord P b l * simpleWeylReflection P b i := by
  rw [rootWeylWord_append]
  simp only [rootWeylWord, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]

theorem rootWeylWord_mem_parabolic (J : Finset b.support) (l : List b.support)
    (hl : ∀ i ∈ l, i ∈ J) : rootWeylWord P b l ∈ rootParabolicSubgroup P b J := by
  induction l with
  | nil => exact (rootParabolicSubgroup P b J).one_mem
  | cons i l ih =>
    change simpleWeylReflection P b i * rootWeylWord P b l ∈ rootParabolicSubgroup P b J
    exact (rootParabolicSubgroup P b J).mul_mem
      (Subgroup.subset_closure ⟨i, hl i List.mem_cons_self, rfl⟩)
      (ih (fun j hj => hl j (List.mem_cons_of_mem i hj)))

theorem rootParabolic_mem_iff_word (J : Finset b.support) (w : P.weylGroupToPerm.range) :
    w ∈ rootParabolicSubgroup P b J ↔
      ∃ l : List b.support, (∀ i ∈ l, i ∈ J) ∧ rootWeylWord P b l = w := by
  constructor
  · intro hw
    induction hw using Subgroup.closure_induction with
    | mem g hg =>
      obtain ⟨i, hi, rfl⟩ := hg
      refine ⟨[i], ?_, ?_⟩
      · intro j hj
        simpa only [List.mem_singleton.mp hj, Finset.mem_coe] using hi
      · simp only [rootWeylWord, List.map_cons, List.map_nil,
          List.prod_cons, List.prod_nil, mul_one]
    | one => exact ⟨[], by simp, rfl⟩
    | mul g h hg hh ihg ihh =>
      obtain ⟨l, hl, rfl⟩ := ihg
      obtain ⟨r, hr, rfl⟩ := ihh
      refine ⟨l ++ r, ?_, rootWeylWord_append P b l r⟩
      intro i hi
      exact (List.mem_append.mp hi).elim (hl i) (hr i)
    | inv g hg ih =>
      obtain ⟨l, hl, rfl⟩ := ih
      exact ⟨l.reverse, fun i hi => hl i (List.mem_reverse.mp hi), rootWeylWord_reverse P b l⟩
  · rintro ⟨l, hl, rfl⟩
    exact rootWeylWord_mem_parabolic P b J l hl

/-- Any selected-letter word can be reduced without introducing another simple letter. -/
theorem rootWord_exists_reduced_with_letters (J : Finset b.support) (l : List b.support)
    (hl : ∀ i ∈ l, i ∈ J) :
    ∃ r : List b.support, (∀ i ∈ r, i ∈ J) ∧
      rootWeylWord P b r = rootWeylWord P b l ∧ IsReducedRootWord P b r := by
  induction l using List.reverseRecOn with
  | nil =>
    refine ⟨[], by simp, rfl, ?_⟩
    exact Nat.eq_zero_of_le_zero (rootWeylWord_length_le P b [])
  | append_singleton l i ih =>
    have hi : i ∈ J := hl i (List.mem_append_right _ (List.mem_singleton_self _))
    obtain ⟨r, hr, hrl, hred⟩ := ih (fun j hj => hl j (List.mem_append_left _ hj))
    by_cases hp : b.IsPos ((rootWeylWord P b r).val i.val)
    · refine ⟨r ++ [i], ?_, ?_, ?_⟩
      · intro j hj
        rcases List.mem_append.mp hj with hj | hj
        · exact hr j hj
        · simpa only [List.mem_singleton.mp hj] using hi
      · rw [word_append_simple, word_append_simple, hrl]
      · have hs := rootWeylLength_mul_simple_of_positive P b (rootWeylWord P b r) i hp
        change rootWeylLength P b (rootWeylWord P b r) = r.length at hred
        change rootWeylLength P b (rootWeylWord P b (r ++ [i])) = (r ++ [i]).length
        rw [word_append_simple, hs, hred, List.length_append, List.length_singleton]
    · obtain ⟨a, j, c, hrac, hex⟩ := simpleReflectionWord_exchange P b
        (b.isPos_of_mem_support i.property) r (by simpa only [rootWeylWord_val] using hp)
      have he : rootWeylWord P b (a ++ c) =
          rootWeylWord P b r * simpleWeylReflection P b i := by
        apply Subtype.ext
        change (rootWeylWord P b (a ++ c)).val =
          (rootWeylWord P b r).val * P.reflectionPerm i.val
        simpa only [rootWeylWord_val] using hex.symm
      refine ⟨a ++ c, ?_, ?_, ?_⟩
      · intro k hk
        apply hr k
        rw [hrac]
        rcases List.mem_append.mp hk with hk | hk
        · exact List.mem_append_left _ hk
        · exact List.mem_append_right _ (List.mem_cons_of_mem j hk)
      · rw [he, hrl, word_append_simple]
      · have hs := rootWeylLength_mul_simple_of_negative P b (rootWeylWord P b r) i hp
        change rootWeylLength P b (rootWeylWord P b r) = r.length at hred
        have hlenr : r.length = a.length + c.length + 1 := by
          rw [hrac, List.length_append, List.length_cons]
          omega
        change rootWeylLength P b (rootWeylWord P b (a ++ c)) = (a ++ c).length
        rw [he, List.length_append]
        omega

theorem rootParabolic_exists_reduced_word (J : Finset b.support)
    (w : P.weylGroupToPerm.range) (hw : w ∈ rootParabolicSubgroup P b J) :
    ∃ l : List b.support, (∀ i ∈ l, i ∈ J) ∧
      rootWeylWord P b l = w ∧ IsReducedRootWord P b l := by
  obtain ⟨l, hl, rfl⟩ := (rootParabolic_mem_iff_word P b J w).mp hw
  exact rootWord_exists_reduced_with_letters P b J l hl

end Atlas.Chevalley.RootData
