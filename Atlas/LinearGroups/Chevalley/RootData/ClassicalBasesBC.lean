import Atlas.LinearGroups.Chevalley.RootData.Classical
import Atlas.LinearGroups.Chevalley.RootData.A
import Mathlib.LinearAlgebra.RootSystem.CartanMatrix
import Mathlib.LinearAlgebra.Matrix.Cartan

/-! Actual integral coordinate bases and Cartan numbering for B and C. -/
namespace Atlas.Chevalley.ClassicalData

set_option maxHeartbeats 800000
open Classical

@[simp] theorem dot_single_left {n : ℕ} (i : Fin n) (t : ℤ) (x : Lattice n) :
    dot (Pi.single i t) x = t * x i := by
  rw [dot_comm, dot_single]
  ring

/-- Consecutive differences followed by t times the last coordinate. -/
def chainVector (n : ℕ) (t : ℤ) (i : Fin (n + 1)) : Lattice (n + 1) :=
  if h : i.val < n then
    Pi.single i 1 - Pi.single ⟨i.val + 1, by omega⟩ 1
  else t • Pi.single i 1

@[simp] theorem chainVector_castSucc (n : ℕ) (t : ℤ) (i : Fin n) :
    chainVector n t i.castSucc = Pi.single i.castSucc 1 - Pi.single i.succ 1 := by
  simp only [chainVector, Fin.val_castSucc, i.isLt, dite_true]; congr 2

@[simp] theorem chainVector_last (n : ℕ) (t : ℤ) :
    chainVector n t (Fin.last n) = t • Pi.single (Fin.last n) 1 := by
  simp [chainVector]

/-- The positive monoid generated by the displayed chain and terminal root. -/
def chainPositive (n : ℕ) (t : ℤ) : AddSubmonoid (Lattice (n + 1)) :=
  AddSubmonoid.closure (Set.range (chainVector n t))

theorem chainVector_mem (n : ℕ) (t : ℤ) (i : Fin (n + 1)) :
    chainVector n t i ∈ chainPositive n t :=
  AddSubmonoid.subset_closure ⟨i, rfl⟩

/-- Reuse the checked A-chain telescoping theorem. -/
theorem increasing_mem_chain (n : ℕ) (t : ℤ) (i j : Fin (n + 1)) (h : i ≤ j) :
    Pi.single i (1 : ℤ) - Pi.single j 1 ∈ chainPositive n t := by
  apply AddSubmonoid.closure_mono _ (TypeAData.increasing_difference_mem i j h)
  rintro _ ⟨k, rfl⟩
  exact ⟨k.castSucc, (chainVector_castSucc n t k).trans rfl⟩

theorem axis_mem_chain_one (n : ℕ) (i : Fin (n + 1)) :
    Pi.single i (1 : ℤ) ∈ chainPositive n 1 := by
  have hi := increasing_mem_chain n 1 i (Fin.last n) (Fin.le_last i)
  have hl := chainVector_mem n 1 (Fin.last n)
  simpa only [chainVector_last, one_smul, sub_add_cancel] using
    AddSubmonoid.add_mem _ hi hl

theorem twice_axis_mem_chain_two (n : ℕ) (i : Fin (n + 1)) :
    (2 : ℤ) • Pi.single i 1 ∈ chainPositive n 2 := by
  have hi := increasing_mem_chain n 2 i (Fin.last n) (Fin.le_last i)
  have hl := chainVector_mem n 2 (Fin.last n)
  have hh := AddSubmonoid.add_mem _ (AddSubmonoid.add_mem _ hi hi) hl
  rw [chainVector_last] at hh
  convert hh using 1 <;> ext k <;> simp only [Pi.add_apply, Pi.sub_apply,
    Pi.smul_apply, smul_eq_mul] <;> ring

theorem sum_mem_chain_two (n : ℕ) (i j : Fin (n + 1)) :
    Pi.single i (1 : ℤ) + Pi.single j 1 ∈ chainPositive n 2 := by
  rcases le_total i j with hij | hji
  · have hd := increasing_mem_chain n 2 i j hij
    have hj := twice_axis_mem_chain_two n j
    have hh := AddSubmonoid.add_mem _ hd hj
    convert hh using 1 <;> ext k <;> simp only [Pi.add_apply, Pi.sub_apply,
      Pi.smul_apply, smul_eq_mul] <;> ring
  · have hd := increasing_mem_chain n 2 j i hji
    have hi := twice_axis_mem_chain_two n i
    have hh := AddSubmonoid.add_mem _ hd hi
    convert hh using 1 <;> ext k <;> simp only [Pi.add_apply, Pi.sub_apply,
      Pi.smul_apply, smul_eq_mul] <;> ring

/-- Actual B simple roots with the final root short. -/
def simpleB (n : ℕ) (i : Fin (n + 1)) : BRoot (n + 1) :=
  if h : i.val < n then
    longRoot true i ⟨i.val + 1, by omega⟩ (by intro he; have hv := congrArg Fin.val he; change i.val = i.val + 1 at hv; omega)
      1 (-1) (Or.inl rfl) (Or.inr rfl)
  else shortRoot i 1 (Or.inl rfl)

theorem simpleB_vector (n : ℕ) (i : Fin (n + 1)) :
    (simpleB n i).1 = chainVector n 1 i := by
  unfold simpleB chainVector
  split_ifs <;> simp [longRoot, shortRoot, sub_eq_add_neg, Pi.single_neg]

theorem simpleB_coroot_vector (n : ℕ) (i : Fin (n + 1)) :
    coroot (simpleB n i) = functional (chainVector n 2 i) := by
  apply LinearMap.ext
  intro x
  unfold simpleB chainVector
  split_ifs with hi
  · simp only [coroot_long, functional_apply, dot_sub_left, dot_single_left]; ring
  · simp only [coroot_short, functional_apply, dot_smul_left, dot_single_left]; ring

/-- Integral cumulative-coordinate map; a left inverse for the B simple roots. -/
def cumulative (n : ℕ) : Lattice (n + 1) →ₗ[ℤ] Lattice (n + 1) where
  toFun x i := ∑ k ∈ Finset.univ.filter (fun k : Fin (n + 1) => k.val ≤ i.val), x k
  map_add' x y := by ext i; simp [Finset.sum_add_distrib]
  map_smul' t x := by ext i; simp [Finset.mul_sum]

theorem cumulative_chain (n : ℕ) (t : ℤ) (j : Fin (n + 1)) :
    cumulative n (chainVector n t j) =
      (if j.val = n then t else 1) • Pi.single j 1 := by
  funext i
  by_cases hj : j.val < n
  · simp only [chainVector, hj, dite_true]
    simp [cumulative, Finset.sum_sub_distrib, Pi.single_apply]
    simp only [Fin.ext_iff, Fin.val_mk]
    split_ifs <;> simp only [Fin.le_def, Fin.val_mk] at * <;> omega
  · have hjn : j.val = n := by have := j.isLt; omega
    simp only [chainVector, hj, dite_false, hjn, ite_true, map_smul]
    simp [cumulative, Pi.smul_apply, smul_eq_mul, Pi.single_apply]
    simp only [Fin.ext_iff, Fin.val_mk]
    split_ifs <;> first | rfl | (have := i.isLt; omega)

theorem chain_one_independent (n : ℕ) : LinearIndependent ℤ (chainVector n 1) := by
  apply LinearIndependent.of_comp (cumulative n)
  have he : cumulative n ∘ chainVector n 1 = Pi.basisFun ℤ (Fin (n + 1)) := by
    funext i
    simp [Function.comp_def, cumulative_chain]
  rw [he]
  exact (Pi.basisFun ℤ (Fin (n + 1))).linearIndependent

/-- Evaluation on coordinate vectors identifies dual functionals with their coefficients. -/
def functionalCoordinates (n : ℕ) : Module.Dual ℤ (Lattice n) →ₗ[ℤ] Lattice n where
  toFun f i := f (Pi.single i 1)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp] theorem functionalCoordinates_functional (n : ℕ) (x : Lattice n) :
    functionalCoordinates n (functional x) = x := by
  funext i
  simp [functionalCoordinates]

/-- The actual specified simple-root vectors have the pinned B Cartan matrix. -/
theorem simpleB_cartan (n : ℕ) (i j : Fin (n + 1)) :
    coroot (simpleB n j) (simpleB n i).1 = CartanMatrix.B (n + 1) i j := by
  rw [simpleB_vector, simpleB_coroot_vector]
  simp only [functional_apply]
  unfold chainVector CartanMatrix.B
  simp only [Matrix.of_apply]
  split_ifs <;>
    simp [dot_sub_left, dot_sub_right, dot_smul_left, dot_smul_right,
      dot_single, dot_single_left, Pi.single_apply, Fin.ext_iff] <;>
    (try split_ifs) <;> simp only [Fin.ext_iff, Fin.val_mk] at * <;> omega

theorem chain_independent (n : ℕ) (t : ℤ) (ht : t ≠ 0) :
    LinearIndependent ℤ (chainVector n t) := by
  rw [Fintype.linearIndependent_iffₛ]
  intro f g h i
  have hm := congrArg (cumulative n) h
  simp only [map_sum, map_smul, cumulative_chain] at hm
  have hi := congrFun hm i
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at hi
  try simp only [Pi.single_apply] at hi
  try simp only [mul_ite, mul_one, mul_zero] at hi
  simp only [Finset.sum_ite_eq, Finset.mem_univ, if_true] at hi
  by_cases he : i.val = n
  · simp only [he, ite_true] at hi
    exact mul_right_cancel₀ ht hi
  · simpa only [he, ite_false] using hi

theorem simpleB_independent (n : ℕ) :
    LinearIndependent ℤ (fun i => (simpleB n i).1) := by
  simpa only [simpleB_vector] using chain_one_independent n

theorem simpleB_injective (n : ℕ) : Function.Injective (simpleB n) := by
  intro i j h
  apply (simpleB_independent n).injective
  exact congrArg Subtype.val h

theorem simpleB_coroot_independent (n : ℕ) :
    LinearIndependent ℤ (fun i => coroot (simpleB n i)) := by
  apply LinearIndependent.of_comp (functionalCoordinates (n + 1))
  have he : functionalCoordinates (n + 1) ∘ (fun i => coroot (simpleB n i)) =
      chainVector n 2 := by
    funext i
    simp [Function.comp_def, simpleB_coroot_vector]
  rw [he]
  exact chain_independent n 2 (by norm_num)

/-- General positive/negative classification of signed coordinate pairs along a chain. -/
theorem signed_pair_mem_chain (n : ℕ) (terminal : ℤ)
    (sum_mem : ∀ i j : Fin (n + 1), Pi.single i (1 : ℤ) + Pi.single j 1 ∈ chainPositive n terminal)
    (i j : Fin (n + 1)) (s t : ℤ) (hs : s = 1 ∨ s = -1) (ht : t = 1 ∨ t = -1) :
    Pi.single i s + Pi.single j t ∈ chainPositive n terminal ∨
      -(Pi.single i s + Pi.single j t) ∈ chainPositive n terminal := by
  rcases hs with rfl | rfl <;> rcases ht with rfl | rfl
  · exact Or.inl (sum_mem i j)
  · rcases le_total i j with h | h
    · left; simpa [Pi.single_neg, sub_eq_add_neg] using increasing_mem_chain n terminal i j h
    · right; simpa [Pi.single_neg, sub_eq_add_neg, neg_add_rev, add_comm] using increasing_mem_chain n terminal j i h
  · rcases le_total j i with h | h
    · left; simpa [Pi.single_neg, sub_eq_add_neg, add_comm] using increasing_mem_chain n terminal j i h
    · right; simpa [Pi.single_neg, sub_eq_add_neg, neg_add_rev, add_comm] using increasing_mem_chain n terminal i j h
  · right; simpa [Pi.single_neg, add_comm] using sum_mem i j

theorem root_mem_chain_one (n : ℕ) (a : BRoot (n + 1)) :
    a.1 ∈ chainPositive n 1 ∨ -a.1 ∈ chainPositive n 1 := by
  rcases signed_support_classification a with ⟨_, i, s, hs, ha⟩ | ⟨i, j, _, s, t, hs, ht, ha⟩
  · rw [ha]
    rcases hs with rfl | rfl
    · exact Or.inl (axis_mem_chain_one n i)
    · right; simpa [Pi.single_neg, add_comm] using axis_mem_chain_one n i
  · rw [ha]
    exact signed_pair_mem_chain n 1
      (fun i j => AddSubmonoid.add_mem _ (axis_mem_chain_one n i) (axis_mem_chain_one n j))
      i j s t hs ht

theorem coroot_vector_mem_chain_two (n : ℕ) (a : BRoot (n + 1)) :
    corootScale a • a.1 ∈ chainPositive n 2 ∨
      -(corootScale a • a.1) ∈ chainPositive n 2 := by
  rcases signed_support_classification a with ⟨_, i, s, hs, ha⟩ | ⟨i, j, hij, s, t, hs, ht, ha⟩
  · have he : a = shortRoot i s hs := Subtype.ext ha
    subst a
    rw [short_scale]
    change (2 : ℤ) • (Pi.single i s : Lattice (n + 1)) ∈ _ ∨ -((2 : ℤ) • (Pi.single i s : Lattice (n + 1))) ∈ _
    rcases hs with rfl | rfl
    · exact Or.inl (twice_axis_mem_chain_two n i)
    · right; simpa [Pi.single_neg, add_comm] using twice_axis_mem_chain_two n i
  · have he : a = longRoot true i j hij s t hs ht := Subtype.ext ha
    subst a
    rw [long_scale, one_smul]
    exact signed_pair_mem_chain n 2 (sum_mem_chain_two n) i j s t hs ht

@[simp] theorem functional_zero (n : ℕ) : functional (0 : Lattice n) = 0 := by
  ext x; simp [dot]

@[simp] theorem functional_add {n : ℕ} (x y : Lattice n) :
    functional (x + y) = functional x + functional y := by
  ext z; simp

@[simp] theorem functional_neg {n : ℕ} (x : Lattice n) :
    functional (-x) = -functional x := by
  ext z; simp [dot, Finset.sum_neg_distrib]

theorem functional_chain_mem (n : ℕ) (x : Lattice (n + 1)) (hx : x ∈ chainPositive n 2) :
    functional x ∈ AddSubmonoid.closure (Set.range (fun i => coroot (simpleB n i))) := by
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact AddSubmonoid.subset_closure ⟨i, simpleB_coroot_vector n i⟩
  | zero => simp
  | add x y hx hy ihx ihy => simpa using AddSubmonoid.add_mem _ ihx ihy

theorem coroot_eq_scaled_functional {n : ℕ} {b : Bool} (a : Root n b) :
    coroot a = functional (corootScale a • a.1) := by
  ext x; simp

theorem coroot_mem_chain_two (n : ℕ) (a : BRoot (n + 1)) :
    coroot a ∈ AddSubmonoid.closure (Set.range (fun i => coroot (simpleB n i))) ∨
      -coroot a ∈ AddSubmonoid.closure (Set.range (fun i => coroot (simpleB n i))) := by
  rw [coroot_eq_scaled_functional]
  rcases coroot_vector_mem_chain_two n a with h | h
  · exact Or.inl (functional_chain_mem n _ h)
  · right
    simpa only [functional_neg] using functional_chain_mem n _ h

noncomputable def simpleSupportB (n : ℕ) : Finset (BRoot (n + 1)) := Finset.univ.image (simpleB n)

theorem simpleSupportB_set (n : ℕ) :
    (simpleSupportB n : Set (BRoot (n + 1))) = Set.range (simpleB n) := by
  simp [simpleSupportB]

/-- An actual B base in the concrete integral pairing, with no supplied base hypothesis. -/
noncomputable def baseB (n : ℕ) : (pairingB (n + 1)).Base where
  support := simpleSupportB n
  linearIndepOn_root := by
    change LinearIndepOn ℤ (fun a : BRoot (n + 1) => a.1) (simpleSupportB n : Set (BRoot (n + 1)))
    rw [simpleSupportB_set]
    exact (linearIndepOn_range_iff (simpleB_injective n) (fun a : BRoot (n + 1) => a.1)).2 (simpleB_independent n)
  linearIndepOn_coroot := by
    change LinearIndepOn ℤ coroot (simpleSupportB n : Set (BRoot (n + 1)))
    rw [simpleSupportB_set]
    exact (linearIndepOn_range_iff (simpleB_injective n) coroot).2 (simpleB_coroot_independent n)
  root_mem_or_neg_mem a := by
    change a.1 ∈ AddSubmonoid.closure ((fun a : BRoot (n + 1) => a.1) '' (simpleSupportB n : Set (BRoot (n + 1)))) ∨
      -a.1 ∈ AddSubmonoid.closure ((fun a : BRoot (n + 1) => a.1) '' (simpleSupportB n : Set (BRoot (n + 1))))
    rw [simpleSupportB_set, ← Set.range_comp]
    simpa only [Function.comp_def, simpleB_vector, chainPositive] using root_mem_chain_one n a
  coroot_mem_or_neg_mem a := by
    change coroot a ∈ AddSubmonoid.closure (coroot '' (simpleSupportB n : Set (BRoot (n + 1)))) ∨
      -coroot a ∈ AddSubmonoid.closure (coroot '' (simpleSupportB n : Set (BRoot (n + 1))))
    rw [simpleSupportB_set, ← Set.range_comp]
    exact coroot_mem_chain_two n a

/-- The actual C base is the dual of the actual B base on the same root labels. -/
noncomputable def baseC (n : ℕ) : (pairingC (n + 1)).Base := (baseB n).flip

/-- The pinned C matrix is obtained by the actual dual pairing, not by relabeling B. -/
theorem simpleC_cartan (n : ℕ) (i j : Fin (n + 1)) :
    coroot (simpleB n i) (simpleB n j).1 = CartanMatrix.C (n + 1) i j := by
  rw [simpleB_cartan]
  exact congrFun (congrFun (CartanMatrix.B_transpose (n + 1)) i) j

noncomputable def baseBIndexEquiv (n : ℕ) : Fin (n + 1) ≃ (baseB n).support :=
  Equiv.ofBijective
    (fun i => ⟨simpleB n i, Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩⟩)
    ⟨by intro i j h; exact simpleB_injective n (congrArg Subtype.val h), by
      intro a
      obtain ⟨i, _, hi⟩ := Finset.mem_image.mp a.2
      exact ⟨i, Subtype.ext hi⟩⟩

noncomputable def baseCIndexEquiv (n : ℕ) : Fin (n + 1) ≃ (baseC n).support :=
  baseBIndexEquiv n

theorem baseB_cartan (n : ℕ) (i j : Fin (n + 1)) :
    (baseB n).cartanMatrix (baseBIndexEquiv n i) (baseBIndexEquiv n j) =
      CartanMatrix.B (n + 1) i j := by
  change (pairingB (n + 1)).pairingIn ℤ (simpleB n i) (simpleB n j) = _
  have hp := (pairingB (n + 1)).algebraMap_pairingIn ℤ (simpleB n i) (simpleB n j)
  change (pairingB (n + 1)).pairingIn ℤ (simpleB n i) (simpleB n j) =
    coroot (simpleB n j) (simpleB n i).1 at hp
  exact hp.trans (simpleB_cartan n i j)

theorem baseC_cartan (n : ℕ) (i j : Fin (n + 1)) :
    (baseC n).cartanMatrix (baseCIndexEquiv n i) (baseCIndexEquiv n j) =
      CartanMatrix.C (n + 1) i j := by
  change (pairingC (n + 1)).pairingIn ℤ (simpleB n i) (simpleB n j) = _
  have hp := (pairingC (n + 1)).algebraMap_pairingIn ℤ (simpleB n i) (simpleB n j)
  change (pairingC (n + 1)).pairingIn ℤ (simpleB n i) (simpleB n j) =
    coroot (simpleB n i) (simpleB n j).1 at hp
  exact hp.trans (simpleC_cartan n i j)

end Atlas.Chevalley.ClassicalData
