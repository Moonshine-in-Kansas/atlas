import Atlas.LinearGroups.Orthogonal.Minus.OrderBase
import Atlas.LinearGroups.Orthogonal.Minus.StandardComplement
import Atlas.LinearGroups.Orthogonal.Minus.PlaneReflections
import Atlas.LinearGroups.Orthogonal.ElementaryReflectionGeneration
import Atlas.LinearGroups.Orthogonal.SiegelReflections

/-! Full minus isometries generated by elementary maps and reflections,
and stable reflection generation without a split-space identification. -/
noncomputable section
namespace Atlas.Orthogonal.Minus
open Atlas.Quadratic
variable {F K : Type*} [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]

/-- Joint generation for every minus rank, through actual complements and the norm-plane base. -/
theorem elementary_sup_reflections_eq_top (hdeg : Module.finrank F K = 2) (n : ℕ) :
    elementaryReflectionSubgroup (form hdeg n) = ⊤ := by
  induction n with
  | zero =>
    apply top_unique
    intro g _
    let i := zeroRankIsometry hdeg
    have hplane : elementaryReflectionSubgroup (normForm hdeg) = ⊤ := by
      change elementarySubgroup (normForm hdeg) ⊔ reflectionSubgroup (normForm hdeg) = ⊤
      rw [plane_reflectionSubgroup_eq_top hdeg, sup_top_eq]
    have hg : isometryGroupTransport i g ∈ elementaryReflectionSubgroup (normForm hdeg) := by
      rw [hplane]
      trivial
    have hback := isometryTransport_mem_elementaryReflection i.symm _ hg
    have heq : isometryGroupTransport i.symm (isometryGroupTransport i g) = g := by
      apply Subtype.ext
      apply LinearEquiv.ext
      intro x
      change i.symm (i (g.val (i.symm (i x)))) = g.val x
      rw [i.symm_apply_apply,i.symm_apply_apply]
    rwa [heq] at hback
  | succ n ih =>
    apply top_unique
    intro g _
    let Q := form hdeg (n+1)
    have he : Q (Atlas.Orthogonal.e 0, 0) = 0 := by
      simp only [Q, form_apply, formD_e, ← normForm_apply hdeg, map_zero, add_zero]
    have hf : Q (Atlas.Orthogonal.f 0, 0) = 0 := by
      simp only [Q, form_apply, formD_f, ← normForm_apply hdeg, map_zero, add_zero]
    have hef : Q.polarBilin (Atlas.Orthogonal.e 0, 0) (Atlas.Orthogonal.f 0, 0) = 1 := by
      simp only [Q, polar_f0, Atlas.Orthogonal.e, Pi.single_eq_same]
    obtain ⟨a,ha,hae,haf⟩ := elementaryReflection_pair_transport Q (radical_eq_bot hdeg (n+1))
      (Atlas.Orthogonal.e 0, 0) (Atlas.Orthogonal.f 0, 0)
      (g.val (Atlas.Orthogonal.e 0, 0)) (g.val (Atlas.Orthogonal.f 0, 0))
      he hf ((g.prop _).trans he)
      ((g.prop _).trans hf) hef
      ((isometry_polar Q (isometryCarrierEquiv Q g) _ _).trans hef)
    let k := a⁻¹*g
    have hke : k.val (Atlas.Orthogonal.e 0, 0) = (Atlas.Orthogonal.e 0, 0) := by
      change a.val.symm (g.val (Atlas.Orthogonal.e 0, 0)) = (Atlas.Orthogonal.e 0, 0)
      rw [← hae,a.val.symm_apply_apply]
    have hkf : k.val (Atlas.Orthogonal.f 0, 0) = (Atlas.Orthogonal.f 0, 0) := by
      change a.val.symm (g.val (Atlas.Orthogonal.f 0, 0)) = (Atlas.Orthogonal.f 0, 0)
      rw [← haf,a.val.symm_apply_apply]
    let t : pairStabilizer Q (Atlas.Orthogonal.e 0, 0) (Atlas.Orthogonal.f 0, 0) := ⟨k,hke,hkf⟩
    let c := pairRestriction Q (Atlas.Orthogonal.e 0, 0) (Atlas.Orthogonal.f 0, 0) t
    let i := standardComplement (n := n) hdeg
    have hc : c ∈ elementaryReflectionSubgroup (complementForm Q
        (Atlas.Orthogonal.e 0, 0) (Atlas.Orthogonal.f 0, 0)) := by
      have hcn : isometryGroupTransport i c ∈ elementaryReflectionSubgroup (form hdeg n) := by
        rw [ih]
        trivial
      have hback := isometryTransport_mem_elementaryReflection i.symm _ hcn
      have heq : isometryGroupTransport i.symm (isometryGroupTransport i c) = c := by
        apply Subtype.ext
        apply LinearEquiv.ext
        intro x
        change i.symm (i (c.val (i.symm (i x)))) = c.val x
        rw [i.symm_apply_apply,i.symm_apply_apply]
      rwa [heq] at hback
    have hk := complementLift_mem_elementaryReflection Q (Atlas.Orthogonal.e 0, 0)
      (Atlas.Orthogonal.f 0, 0) he hf hef c hc
    have heq : complementLift Q (Atlas.Orthogonal.e 0, 0) (Atlas.Orthogonal.f 0, 0)
        he hf hef c = k :=
      congrArg Subtype.val ((pairStabilizerEquiv Q (Atlas.Orthogonal.e 0, 0)
        (Atlas.Orthogonal.f 0, 0) he hf hef).symm_apply_apply t)
    rw [heq] at hk
    have hg := (elementaryReflectionSubgroup Q).mul_mem ha hk
    change a*(a⁻¹*g) ∈ elementaryReflectionSubgroup Q at hg
    simpa only [mul_inv_cancel_left] using hg

/-- In dimension at least six, generic Siegel factorization turns the actual
joint generation theorem into full reflection generation. -/
theorem reflectionSubgroup_eq_top_of_two_le (hdeg : Module.finrank F K = 2)
    (k : ℕ) (hk : 2 ≤ k) : reflectionSubgroup (form hdeg k) = ⊤ := by
  have h := elementary_sup_reflections_eq_top hdeg k
  change elementarySubgroup (form hdeg k) ⊔ reflectionSubgroup (form hdeg k) = ⊤ at h
  have hle := elementary_le_reflections_stable (form hdeg k)
    (polar_nondegenerate hdeg k) (show 5 ≤ Module.finrank F (Vector k F K) by
      rw [vector_finrank hdeg]; omega)
  rwa [sup_eq_right.mpr hle] at h

theorem reflectionSubgroup_eq_top (hdeg : Module.finrank F K = 2) (n : ℕ) :
    reflectionSubgroup (form hdeg (n+2)) = ⊤ :=
  reflectionSubgroup_eq_top_of_two_le hdeg (n+2) (by omega)
end Atlas.Orthogonal.Minus

