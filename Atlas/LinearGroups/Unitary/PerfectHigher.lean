import Atlas.LinearGroups.Unitary.GenerationHigher
import Atlas.LinearGroups.Unitary.PerfectThree

/-! Uniform perfectness from actual embedded perfect SU₃ groups and the
normal closure of an isotropic transvection subgroup. -/
noncomputable section
namespace Atlas.Unitary
open Matrix Atlas.FiniteQuadratic
open scoped LinearAlgebra.Projectivization
variable {F K : Type*} [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]

/-- A genuine nonzero isotropic vector in each standard space of dimension ≥3. -/
theorem exists_nonzero_isotropic_add_three (hdeg : Module.finrank F K = 2) (k : ℕ) :
    ∃ v : Fin (3+k) → K, v ≠ 0 ∧ hermitian F K v v = 0 := by
  induction k with
  | zero =>
    obtain ⟨a,b,ha,hb⟩ := exists_witt_parameters hdeg
    refine ⟨![1,a,0], ?_, ?_⟩
    · intro h
      have := congrFun h 0
      simpa using this
    · simp [hermitian, Fin.sum_univ_succ, ha]
  | succ k ih =>
    obtain ⟨v,hv,hvv⟩ := ih
    refine ⟨Fin.cons 0 v, ?_, (hermitian_cons_zero v v).trans hvv⟩
    intro he
    apply hv
    ext i
    exact congrFun he i.succ

/-- The image of a perfect group consists of actual commutators in the ambient group. -/
private theorem image_mem_commutator {G H : Type*} [Group G] [Group H]
    [Group.IsPerfect G] (f : G →* H) (g : G) : f g ∈ commutator H := by
  have hm : f g ∈ (commutator G).map f :=
    ⟨g, Group.IsPerfect.mem_commutator, rfl⟩
  rw [map_commutator_eq] at hm
  exact (Subgroup.commutator_mono (le_top : f.range ≤ ⊤) (le_top : f.range ≤ ⊤)) hm

/-- Perfectness propagates through genuine codimension-one embeddings once the
upper group is generated by its isotropic transvections. -/
theorem special_succ_perfect_of_generated (hdeg : Module.finrank F K = 2) {n : ℕ}
    [Group.IsPerfect (SU F K n hdeg)]
    (v : Fin n → K) (hv : v ≠ 0) (hvv : hermitian F K v v = 0)
    (hgen : transvectionGenerated hdeg (n := n+1) = ⊤) :
    Group.IsPerfect (SU F K (n+1) hdeg) := by
  let w : Fin (n+1) → K := Fin.cons 0 v
  have hw : w ≠ 0 := by
    intro he
    apply hv
    ext i
    exact congrFun he i.succ
  have hww : hermitian F K w w = 0 := (hermitian_cons_zero v v).trans hvv
  let p := isotropicPoint w hw hww
  have hp : pointTransvections hdeg p = lineTransvections hdeg w hww := by
    apply lineTransvections_eq_of_projective_eq hdeg _ _ _ _ p.val.rep_nonzero hw
    exact Projectivization.mk_rep p.val
  have hle : pointTransvections hdeg p ≤ commutator (SU F K (n+1) hdeg) := by
    rw [hp]
    intro g hg
    obtain ⟨a,rfl⟩ := hg
    change transvection hdeg w a.toAdd.val hww
      ((trace_zero_iff hdeg _).mp a.toAdd.prop) ∈ _
    rw [show transvection hdeg w a.toAdd.val hww
      ((trace_zero_iff hdeg _).mp a.toAdd.prop) =
        extendSpecialHom hdeg (transvection hdeg v a.toAdd.val hvv
          ((trace_zero_iff hdeg _).mp a.toAdd.prop)) from
      (extendSpecialHom_transvection hdeg v hvv _ _).symm]
    exact image_mem_commutator _ _
  have hcl := Subgroup.normalClosure_le_normal hle
  rw [normalClosure_pointTransvections, hgen] at hcl
  exact ⟨top_unique hcl⟩

theorem special_add_three_perfect (hdeg : Module.finrank F K = 2)
    (hq : 2 < Nat.card F) (k : ℕ) : Group.IsPerfect (SU F K (3+k) hdeg) := by
  induction k with
  | zero => exact special_three_perfect hdeg hq
  | succ k ih =>
    letI := ih
    obtain ⟨v,hv,hvv⟩ := exists_nonzero_isotropic_add_three hdeg k
    exact special_succ_perfect_of_generated hdeg v hv hvv
      (transvectionGenerated_add_three_eq_top hdeg hq (k+1))

theorem special_perfect_of_three_le (hdeg : Module.finrank F K = 2)
    (hq : 2 < Nat.card F) {n : ℕ} (hn : 3 ≤ n) : Group.IsPerfect (SU F K n hdeg) := by
  obtain ⟨k,rfl⟩ := Nat.exists_eq_add_of_le hn
  exact special_add_three_perfect hdeg hq k

theorem projective_perfect_of_three_le (hdeg : Module.finrank F K = 2)
    (hq : 2 < Nat.card F) {n : ℕ} (hn : 3 ≤ n) : Group.IsPerfect (PSU F K n hdeg) := by
  letI := special_perfect_of_three_le hdeg hq hn
  infer_instance
end Atlas.Unitary
