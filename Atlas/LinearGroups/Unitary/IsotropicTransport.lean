import Atlas.LinearGroups.Unitary.IsotropicLineGroups
import Mathlib.LinearAlgebra.Dual.Lemmas

/-! # Explicit transvection transport on isotropic lines -/
noncomputable section
namespace Atlas.Unitary
open Matrix Atlas.FiniteQuadratic
open scoped LinearAlgebra.Projectivization
variable {F K : Type*} [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]
variable {n : ℕ}

/-- The subgroup generated by the actual line transvections; equality with SU
is a later theorem, not part of this definition. -/
def transvectionGenerated (hdeg : Module.finrank F K = 2) : Subgroup (SU F K n hdeg) :=
  ⨆ (v : Fin n → K) (hv : hermitian F K v v = 0), lineTransvections hdeg v hv

theorem transvection_mem_generated (hdeg : Module.finrank F K = 2)
    (v : Fin n → K) (hv : hermitian F K v v = 0) (a : K)
    (ha : a + conjugation F K a = 0) :
    transvection hdeg v a hv ha ∈ transvectionGenerated hdeg := by
  have hle : lineTransvections hdeg v hv ≤ transvectionGenerated hdeg :=
    le_iSup_of_le v (le_iSup_of_le hv le_rfl)
  apply hle
  exact ⟨Multiplicative.ofAdd ⟨a, (trace_zero_iff hdeg a).mpr ha⟩, rfl⟩

/-- One genuine transvection connects any two nonorthogonal isotropic lines. -/
theorem transvection_transport_nonorthogonal (hdeg : Module.finrank F K = 2)
    (v w : Fin n → K) (hv : hermitian F K v v = 0) (hw : hermitian F K w w = 0)
    (hp : hermitian F K v w ≠ 0) :
    ∃ g : transvectionGenerated hdeg (n := n), ∃ c : K, c ≠ 0 ∧ g.val.val *ᵥ v = c • w := by
  obtain ⟨t, ht, httrace⟩ := exists_nonzero_trace_zero (K := K) hdeg
  have hbt : conjugation F K t = -t := by
    change t + conjugation F K t = 0 at httrace
    linear_combination httrace
  let s := hermitian F K v w
  have hs : s ≠ 0 := hp
  have hbs : conjugation F K s ≠ 0 := (map_ne_zero _).mpr hs
  let c := t / conjugation F K s
  have hc : c ≠ 0 := div_ne_zero ht hbs
  have hcbar : conjugation F K c * s = -t := by
    dsimp [c]
    rw [map_div₀, hbt, conjugation_conjugation hdeg, div_mul_cancel₀ _ hs]
  have hcp : c * conjugation F K s = t := div_mul_cancel₀ _ hbs
  let d := v + c • w
  have hd : hermitian F K d d = 0 := by
    simp only [d, hermitian_add_left, hermitian_add_right, hermitian_smul_left,
      hermitian_smul_right, hv, hw, mul_zero, add_zero, zero_add]
    rw [← hermitian_symmetry hdeg v w]
    change c * conjugation F K s + conjugation F K c * s = 0
    rw [hcbar, hcp, add_neg_cancel]
  have hparam : t⁻¹ + conjugation F K t⁻¹ = 0 := by
    rw [map_inv₀, hbt, inv_neg, add_neg_cancel]
  refine ⟨⟨transvection hdeg d t⁻¹ hd hparam,
    transvection_mem_generated hdeg d hd _ hparam⟩, -c, neg_ne_zero.mpr hc, ?_⟩
  change transvectionMatrix (F := F) d t⁻¹ *ᵥ v = _
  rw [transvectionMatrix_apply]
  have hvd : hermitian F K v d = -t := by
    rw [hermitian_add_right, hermitian_smul_right, hv, zero_add]
    exact hcbar
  rw [hvd, mul_neg, inv_mul_cancel₀ ht]
  dsimp [d]
  module

/-- Every linear functional is represented by pairing against an actual vector. -/
theorem hermitian_represents_dual (hdeg : Module.finrank F K = 2)
    (f : (Fin n → K) →ₗ[K] K) : ∃ z : Fin n → K, ∀ v, hermitian F K v z = f v := by
  classical
  refine ⟨fun i => conjugation F K (f (Pi.single i 1)), ?_⟩
  intro v
  simp only [hermitian, conjugation_conjugation hdeg]
  have hv : v = ∑ i : Fin n, v i • Pi.single i 1 := by
    ext j
    simp [Pi.single_apply]
  conv_rhs => rw [hv, map_sum]
  simp only [map_smul, smul_eq_mul]

/-- An independent pair admits a common isotropic vector pairing to one with both,
provided the pair is isotropic and orthogonal. -/
theorem exists_isotropic_bridge (hdeg : Module.finrank F K = 2)
    (v w : Fin n → K) (hli : LinearIndependent K ![v, w])
    (hv : hermitian F K v v = 0) (hw : hermitian F K w w = 0)
    (hvw : hermitian F K v w = 0) :
    ∃ z : Fin n → K, hermitian F K z z = 0 ∧
      hermitian F K v z = 1 ∧ hermitian F K w z = 1 := by
  obtain ⟨f, hf⟩ := Module.exists_dual_forall_apply_eq_one (hli.linearIndepOn Set.univ)
  obtain ⟨z, hz⟩ := hermitian_represents_dual hdeg f
  have hvz : hermitian F K v z = 1 := by
    rw [hz]
    simpa using hf 0 (Set.mem_univ _)
  have hwz : hermitian F K w z = 1 := by
    rw [hz]
    simpa using hf 1 (Set.mem_univ _)
  obtain ⟨b, hb⟩ := hermitian_self_in_base hdeg z
  obtain ⟨a, ha⟩ := trace_surjective F K (-b)
  have htrace : a + conjugation F K a = -hermitian F K z z := by
    rw [← trace_formula hdeg, ha, map_neg, hb]
  refine ⟨z + a • v, ?_, ?_, ?_⟩
  · simp only [hermitian_add_left, hermitian_add_right,
      hermitian_smul_left, hermitian_smul_right, hv, hvz, mul_zero, add_zero]
    have hzv : hermitian F K z v = 1 := by
      rw [← hermitian_symmetry hdeg v z, hvz, map_one]
    rw [hzv]
    linear_combination htrace
  · rw [hermitian_add_right, hermitian_smul_right, hv, mul_zero, add_zero, hvz]
  · have hwv : hermitian F K w v = 0 := by
      rw [← hermitian_symmetry hdeg v w, hvw, map_zero]
    rw [hermitian_add_right, hermitian_smul_right, hwv, mul_zero, add_zero, hwz]

/-- Nonorthogonal isotropic points are connected by a genuine generator. -/
theorem generated_transport_nonorthogonal (hdeg : Module.finrank F K = 2)
    (p q : IsotropicPoints F K n) (hpq : hermitian F K p.val.rep q.val.rep ≠ 0) :
    ∃ g : transvectionGenerated hdeg (n := n), g • p = q := by
  obtain ⟨g, c, hc, he⟩ := transvection_transport_nonorthogonal hdeg
    p.val.rep q.val.rep (isotropic_rep p) (isotropic_rep q) hpq
  refine ⟨g, Subtype.ext ?_⟩
  change g.val • p.val = q.val
  rw [← Projectivization.mk_rep p.val, ← Projectivization.mk_rep q.val,
    Projectivization.smul_mk, Projectivization.mk_eq_mk_iff']
  exact ⟨c, he.symm⟩

/-- The transvection-generated subgroup is transitive on isotropic points,
including the exceptional SU3(2); this does not assert it equals the whole SU. -/
instance generated_isotropic_pretransitive (hdeg : Module.finrank F K = 2) :
    MulAction.IsPretransitive (transvectionGenerated hdeg (n := n)) (IsotropicPoints F K n) where
  exists_smul_eq p q := by
    by_cases hpq : p = q
    · exact ⟨1, by simpa using hpq⟩
    by_cases ho : hermitian F K p.val.rep q.val.rep = 0
    · have hne : p.val ≠ q.val := fun h => hpq (Subtype.ext h)
      have hli := Projectivization.linearIndependent_pair_iff_ne.mpr hne
      obtain ⟨z, hzz, hpz, hqz⟩ := exists_isotropic_bridge hdeg p.val.rep q.val.rep hli
        (isotropic_rep p) (isotropic_rep q) ho
      have hz : z ≠ 0 := by
        intro he
        simp [he] at hpz
      let r := isotropicPoint z hz hzz
      have hpr : hermitian F K p.val.rep r.val.rep ≠ 0 := by
        obtain ⟨a, ha⟩ := Projectivization.exists_smul_eq_mk_rep K z hz
        change hermitian F K p.val.rep (Projectivization.mk K z hz).rep ≠ 0
        rw [← ha]
        simp [Units.smul_def, hermitian_smul_right, hpz]
      have hrq : hermitian F K r.val.rep q.val.rep ≠ 0 := by
        obtain ⟨a, ha⟩ := Projectivization.exists_smul_eq_mk_rep K z hz
        change hermitian F K (Projectivization.mk K z hz).rep q.val.rep ≠ 0
        rw [← ha]
        have hzq : hermitian F K z q.val.rep = 1 := by
          rw [← hermitian_symmetry hdeg q.val.rep z, hqz, map_one]
        simp [Units.smul_def, hermitian_smul_left, hzq]
      obtain ⟨g, hg⟩ := generated_transport_nonorthogonal hdeg p r hpr
      obtain ⟨k, hk⟩ := generated_transport_nonorthogonal hdeg r q hrq
      exact ⟨k * g, by rw [mul_smul, hg, hk]⟩
    · exact generated_transport_nonorthogonal hdeg p q ho

instance special_isotropic_pretransitive (hdeg : Module.finrank F K = 2) :
    MulAction.IsPretransitive (SU F K n hdeg) (IsotropicPoints F K n) where
  exists_smul_eq p q := by
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (transvectionGenerated hdeg (n := n)) p q
    exact ⟨g.val, hg⟩

theorem projective_isotropic_pretransitive (hdeg : Module.finrank F K = 2) (hn : 0 < n) :
    letI := isotropicAction hdeg hn
    MulAction.IsPretransitive (PSU F K n hdeg) (IsotropicPoints F K n) := by
  letI := isotropicAction hdeg hn
  constructor
  intro p q
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (SU F K n hdeg) p q
  exact ⟨projection F K n hdeg g, hg⟩
end Atlas.Unitary
