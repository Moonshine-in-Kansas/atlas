import Atlas.LinearGroups.Unitary.RankOne
import Atlas.LinearGroups.Unitary.GeneratedNormal

/-! All-field rank-one transvection generation through the actual SL₂ map.
This includes the nonsimple binary and ternary cases. -/
noncomputable section
namespace Atlas.Unitary
open Matrix Atlas.FiniteQuadratic
open scoped MatrixGroups
variable {F K : Type*} [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]

/-- Each elementary SL₂ matrix becomes a genuine unitary line transvection. -/
theorem rankOneHom_transvection_mem_generated (hdeg : Module.finrank F K = 2)
    (a b t : K) (ha : a * conjugation F K a = -1)
    (hb : b + conjugation F K b = 1) (ht : t ≠ 0)
    (htrace : t + conjugation F K t = 0)
    (i j : Fin 2) (hij : i ≠ j) (s : F) :
    rankOneHom hdeg a b t ha hb ht htrace (SpecialLinearGroup.transvection hij s) ∈
      transvectionGenerated hdeg := by
  classical
  let P := wittPlaneMatrix a b
  let R := rankOneTwist t ((SpecialLinearGroup.transvection hij s).val.map (algebraMap F K))
  let z := (if i=0 then t else t⁻¹) * algebraMap F K s
  have hbar : conjugation F K t = -t := by linear_combination htrace
  have hz : z + conjugation F K z = 0 := by
    dsimp [z]
    split_ifs <;> simp [map_mul, map_inv₀, hbar] <;> ring
  let v : Fin 2 → K := P *ᵥ Pi.single i 1
  have hv : hermitian F K v v = 0 := by
    rw [wittPlaneMatrix_preserves a b ha hb]
    fin_cases i <;> simp [hyperbolicPlaneForm, Pi.single_apply]
  have hR (x : Fin 2 → K) : R *ᵥ x = x + (z*x j) • Pi.single i 1 := by
    fin_cases i <;> fin_cases j <;> try contradiction
    all_goals
      ext k
      fin_cases k <;> simp [R, z, rankOneTwist, SpecialLinearGroup.transvection_coe,
        Matrix.single, Matrix.one_apply, mulVec, dotProduct, Fin.sum_univ_succ,
        Pi.single_apply, Matrix.map_apply, add_comm]
  let T := transvection hdeg v z hv hz
  have hTP : T.val * P = P * R := by
    apply Matrix.ext_of_mulVec_single
    intro k
    rw [← mulVec_mulVec, ← mulVec_mulVec, hR]
    change transvectionMatrix (F := F) v z *ᵥ (P *ᵥ Pi.single k 1) = _
    rw [transvectionMatrix_apply]
    have hp : hermitian F K (P *ᵥ Pi.single k 1) v = (Pi.single k 1 : Fin 2 → K) j := by
      rw [wittPlaneMatrix_preserves a b ha hb]
      fin_cases i <;> fin_cases j <;> try contradiction
      all_goals simp [hyperbolicPlaneForm, Pi.single_apply]
    rw [hp, mulVec_add, mulVec_smul]
  have hP : IsUnit P.det := by
    rw [wittPlaneMatrix_det]
    apply isUnit_iff_ne_zero.mpr
    intro h
    have ha0 : a=0 := neg_eq_zero.mp h
    simp [ha0] at ha
  have he : rankOneHom hdeg a b t ha hb ht htrace
      (SpecialLinearGroup.transvection hij s) = T := by
    apply Subtype.ext
    change P*R*P⁻¹ = T.val
    rw [← hTP, mul_assoc, mul_nonsing_inv P hP, mul_one]
  rw [he]
  exact transvection_mem_generated hdeg v hv z hz

/-- Actual SU₂ is generated by unitary transvections over every finite base field,
without a simplicity or perfectness hypothesis. -/
theorem transvectionGenerated_two_eq_top (hdeg : Module.finrank F K = 2) :
    transvectionGenerated hdeg (n := 2) = ⊤ := by
  obtain ⟨a,b,ha,hb⟩ := exists_witt_parameters hdeg
  obtain ⟨t,ht,htrace⟩ := exists_nonzero_trace_zero hdeg
  let f := rankOneHom hdeg a b t ha hb ht htrace
  apply top_unique
  intro g _
  obtain ⟨x,rfl⟩ := (rankOneHom_bijective hdeg a b t ha hb ht htrace).surjective g
  apply Matrix.SL2.transvection_induction
    (fun x => f x ∈ transvectionGenerated hdeg)
  · intro i j hij s
    exact rankOneHom_transvection_mem_generated hdeg a b t ha hb ht htrace i j hij s
  · intro x y hx hy
    rw [map_mul]
    exact (transvectionGenerated hdeg).mul_mem hx hy
end Atlas.Unitary
