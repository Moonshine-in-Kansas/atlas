import Atlas.LinearGroups.Unitary.ThreeGeneratedRoots
import Atlas.LinearGroups.Unitary.ThreeMatrixModel
import Atlas.LinearGroups.Unitary.ThreeStabilizer

/-! Actual SU₃ is generated by its line transvections for q>2.
The proof uses the actual normal generated subgroup, full root and torus inclusion,
the full isotropic-line stabilizer, and the already proved transitive line action. -/
noncomputable section
namespace Atlas.Unitary
open Matrix Atlas.FiniteQuadratic
open scoped LinearAlgebra.Projectivization
variable {F K : Type*} [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]

theorem threeWittHom_injective (hdeg : Module.finrank F K = 2) (a b : K)
    (ha : a * conjugation F K a = -1) : Function.Injective (threeWittHom hdeg a b ha) := by
  intro g h he
  have hP := wittThreeMatrix_det_unit a b ha
  have he' := congrArg (fun M => wittThreeMatrix a b * M * (wittThreeMatrix a b)⁻¹) he
  change wittThreeMatrix a b * ((wittThreeMatrix a b)⁻¹ * g.val * wittThreeMatrix a b) *
    (wittThreeMatrix a b)⁻¹ = wittThreeMatrix a b *
    ((wittThreeMatrix a b)⁻¹ * h.val * wittThreeMatrix a b) * (wittThreeMatrix a b)⁻¹ at he'
  simp only [mul_assoc, ← mul_assoc (wittThreeMatrix a b) (wittThreeMatrix a b)⁻¹,
    mul_nonsing_inv _ hP, one_mul, mul_one] at he'
  exact Subtype.ext he'

/-- Membership of the conjugated matrix is membership of the actual SU₃ element. -/
theorem threeGeneratedMatrices_mem_iff (hdeg : Module.finrank F K = 2) (a b : K)
    (ha : a * conjugation F K a = -1) (g : SU F K 3 hdeg) :
    threeWittHom hdeg a b ha g ∈ threeGeneratedMatrices hdeg a b ha ↔
      g ∈ transvectionGenerated hdeg := by
  constructor
  · rintro ⟨k, hk, hkg⟩
    exact threeWittHom_injective hdeg a b ha hkg ▸ hk
  · intro hg
    exact ⟨g, hg, rfl⟩

/-- The entire first isotropic-line stabilizer lies in the actual generated subgroup. -/
theorem three_line_stabilizer_generated (hdeg : Module.finrank F K = 2)
    (hq : 2 < Nat.card F) (a b : K)
    (ha : a * conjugation F K a = -1) (hb : b + conjugation F K b = 1)
    (g : SU F K 3 hdeg) (t : K) (ht : t ≠ 0)
    (hg : g.val *ᵥ (wittThreeMatrix a b *ᵥ Pi.single 0 1) =
      t • (wittThreeMatrix a b *ᵥ Pi.single 0 1)) :
    g ∈ transvectionGenerated hdeg := by
  let M := threeWittHom hdeg a b ha g
  have hcol : M *ᵥ Pi.single 0 1 = t • Pi.single 0 1 := by
    change ((wittThreeMatrix a b)⁻¹ * g.val * wittThreeMatrix a b) *ᵥ Pi.single 0 1 = _
    rw [← mulVec_mulVec, ← mulVec_mulVec, hg, mulVec_smul, mulVec_mulVec,
      nonsing_inv_mul _ (wittThreeMatrix_det_unit a b ha), one_mulVec]
  obtain ⟨c,d,hcd,he⟩ := three_line_stabilizer_factor hdeg M
    (three_witt_conjugate_det hdeg a b ha g)
    (three_witt_conjugate_preserves hdeg a b ha hb g) t ht hcol
  apply (threeGeneratedMatrices_mem_iff hdeg a b ha g).mp
  change M ∈ _
  rw [he]
  exact (threeGeneratedMatrices hdeg a b ha).mul_mem
    (rootThree_mem_generatedMatrices hdeg hq a b ha hb c d hcd)
    (fullTorus_mem_generatedMatrices hdeg hq a b ha hb t ht)

/-- Generation for the actual special unitary group in dimension three.
No assertion is made for q=2, where unrestricted transvection generation is false. -/
theorem transvectionGenerated_three_eq_top (hdeg : Module.finrank F K = 2)
    (hq : 2 < Nat.card F) : transvectionGenerated hdeg (n := 3) = ⊤ := by
  obtain ⟨a,b,ha,hb⟩ := exists_witt_parameters hdeg
  let P := wittThreeMatrix a b
  let v : Fin 3 → K := P *ᵥ Pi.single 0 1
  have hv : v ≠ 0 := by
    intro hv
    have he := congrArg (fun w => P⁻¹ *ᵥ w) hv
    change P⁻¹ *ᵥ (P *ᵥ Pi.single 0 1) = P⁻¹ *ᵥ 0 at he
    rw [mulVec_mulVec, nonsing_inv_mul _ (wittThreeMatrix_det_unit a b ha),
      one_mulVec, mulVec_zero] at he
    have hi := congrFun he 0
    simp at hi
  have hvv : hermitian F K v v = 0 := by
    rw [wittThreeMatrix_preserves a b ha hb]
    simp [hyperbolicThreeForm]
  let p := isotropicPoint v hv hvv
  have hstab : ∀ g : SU F K 3 hdeg, g • p = p → g ∈ transvectionGenerated hdeg := by
    intro g hg
    have hp := congrArg Subtype.val hg
    change g • Projectivization.mk K v hv = Projectivization.mk K v hv at hp
    rw [Projectivization.smul_mk, Projectivization.mk_eq_mk_iff] at hp
    obtain ⟨t, ht⟩ := hp
    exact three_line_stabilizer_generated hdeg hq a b ha hb g (t : K) t.ne_zero ht.symm
  apply top_unique
  intro g _
  obtain ⟨k,hk⟩ := MulAction.exists_smul_eq (transvectionGenerated hdeg (n := 3)) p (g • p)
  have hgk : k.val⁻¹ * g ∈ transvectionGenerated hdeg := by
    apply hstab
    rw [mul_smul, ← hk]
    change k.val⁻¹ • (k.val • p) = p
    simp
  have h := (transvectionGenerated hdeg).mul_mem k.property hgk
  simpa using h
end Atlas.Unitary
