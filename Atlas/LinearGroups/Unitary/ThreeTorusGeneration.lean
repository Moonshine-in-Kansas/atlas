import Atlas.LinearGroups.Unitary.ThreeLongWeyl

/-! An actual matrix-submonoid containing the root group and a long-root Weyl
element contains the entire K-unit torus. This is a structural generation lemma,
not a definition of the full special unitary group. -/
noncomputable section
namespace Atlas.Unitary
open Matrix Atlas.FiniteQuadratic
variable {F K : Type*} [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]

/-- Every prescribed second root coordinate admits a compatible first coordinate. -/
theorem exists_rootThree_first_parameter (hdeg : Module.finrank F K = 2) (b : K) :
    ∃ a : K, rootThreeCondition (F := F) a b := by
  obtain ⟨a, ha⟩ := norm_surjective F K (-trace F K b)
  have h := congrArg (algebraMap F K) ha
  rw [norm_formula hdeg, map_neg, trace_formula hdeg] at h
  refine ⟨a, ?_⟩
  dsimp [rootThreeCondition]
  linear_combination h

private theorem rootThreeMatrix_inverse_left (a b : K) :
    rootThreeMatrix (F := F) (-a) (-b-a*conjugation F K a) *
      rootThreeMatrix (F := F) a b = 1 := by
  rw [rootThreeMatrix_mul]
  simp only [map_neg]
  convert rootThreeMatrix_zero (F := F) (K := K) using 2 <;> ring

/-- The full torus is generated by actual admissible roots and the long-root Weyl
matrix; there is no small-field restriction in this implication. -/
theorem fullTorus_mem_of_root_longWeyl (hdeg : Module.finrank F K = 2)
    (H : Submonoid (Matrix (Fin 3) (Fin 3) K))
    (hU : ∀ a b, rootThreeCondition (F := F) a b → rootThreeMatrix (F := F) a b ∈ H)
    (z : K) (hz : z ≠ 0) (htrace : z + conjugation F K z = 0)
    (hS : longWeylThreeMatrix z ∈ H) (hSi : longWeylThreeMatrix (-z) ∈ H)
    (t : K) (ht : t ≠ 0) : fullTorusThreeMatrix (F := F) t ∈ H := by
  let b := z / conjugation F K t
  have hbt : conjugation F K t ≠ 0 := (map_ne_zero _).mpr ht
  have hb : b ≠ 0 := div_ne_zero hz hbt
  have hparameter : conjugation F K z / conjugation F K b = t := by
    have hzb : conjugation F K z ≠ 0 := (map_ne_zero _).mpr hz
    dsimp [b]
    rw [map_div₀, conjugation_conjugation hdeg]
    field_simp
  obtain ⟨a, hab⟩ := exists_rootThree_first_parameter hdeg b
  let c := -z*a/b
  let d := -z^2/b
  let e := -z*a/conjugation F K b
  have hcd : rootThreeCondition (F := F) c d :=
    rootThreeCondition_longWeyl_left hdeg z htrace a b hab hb
  have hed : rootThreeCondition (F := F) e d :=
    rootThreeCondition_longWeyl_right hdeg z htrace a b hab hb
  let L := rootThreeMatrix (F := F) c d
  let Li := rootThreeMatrix (F := F) (-c) (-d-c*conjugation F K c)
  let R := rootThreeMatrix (F := F) e d
  let Ri := rootThreeMatrix (F := F) (-e) (-d-e*conjugation F K e)
  have hLi : Li * L = 1 := rootThreeMatrix_inverse_left c d
  have hRi : R * Ri = 1 := rootThreeMatrix_inverse e d
  have hword := longWeyl_three_bruhat hdeg z hz htrace a b hab hb
  rw [hparameter] at hword
  have hLi_mem : Li ∈ H := hU _ _ (rootThreeCondition_inverse hdeg c d hcd)
  have hRi_mem : Ri ∈ H := hU _ _ (rootThreeCondition_inverse hdeg e d hed)
  have hword_mem := H.mul_mem (H.mul_mem (H.mul_mem hLi_mem
    (H.mul_mem (H.mul_mem hS (hU a b hab)) hSi)) hRi_mem) hSi
  convert hword_mem using 1
  rw [hword]
  change fullTorusThreeMatrix (F := F) t =
    Li * (L * fullTorusThreeMatrix (F := F) t * longWeylThreeMatrix z * R) * Ri *
      longWeylThreeMatrix (-z)
  simp only [mul_assoc, ← mul_assoc Li L, hLi, one_mul,
    hRi,
    longWeylThreeMatrix_inverse z hz, mul_one]
end Atlas.Unitary
