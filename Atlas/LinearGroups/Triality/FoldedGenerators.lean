import Atlas.FieldTheory.FiniteCubicExtension
import Atlas.LinearGroups.Triality.AbsoluteRoots

/-! The four literal folded root families and their generated subgroup. -/
noncomputable section
namespace Atlas.Triality
open Atlas.Orthogonal
variable (F K : Type*) [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]

/-- The short root combines the three outer nodes in the fixed pinning. -/
def shortRoot (a : K) : O_DPlus 4 K :=
  pinnedRoot 0 a * pinnedRoot 2 (FiniteCubic.sigma F K a) *
    pinnedRoot 3 (FiniteCubic.sigma F K (FiniteCubic.sigma F K a))

def shortNegativeRoot (a : K) : O_DPlus 4 K :=
  pinnedNegativeRoot 0 a * pinnedNegativeRoot 2 (FiniteCubic.sigma F K a) *
    pinnedNegativeRoot 3 (FiniteCubic.sigma F K (FiniteCubic.sigma F K a))

def longRoot (b : F) : O_DPlus 4 K := pinnedRoot 1 (algebraMap F K b)
def longNegativeRoot (b : F) : O_DPlus 4 K := pinnedNegativeRoot 1 (algebraMap F K b)

/-- Literal generators; no fixed-point exhaustion or abstract group is assumed. -/
def generators : Set (O_DPlus 4 K) :=
  Set.range (shortRoot F K) ∪ Set.range (shortNegativeRoot F K) ∪
    Set.range (longRoot F K) ∪ Set.range (longNegativeRoot F K)

def generated : Subgroup (O_DPlus 4 K) := Subgroup.closure (generators F K)

/-- The matrix model is the actual subgroup generated by the four folded families.
The cubic-degree hypothesis is imposed on its triality theorems. -/
abbrev Group := ↥(generated F K)

theorem shortRoot_elementary (a : K) :
    shortRoot F K a ∈ elementarySubgroup (formD 4 K) :=
  Subgroup.mul_mem _ (Subgroup.mul_mem _ (pinnedRoot_mem _ _) (pinnedRoot_mem _ _))
    (pinnedRoot_mem _ _)

theorem shortNegativeRoot_elementary (a : K) :
    shortNegativeRoot F K a ∈ elementarySubgroup (formD 4 K) :=
  Subgroup.mul_mem _ (Subgroup.mul_mem _ (pinnedNegativeRoot_mem _ _) (pinnedNegativeRoot_mem _ _))
    (pinnedNegativeRoot_mem _ _)

theorem generated_le_elementary : generated F K ≤ elementarySubgroup (formD 4 K) := by
  apply (Subgroup.closure_le _).mpr
  rintro g (((⟨a,rfl⟩ | ⟨a,rfl⟩) | ⟨b,rfl⟩) | ⟨b,rfl⟩)
  · exact shortRoot_elementary F K a
  · exact shortNegativeRoot_elementary F K a
  · exact pinnedRoot_mem 1 _
  · exact pinnedNegativeRoot_mem 1 _

/-- The actual faithful inclusion into the previously constructed elementary D4 group. -/
def intoElementary : Group F K →* elementarySubgroup (formD 4 K) :=
  Subgroup.inclusion (generated_le_elementary F K)

theorem intoElementary_injective : Function.Injective (intoElementary F K) :=
  Subgroup.inclusion_injective _

instance finite_group : Finite (Group F K) := inferInstance

end Atlas.Triality
