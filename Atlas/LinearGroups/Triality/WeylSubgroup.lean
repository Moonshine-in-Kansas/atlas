import Atlas.LinearGroups.Triality.WeylMultiplication

/-! Unique torus coordinates for the subgroup generated by H and the two
Weyl representatives. No claim about the full normalizer is made here. -/
noncomputable section
namespace Atlas.Triality
open Atlas.Orthogonal
variable (F K : Type*) [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]

theorem weylWord_torus_form (l : List Bool) : ∃ w : Fin 12, ∃ h : Kˣ × Fˣ,
    (l.map fun (s : Bool) => if s then shortWeyl F K else longWeyl F K).prod =
      weylLift F K w * torusMap F K h := by
  induction l with
  | nil => exact ⟨0,1,by simp [weylLift,weylWord]⟩
  | cons s l ih =>
    obtain ⟨w,h,hh⟩ := ih
    refine ⟨weylLeftIndex s w, weylLeftTorus F K s w * h, ?_⟩
    rw [List.map_cons, List.prod_cons, hh, ← mul_assoc, weylLeft_mul, map_mul]
    group

theorem weylLift_mul_form (w v : Fin 12) : ∃ r : Fin 12, ∃ h : Kˣ × Fˣ,
    weylLift F K w * weylLift F K v = weylLift F K r * torusMap F K h := by
  simpa only [List.map_append,List.prod_append,weylLift] using
    weylWord_torus_form F K (weylWord w ++ weylWord v)

def weylTorusWord (p : Fin 12 × (Kˣ × Fˣ)) : O_DPlus 4 K :=
  weylLift F K p.1 * torusMap F K p.2

theorem weylTorusWord_injective : Function.Injective (weylTorusWord F K) := by
  rintro ⟨w,h⟩ ⟨v,k⟩ he
  have hw := weylLift_torus_disjoint F K w v h k he
  subst v
  have hk := torusMap_injective F K (mul_left_cancel he)
  exact Prod.ext rfl hk

def weylMonoid (hdeg : Module.finrank F K = 3) : Submonoid (O_DPlus 4 K) where
  carrier := Set.range (weylTorusWord F K)
  one_mem' := ⟨(0,1),by simp [weylTorusWord,weylLift,weylWord]⟩
  mul_mem' := by
    rintro _ _ ⟨⟨w,h⟩,rfl⟩ ⟨⟨v,k⟩,rfl⟩
    have hn := (Subgroup.normalizer (torus F K : Set (O_DPlus 4 K))).inv_mem
      (weylLift_normalizes_torus F K hdeg v)
    have hm := ((Subgroup.mem_normalizer_iff.mp hn) (torusMap F K h)).mp ⟨h,rfl⟩
    obtain ⟨t,ht⟩ := hm
    simp only [inv_inv] at ht
    obtain ⟨r,j,hj⟩ := weylLift_mul_form F K w v
    refine ⟨(r,j*t*k), ?_⟩
    dsimp [weylTorusWord]
    symm
    calc
      _ = (weylLift F K w * weylLift F K v) *
          ((weylLift F K v)⁻¹ * torusMap F K h * weylLift F K v) * torusMap F K k := by group
      _ = _ := by rw [← ht,hj]; simp only [map_mul]; group

private theorem weylMonoid_inv_mem (hdeg : Module.finrank F K = 3) (g : O_DPlus 4 K)
    (hg : g ∈ weylMonoid F K hdeg) : g⁻¹ ∈ weylMonoid F K hdeg := by
  let S := weylMonoid F K hdeg
  let f : S → S := fun x => ⟨g*x.val, S.mul_mem hg x.property⟩
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    exact mul_left_cancel (congrArg Subtype.val h)
  obtain ⟨x,hx⟩ := (Finite.surjective_of_injective hf) (1 : S)
  have he : g*x.val=1 := congrArg Subtype.val hx
  have hi : x.val=g⁻¹ := by
    calc
      x.val = g⁻¹*(g*x.val) := by group
      _ = g⁻¹ := by rw [he,mul_one]
  exact hi ▸ x.property

def weylSubgroup (hdeg : Module.finrank F K = 3) : Subgroup (O_DPlus 4 K) where
  __ := weylMonoid F K hdeg
  inv_mem' := weylMonoid_inv_mem F K hdeg _

def weylCoordinates (hdeg : Module.finrank F K = 3) :
    (Fin 12 × (Kˣ × Fˣ)) ≃ weylSubgroup F K hdeg :=
  Equiv.ofBijective (fun p => ⟨weylTorusWord F K p,⟨p,rfl⟩⟩) ⟨
    fun _ _ h => weylTorusWord_injective F K (congrArg Subtype.val h),
    by rintro ⟨g,p,hp⟩; exact ⟨p,Subtype.ext hp⟩⟩

theorem card_weylSubgroup (hdeg : Module.finrank F K = 3) :
    Nat.card (weylSubgroup F K hdeg) = 12*(Nat.card F^3-1)*(Nat.card F-1) := by
  rw [← Nat.card_congr (weylCoordinates F K hdeg)]
  simp only [Nat.card_prod, Nat.card_fin, Nat.card_units, FiniteCubic.card_extension hdeg]
  ring

theorem torus_le_weylSubgroup (hdeg : Module.finrank F K = 3) :
    torus F K ≤ weylSubgroup F K hdeg := by
  rintro _ ⟨h,rfl⟩
  exact ⟨(0,h),by simp [weylTorusWord,weylLift,weylWord]⟩

theorem weylSubgroup_eq_sup (hdeg : Module.finrank F K = 3) :
    weylSubgroup F K hdeg = torus F K ⊔ Subgroup.closure {shortWeyl F K,longWeyl F K} := by
  apply le_antisymm
  · rintro _ ⟨⟨w,h⟩,rfl⟩
    apply Subgroup.mul_mem
    · apply Subgroup.list_prod_mem
      intro g hg
      obtain ⟨s,hs,rfl⟩ := List.mem_map.mp hg
      apply (le_sup_right : Subgroup.closure {shortWeyl F K,longWeyl F K} ≤ _)
      apply Subgroup.subset_closure
      cases s <;> simp
    · exact (le_sup_left : torus F K ≤ _) ⟨h,rfl⟩
  · apply sup_le (torus_le_weylSubgroup F K hdeg)
    apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases Set.mem_insert_iff.mp hg with rfl | hg
    · exact ⟨(1,1),by simp [weylTorusWord,weylLift,weylWord]⟩
    · rcases Set.mem_singleton_iff.mp hg with rfl
      exact ⟨(2,1),by simp [weylTorusWord,weylLift,weylWord]⟩

theorem weylSubgroup_le_generated (hdeg : Module.finrank F K = 3) :
    weylSubgroup F K hdeg ≤ generated F K := by
  rintro _ ⟨⟨w,h⟩,rfl⟩
  exact Subgroup.mul_mem _ (weylLift_mem F K w) (torus_le_generated F K ⟨h,rfl⟩)

theorem weylSubgroup_normalizes_torus (hdeg : Module.finrank F K = 3) :
    weylSubgroup F K hdeg ≤ Subgroup.normalizer (torus F K : Set (O_DPlus 4 K)) := by
  rintro _ ⟨⟨w,h⟩,rfl⟩
  exact Subgroup.mul_mem _ (weylLift_normalizes_torus F K hdeg w)
    ((torus F K).le_normalizer ⟨h,rfl⟩)

instance torus_normal_in_weylSubgroup (hdeg : Module.finrank F K = 3) :
    ((torus F K).subgroupOf (weylSubgroup F K hdeg)).Normal := by
  constructor
  intro x hx g
  exact (Subgroup.mem_normalizer_iff.mp (weylSubgroup_normalizes_torus F K hdeg g.property) x.val).mp hx

theorem card_weylQuotient (hdeg : Module.finrank F K = 3) :
    Nat.card (weylSubgroup F K hdeg ⧸ (torus F K).subgroupOf (weylSubgroup F K hdeg)) = 12 := by
  have hh := ((torus F K).subgroupOf (weylSubgroup F K hdeg)).index_mul_card
  change Nat.card (weylSubgroup F K hdeg ⧸ (torus F K).subgroupOf (weylSubgroup F K hdeg)) * _ = _ at hh
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe (torus_le_weylSubgroup F K hdeg)).toEquiv,
    card_weylSubgroup F K hdeg] at hh
  apply Nat.eq_of_mul_eq_mul_right (show 0 < Nat.card (torus F K) from Nat.card_pos)
  rw [hh,card_torus F K hdeg]
  ring

end Atlas.Triality

