import Atlas.LinearGroups.F4.LeviGeneratedImage
import Atlas.LinearGroups.F4.PairSpecialImageContainment
import Atlas.LinearGroups.F4.PairScalarKernel
import Atlas.LinearGroups.F4.RootPointTransitivity

/-! Full generation of the intrinsic Albert stabilizer, through structural
Levi lifts and point transitivity. No F₄ order theorem is used. -/
noncomputable section
namespace Atlas.F4
variable {F : Type*} [Field F] [Finite F]

theorem parabolicKernel_mem_rootGenerated (g : parabolicPointStabilizer (F:=F))
    (hg : parabolicOrthogonalHom g=1) : g.val∈rootGenerated := by
  obtain ⟨p,l,he⟩ := parabolic_factorization g
  have hl : pairOrthogonalHom l=1 := by
    rw [he,map_mul,radicalParabolic_orthogonal,one_mul] at hg
    exact hg
  obtain ⟨a,ha⟩ := pairKernel_eq_scalarTorus l.val (parabolicLineCharacter l.val)
    (pairStabilizer_positive_scale l) (pairStabilizer_opposite_scale l) hl
  rw [he]
  change radicalElement p*l.val.val∈rootGenerated
  rw [ha]
  exact (rootGenerated (F:=F)).mul_mem
    (radicalSubgroup_le_rootGenerated ⟨p,rfl⟩) (diagonalTorus_mem_rootGenerated _)

theorem parabolic_le_rootGenerated : parabolicPointStabilizer (F:=F) ≤ rootGenerated := by
  intro g hg
  let gP : parabolicPointStabilizer (F:=F) := ⟨g,hg⟩
  have himg : parabolicOrthogonalHom gP∈generatedLeviImage := by
    apply specialB3_le_generatedLeviImage
    rw [←parabolicOrthogonalHom_range_eq_special]
    exact ⟨gP,rfl⟩
  obtain ⟨h,hh,he⟩ := himg
  have hk : parabolicOrthogonalHom (h⁻¹*gP)=1 := by
    rw [map_mul,map_inv,he,inv_mul_cancel]
  have hr := parabolicKernel_mem_rootGenerated (h⁻¹*gP) hk
  have hmem : h.val∈rootGenerated := hh
  have hprod := (rootGenerated (F:=F)).mul_mem hmem hr
  simpa only [Subgroup.coe_mul,Subgroup.coe_inv,mul_inv_cancel_left] using hprod

/-- Every full Albert polynomial-and-unit automorphism is generated by the
explicit root transformations, uniformly including the binary field. -/
theorem generated_eq_top : rootGenerated (F:=F)=⊤ := by
  apply top_unique
  intro g _
  obtain ⟨h,hh⟩ := MulAction.exists_smul_eq (rootGenerated (F:=F))
    (parabolicPoint (F:=F)) (g • parabolicPoint)
  have hs : h.val⁻¹*g∈parabolicPointStabilizer (F:=F) := by
    change (h.val⁻¹*g) • parabolicPoint=parabolicPoint
    rw [mul_smul,←hh]
    exact inv_smul_smul h.val _
  have hm := (rootGenerated (F:=F)).mul_mem h.prop (parabolic_le_rootGenerated hs)
  simpa only [mul_inv_cancel_left] using hm

end Atlas.F4
