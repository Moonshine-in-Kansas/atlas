def shortRootQuadraticEntry : Fin 24 → ShortRootMatrixEntry :=
  ![((19,26),-1),((20,25),-1),((21,24),-1),((22,23),-1),((23,22),-1),((24,21),-1),((25,20),-1),((26,19),-1),((11,18),-1),((12,17),-1),((13,16),-1),((14,15),-1),((15,14),-1),((16,13),-1),((17,12),-1),((18,11),-1),((3,10),-1),((4,9),-1),((5,8),-1),((6,7),-1),((7,6),-1),((8,5),-1),((9,4),-1),((10,3),-1)]

def shortRootLinearColumn (r : Fin 24) (j : Fin 27) : Atlas.Albert.Carrier ℤ :=
  ∑ k : Fin 12, if (shortRootLinearEntries r k).1.2 = j then
    (shortRootLinearEntries r k).2 • Atlas.Albert.basisVector
      (albertCoordinateOfFin (shortRootLinearEntries r k).1.1) else 0

def shortRootQuadraticColumn (r : Fin 24) (j : Fin 27) : Atlas.Albert.Carrier ℤ :=
  if (shortRootQuadraticEntry r).1.2 = j then
    (shortRootQuadraticEntry r).2 • Atlas.Albert.basisVector
      (albertCoordinateOfFin (shortRootQuadraticEntry r).1.1) else 0

set_option maxRecDepth 10000 in
set_option maxHeartbeats 24000000 in
theorem shortRootL_integral_column : ∀ (r : Fin 24) (j : Fin 27),
    shortRootL r (Atlas.Albert.basisVector (albertCoordinateOfFin j) : Atlas.Albert.Carrier ℤ) =
      shortRootLinearColumn r j := by decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 12000000 in
theorem shortRootQ_integral_column : ∀ (r : Fin 24) (j : Fin 27),
    shortRootQ r (Atlas.Albert.basisVector (albertCoordinateOfFin j) : Atlas.Albert.Carrier ℤ) =
      shortRootQuadraticColumn r j := by decide +kernel

end Atlas.F4
