import Atlas.LinearGroups.ReeF4.DomainWedgeRoots
import Atlas.LinearGroups.ReeF4.StarLocalCompatibility
import Atlas.LinearGroups.ReeF4.NonisotropicDomain

/-! The one missing diagonal direction is generated by an actual admissible
pair. The proof is a short expansion into root rectangles; no rank calculation
or quadratic-isotropy restriction is used. -/
noncomputable section
namespace Atlas.ReeF4
open Atlas.Albert
variable {F : Type*} [CommRing F] [CharP F 2]

private theorem map_add_traceZero (f : ZMod 2 →+* F) (u v : TraceZero (ZMod 2)) :
    traceZeroMap f (u + v) = traceZeroMap f u + traceZeroMap f v := by
  apply Subtype.ext
  exact Atlas.Albert.map_add f u v

def spanWitnessLeft : TraceZero F :=
  diagonalVector 0 + rootVector (0,0) + rootVector (1,0) + rootVector (2,4)

def spanWitnessRight : TraceZero F :=
  diagonalVector 1 + rootVector (0,7) + rootVector (1,0) + rootVector (1,7) + rootVector (2,3)

theorem spanWitness_domain : StarDomain (spanWitnessLeft (F := F)) spanWitnessRight := by
  let f : ZMod 2 →+* F := ZMod.castHom (dvd_refl 2) F
  have hl : traceZeroMap f nonsingularDomainLeft = spanWitnessLeft := by
    simp only [nonsingularDomainLeft, spanWitnessLeft, map_add_traceZero,
      diagonalVector_map, rootVector_map]
  have hr : traceZeroMap f nonsingularDomainRight = spanWitnessRight := by
    simp only [nonsingularDomainRight, spanWitnessRight, map_add_traceZero,
      diagonalVector_map, rootVector_map]
  obtain ⟨hp, hc⟩ := nonsingularDomain_pair
  constructor
  · rw [← hl, ← hr, traceZeroMap_polar, hp, map_zero]
  · rw [← hl, ← hr, traceZeroMap_cross, hc, traceZeroMap_zero]

def starMissingDirection : ⋀[F]^2 (TraceZero F) :=
  diagonalWedge + oppositeWedge (0,0) + oppositeWedge (1,0) + oppositeWedge (2,0)

private def starMissingDirectionThree : ⋀[F]^2 (TraceZero F) :=
  diagonalWedge + oppositeWedge (0,0) + oppositeWedge (1,0) + oppositeWedge (2,3)

private def rootRectangle (r s t : ShortRootLabel) : ⋀[F]^2 (TraceZero F) :=
  wedge (rootVector r) (rootVector s) + wedge (diagonalVector s.1) (rootVector t)

private def spanWitnessRemainder : ⋀[F]^2 (TraceZero F) :=
  wedge (diagonalVector 0) (rootVector (0,7)) +
  wedge (rootVector (0,0)) (rootVector (1,0)) +
  wedge (rootVector (1,0)) (rootVector (2,3)) +
  wedge (rootVector (2,4)) (rootVector (1,7)) +
  rootRectangle (0,0) (2,3) (1,0) +
  rootRectangle (2,4) (0,7) (1,7) +
  rootRectangle (1,0) (0,7) (2,3) +
  rootRectangle (2,4) (1,0) (0,0) +
  rootRectangle (0,0) (1,7) (2,4)

private theorem wedge_neg_self (w : ⋀[F]^2 (TraceZero F)) : -w = w := by
  have h : w + w = 0 := by rw [← two_smul F, (CharTwo.two_eq_zero (R := F)), zero_smul]
  exact (eq_neg_of_add_eq_zero_left h).symm

private theorem diagonal_two_eq : diagonalVector (F := F) 2 = diagonalVector 0 + diagonalVector 1 := by
  have h := diagonalVector_sum (F := F)
  have hn : -(diagonalVector (F := F) 0 + diagonalVector 1) =
      diagonalVector 0 + diagonalVector 1 := by
    have hz : (diagonalVector (F := F) 0 + diagonalVector 1) +
        (diagonalVector 0 + diagonalVector 1) = 0 := by
      rw [← two_smul F, (CharTwo.two_eq_zero (R := F)), zero_smul]
    exact (eq_neg_of_add_eq_zero_left hz).symm
  exact (eq_neg_of_add_eq_zero_right h).trans hn

set_option maxHeartbeats 1200000 in
private theorem spanWitness_expansion :
    wedge (spanWitnessLeft (F := F)) spanWitnessRight =
      starMissingDirectionThree + spanWitnessRemainder := by
  have hself : wedge (rootVector (F := F) (1,0)) (rootVector (1,0)) = 0 :=
    (exteriorPower.ιMulti F 2).map_eq_zero_of_eq _ (i := 0) (j := 1) rfl (by decide)
  simp only [spanWitnessLeft, spanWitnessRight, starMissingDirectionThree,
    spanWitnessRemainder, rootRectangle, oppositeWedge, diagonalWedge,
    diagonal_two_eq, wedge_add_left, wedge_add_right, hself,
    show Fin.rev (0 : Fin 8) = 7 from by decide,
    show Fin.rev (3 : Fin 8) = 4 from by decide]
  rw [wedge_comm_charTwo (rootVector (F := F) (0,0)) (diagonalVector 1),
    wedge_comm_charTwo (rootVector (F := F) (1,0)) (diagonalVector 1),
    wedge_comm_charTwo (rootVector (F := F) (2,4)) (diagonalVector 1),
    wedge_comm_charTwo (rootVector (F := F) (2,4)) (rootVector (2,3))]
  abel <;> ac_rfl

private theorem rootDomain_of_labels (r s : ShortRootLabel)
    (ho : s ≠ (r.1, Fin.rev r.2))
    (hs : ∀ t, scaledShortRoot r + scaledShortRoot s ≠ scaledShortRoot t) :
    StarDomain (rootVector (F := F) r) (rootVector s) :=
  ⟨by rw [rootPolar, if_neg ho], rootCross_noSum r s ho hs⟩

private theorem spanWitnessRemainder_mem : spanWitnessRemainder (F := F) ∈ admissibleWedgeSpan := by
  have h0 := wedge_mem_admissibleWedgeSpan (diagonalRoot_domain (F := F) (0,7))
  have h1 := wedge_mem_admissibleWedgeSpan
    (rootDomain_of_labels (F := F) (0,0) (1,0) (by decide) (by decide))
  have h2 := wedge_mem_admissibleWedgeSpan
    (rootDomain_of_labels (F := F) (1,0) (2,3) (by decide) (by decide))
  have h3 := wedge_mem_admissibleWedgeSpan
    (rootDomain_of_labels (F := F) (2,4) (1,7) (by decide) (by decide))
  have h4 := rootSum_wedge_mem_admissibleWedgeSpan (F := F) (0,0) (2,3) (1,0) (by decide)
  have h5 := rootSum_wedge_mem_admissibleWedgeSpan (F := F) (2,4) (0,7) (1,7) (by decide)
  have h6 := rootSum_wedge_mem_admissibleWedgeSpan (F := F) (1,0) (0,7) (2,3) (by decide)
  have h7 := rootSum_wedge_mem_admissibleWedgeSpan (F := F) (2,4) (1,0) (0,0) (by decide)
  have h8 := rootSum_wedge_mem_admissibleWedgeSpan (F := F) (0,0) (1,7) (2,4) (by decide)
  exact (admissibleWedgeSpan (F := F)).add_mem
    ((admissibleWedgeSpan (F := F)).add_mem
      ((admissibleWedgeSpan (F := F)).add_mem
        ((admissibleWedgeSpan (F := F)).add_mem
          ((admissibleWedgeSpan (F := F)).add_mem
            ((admissibleWedgeSpan (F := F)).add_mem
              ((admissibleWedgeSpan (F := F)).add_mem
                ((admissibleWedgeSpan (F := F)).add_mem h0 h1) h2) h3) h4) h5) h6) h7) h8

/-- The full diagonal direction is in the span of actual admissible pairs. -/
theorem starMissingDirection_mem_admissibleWedgeSpan :
    starMissingDirection (F := F) ∈ admissibleWedgeSpan := by
  have hw := wedge_mem_admissibleWedgeSpan (spanWitness_domain (F := F))
  have h3 : starMissingDirectionThree (F := F) ∈ admissibleWedgeSpan := by
    have h := (admissibleWedgeSpan (F := F)).sub_mem hw spanWitnessRemainder_mem
    rwa [spanWitness_expansion, add_sub_cancel_right] at h
  have hp := oppositePair_wedge_mem_admissibleWedgeSpan (F := F) (2,3) (2,0) rfl (by decide)
  have h := (admissibleWedgeSpan (F := F)).sub_mem h3 hp
  have he : starMissingDirectionThree (F := F) -
      (oppositeWedge (2,3) + oppositeWedge (2,0)) = starMissingDirection := by
    simp only [starMissingDirectionThree, starMissingDirection, sub_add_eq_sub_sub]
    rw [add_sub_cancel_right, sub_eq_add_neg, wedge_neg_self]
  rwa [he] at h

end Atlas.ReeF4
