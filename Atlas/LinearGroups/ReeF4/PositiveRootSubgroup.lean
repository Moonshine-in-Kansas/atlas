import Atlas.LinearGroups.ReeF4.IntrinsicFinite
import Atlas.LinearGroups.ReeF4.RootTriangularBridge
import Atlas.LinearGroups.ReeF4.RootTriangularNilpotence
import Mathlib.GroupTheory.Nilpotent

/-! The subgroup generated by eight actual positive-root factors.
This establishes a genuine finite 2-subgroup; it does not assert its order q^12,
or that its elements have a unique ordered twelve-parameter expression. -/
noncomputable section
namespace Atlas.ReeF4
open Atlas.Albert
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

theorem absoluteUnitriangular_pow {e : TraceZero F ≃ₗ[F] TraceZero F}
    (he : AbsoluteUnitriangular e) (n : ℕ) : AbsoluteUnitriangular (e^n) := by
  induction n with
  | zero => simpa using (absoluteUnitriangular_one (F := F))
  | succ n ih => simpa only [pow_succ] using absoluteUnitriangular_mul ih he

theorem absoluteUnitriangular_inv {e : TraceZero F ≃ₗ[F] TraceZero F}
    (he : AbsoluteUnitriangular e) : AbsoluteUnitriangular e⁻¹ := by
  have hp : e^32 = 1 := he.pow_thirtyTwo
  have hinv : e^31 = e⁻¹ := by
    have hmul : e^31 * e = e⁻¹ * e := by
      simpa only [← pow_succ, inv_mul_cancel] using hp
    exact mul_right_cancel hmul
  rw [← hinv]
  exact absoluteUnitriangular_pow he 31

def modelUnitriangularSubgroup (m : ℕ) : Subgroup (Model F m) where
  carrier := {g | AbsoluteUnitriangular g.val}
  one_mem' := absoluteUnitriangular_one
  mul_mem' := fun ha hb => absoluteUnitriangular_mul ha hb
  inv_mem' := absoluteUnitriangular_inv

def positiveRootSeeds {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) : Set (Model F m) :=
  {g | (∃ k : Fin 4, g ∈ (alternatingShortRootHom hcard k).range) ∨
       (∃ k : Fin 4, g ∈ (alternatingLongRootHom hcard k).range)}

def positiveRootSubgroup {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) :
    Subgroup (Model F m) := Subgroup.closure (positiveRootSeeds hcard)

theorem positiveRootSubgroup_le_unitriangular {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) :
    positiveRootSubgroup hcard ≤ modelUnitriangularSubgroup m := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨k,u,rfl⟩ | ⟨k,u,rfl⟩)
  · exact alternatingShortRoot_unitriangular hcard k u
  · exact alternatingLongRoot_unitriangular hcard k u

theorem alternatingShortRoot_mem_positiveRootSubgroup {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (k : Fin 4) (u : shortRootSubgroup m hcard) :
    alternatingShortRootHom hcard k u ∈ positiveRootSubgroup hcard :=
  Subgroup.subset_closure (Or.inl ⟨k,u,rfl⟩)

theorem alternatingLongRoot_mem_positiveRootSubgroup {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (k : Fin 4) (u : Multiplicative F) :
    alternatingLongRootHom hcard k u ∈ positiveRootSubgroup hcard :=
  Subgroup.subset_closure (Or.inr ⟨k,u,rfl⟩)

theorem alternatingRootWord_mem_positiveRootSubgroup {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (u : Fin 4 → F) (v : Fin 4 → F × F) :
    alternatingRootWord hcard u v ∈ positiveRootSubgroup hcard := by
  apply Subgroup.list_prod_mem
  intro g hg
  obtain ⟨k,rfl⟩ := List.mem_ofFn.mp hg
  exact (positiveRootSubgroup hcard).mul_mem
    (alternatingShortRoot_mem_positiveRootSubgroup hcard k _)
    (alternatingLongRoot_mem_positiveRootSubgroup hcard k _)

theorem positiveRootSubgroup_le_commutator {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (hm : 1 ≤ m) :
    positiveRootSubgroup hcard ≤ commutator (Model F m) := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨k,u,rfl⟩ | ⟨k,u,rfl⟩)
  · exact alternatingShortRoot_mem_commutator hcard hm k u
  · exact alternatingLongRoot_mem_commutator hcard hm k u

theorem positiveRootSubgroup_isPGroup {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) : IsPGroup 2 (positiveRootSubgroup hcard) := by
  apply isPGroup_iff_pow_pow_eq_one.mpr
  intro g
  refine ⟨5, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  exact (positiveRootSubgroup_le_unitriangular hcard g.property).pow_thirtyTwo

theorem positiveRootSubgroup_isSolvable {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) : Group.IsSolvable (positiveRootSubgroup hcard) := by
  letI : Fact (Nat.Prime 2) := ⟨by decide⟩
  letI := (positiveRootSubgroup_isPGroup hcard).isNilpotent
  infer_instance

end Atlas.ReeF4
