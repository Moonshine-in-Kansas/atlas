import Atlas.LinearGroups.ReeF4.WeylRhoDerived
import Atlas.LinearGroups.ReeF4.WeylSigmaDerived
import Atlas.LinearGroups.ReeF4.TorusDerived
import Atlas.LinearGroups.ReeF4.WeylSL2Model

/-! The subgroup generated by the audited root groups, torus and two relative
Weyl operators lies in the derived intrinsic model. Equality of this generated
subgroup with the full intrinsic model is not assumed or claimed here. -/
noncomputable section
namespace Atlas.ReeF4
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

/-- The actual locally generated subgroup of the intrinsic stabilizer. -/
def elementarySubgroup {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) : Subgroup (Model F m) :=
  (shortRootModelEmbedding hcard).range ⊔
    ((modelLongSL2RootHom hcard).range ⊔
      ((torusModelHom hcard).range ⊔
        Subgroup.closure {weylRhoModel m,weylSigmaModel m}))

theorem elementarySubgroup_le_commutator {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (hm : 1 ≤ m) :
    elementarySubgroup hcard ≤ commutator (Model F m) := by
  apply sup_le (shortRootModelEmbedding_range_le_commutator hcard hm)
  apply sup_le (modelLongSL2RootHom_range_le_commutator hcard hm)
  apply sup_le (torusModelHom_range_le_commutator hcard)
  apply (Subgroup.closure_le _).mpr
  intro g hg
  simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl
  · exact weylRhoModel_mem_commutator hcard hm
  · exact weylSigmaModel_mem_commutator hcard hm

theorem shortRoot_range_le_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) :
    (shortRootModelEmbedding hcard).range ≤ elementarySubgroup hcard := le_sup_left

theorem longRoot_range_le_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) :
    (modelLongSL2RootHom hcard).range ≤ elementarySubgroup hcard :=
  le_sup_of_le_right le_sup_left

theorem torus_range_le_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) :
    (torusModelHom hcard).range ≤ elementarySubgroup hcard :=
  le_sup_of_le_right (le_sup_of_le_right le_sup_left)

private theorem weylClosure_le_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) :
    Subgroup.closure {weylRhoModel (F := F) m,weylSigmaModel m} ≤ elementarySubgroup hcard :=
  le_sup_of_le_right (le_sup_of_le_right le_sup_right)

theorem shortRoot_mem_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) (a b : F) :
    shortRootModelEmbedding hcard (shortRootParameters m hcard (a,b)) ∈ elementarySubgroup hcard :=
  shortRoot_range_le_elementary hcard ⟨shortRootParameters m hcard (a,b),rfl⟩

theorem longRoot_mem_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) (a : F) :
    modelLongSL2RootHom hcard (Multiplicative.ofAdd a) ∈ elementarySubgroup hcard :=
  longRoot_range_le_elementary hcard ⟨Multiplicative.ofAdd a,rfl⟩

theorem torus_mem_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) (a b : Fˣ) :
    torusModelHom hcard (a,b) ∈ elementarySubgroup hcard :=
  torus_range_le_elementary hcard ⟨(a,b),rfl⟩

theorem weylRho_mem_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) :
    weylRhoModel (F := F) m ∈ elementarySubgroup hcard :=
  weylClosure_le_elementary hcard (Subgroup.subset_closure (by simp))

theorem weylSigma_mem_elementary {m : ℕ} (hcard : Nat.card F = 2^(2*m+1)) :
    weylSigmaModel (F := F) m ∈ elementarySubgroup hcard :=
  weylClosure_le_elementary hcard (Subgroup.subset_closure (by simp))

theorem modelLongSL2Hom_mem_elementary {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (A : LongSL2 (F := F)) :
    modelLongSL2Hom hcard A ∈ elementarySubgroup hcard := by
  have hu (u : F) : modelLongSL2Hom hcard (longSL2Upper u) =
      modelLongSL2RootHom hcard (Multiplicative.ofAdd u) := by
    apply Subtype.ext
    exact longSL2Representation_upper (theta F m).toRingHom u
  have hw : modelLongSL2Hom hcard longSL2Weyl = weylSigmaModel m := by
    apply Subtype.ext
    exact longSL2Representation_weyl (theta F m).toRingHom
  apply Matrix.SL2.transvection_induction
    (fun A => modelLongSL2Hom hcard A ∈ elementarySubgroup hcard) ?_ ?_ A
  · intro i j hij c
    fin_cases i <;> fin_cases j
    · exact (hij rfl).elim
    · change modelLongSL2Hom hcard (longSL2Upper c) ∈ _
      rw [hu]
      exact longRoot_mem_elementary hcard c
    · rw [longSL2_lower,map_mul,map_mul,hw,hu]
      exact (elementarySubgroup hcard).mul_mem
        ((elementarySubgroup hcard).mul_mem (weylSigma_mem_elementary hcard)
          (longRoot_mem_elementary hcard c)) (weylSigma_mem_elementary hcard)
    · exact (hij rfl).elim
  · intro A B hA hB
    rw [map_mul]
    exact (elementarySubgroup hcard).mul_mem hA hB

theorem modelLongSL2Hom_range_le_elementary {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) :
    (modelLongSL2Hom hcard).range ≤ elementarySubgroup hcard := by
  rintro _ ⟨A,rfl⟩
  exact modelLongSL2Hom_mem_elementary hcard A

end Atlas.ReeF4

