import Atlas.LinearGroups.ReeF4.WeylSL2Membership
import Mathlib.GroupTheory.Commutator.Basic

/-! The actual additive long-root subgroup lies in the commutator subgroup
of the full intrinsic Ree model for q≥8. This is a local containment result;
it does not assert that the ambient group is generated by the audited roots. -/
noncomputable section
namespace Atlas.ReeF4
open Atlas.Albert
open scoped commutatorElement
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

theorem modelLongSL2RootHom_mem_commutator {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (hm : 1 ≤ m) (u : F) :
    modelLongSL2RootHom hcard (Multiplicative.ofAdd u) ∈ commutator (Model F m) := by
  have hex : ∃ a : Fˣ, a ≠ 1 := by
    by_contra hn
    push_neg at hn
    have hs : Subsingleton Fˣ := ⟨fun a b => (hn a).trans (hn b).symm⟩
    have hc : Nat.card Fˣ = 1 := Nat.card_eq_one_iff_unique.mpr ⟨hs,⟨1⟩⟩
    rw [Nat.card_units] at hc
    have hq := SuzukiFamily.card_ge_eight hcard hm
    omega
  obtain ⟨a,ha⟩ := hex
  have hsq : (a : F)^2 ≠ 1 := by
    intro h
    apply ha
    apply Units.ext
    apply (frobeniusEquiv F 2).injective
    change (a : F)^2 = (1 : F)^2
    simpa using h
  let cscale : F := (a : F)^2
  have hscale_ne : cscale - 1 ≠ 0 := sub_ne_zero.mpr hsq
  let U : F → Model F m := fun v => modelLongSL2RootHom hcard (Multiplicative.ofAdd v)
  let t : Model F m := ⟨torusEquiv m a a⁻¹, torusEquiv_mem_modelSubgroup hcard a a⁻¹⟩
  have hmul (v w : F) : U v * U w = U (v+w) :=
    (map_mul (modelLongSL2RootHom hcard) (Multiplicative.ofAdd v)
      (Multiplicative.ofAdd w)).symm
  have hinv (v : F) : (U v)⁻¹ = U (-v) :=
    (map_inv (modelLongSL2RootHom hcard) (Multiplicative.ofAdd v)).symm
  have hscale (v : F) : t * U v * t⁻¹ = U (cscale*v) := by
    apply Subtype.ext
    exact longSL2Parameter_torus_conjugate m a v
  have hcomm (v : F) : ⁅t,U v⁆ = U ((cscale-1)*v) := by
    rw [commutatorElement_def, hscale, hinv, hmul]
    congr 1
    ring
  have hv : (cscale-1)*(u/(cscale-1)) = u := by field_simp [hscale_ne]
  have hmem : ⁅t,U (u/(cscale-1))⁆ ∈ commutator (Model F m) :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  rw [hcomm,hv] at hmem
  exact hmem

theorem modelLongSL2RootHom_range_le_commutator {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (hm : 1 ≤ m) :
    (modelLongSL2RootHom hcard).range ≤ commutator (Model F m) := by
  rintro _ ⟨u,rfl⟩
  exact modelLongSL2RootHom_mem_commutator hcard hm u.toAdd

theorem modelLongSL2RootSubgroup_le_commutator {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) (hm : 1 ≤ m) :
    modelLongSL2RootSubgroup hcard ≤ commutator (Model F m) :=
  modelLongSL2RootHom_range_le_commutator hcard hm

end Atlas.ReeF4
