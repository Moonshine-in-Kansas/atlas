import Atlas.LinearGroups.ReeF4.RootSuzukiLeviTorus
import Atlas.LinearGroups.ReeF4.RootGroupMembership
import Atlas.LinearGroups.ReeF4.WeylModel

/-! The concrete local Suzuki subgroup is generated by the actual two-parameter
root operators, rho, and the actual torus T(1,b). Its identification uses all
26 coordinates and yields a faithful embedding into the intrinsic Ree model.
No order or simplicity theorem enters this structural identification. -/
noncomputable section
namespace Atlas.ReeF4
open Atlas.Albert
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

def suzukiLeviGenerators (m : ℕ) (hcard : Nat.card F = 2^(2*m+1)) :
    Set (TraceZero F ≃ₗ[F] TraceZero F) :=
  Set.range (fun p : F × F => shortRootPairEquiv m hcard p.1 p.2) ∪
    Set.range (fun b : Fˣ => torusEquiv m 1 b) ∪ {weylRho}

/-- Actual local subgroup, defined by its retained Ree operators. -/
def suzukiLeviSubgroup (m : ℕ) (hcard : Nat.card F = 2^(2*m+1)) :
    Subgroup (TraceZero F ≃ₗ[F] TraceZero F) :=
  Subgroup.closure (suzukiLeviGenerators m hcard)

theorem suzukiLeviHom_root_unshear (m : ℕ)
    (hcard : Nat.card F = 2^(2*m+1)) (a b : F) :
    suzukiLeviHom (Atlas.SuzukiFamily.rootElement m a b) =
      shortRootPairEquiv m hcard a (b+a*theta F m a) := by
  have hh := suzukiLeviHom_root m hcard a (b+a*theta F m a)
  simpa only [add_assoc, CharTwo.add_self_eq_zero, add_zero] using hh

theorem suzukiLeviHom_image_generators (m : ℕ)
    (hcard : Nat.card F = 2^(2*m+1)) :
    suzukiLeviHom ''
      (Set.range (fun p : F × F => Atlas.SuzukiFamily.rootElement m p.1 p.2) ∪
        Set.range (Atlas.SuzukiFamily.torusElement (F := F) m) ∪
          {Atlas.SuzukiFamily.weylElement}) = suzukiLeviGenerators m hcard := by
  apply Set.Subset.antisymm
  · rintro g ⟨x, hx, rfl⟩
    rcases hx with (hx | hx) | hx
    · rcases hx with ⟨⟨a,b⟩,rfl⟩
      exact Or.inl (Or.inl ⟨(a,b+a*theta F m a),
        (suzukiLeviHom_root_unshear m hcard a b).symm⟩)
    · rcases hx with ⟨t,rfl⟩
      exact Or.inl (Or.inr ⟨suzukiLeviBeta m t,(suzukiLeviHom_torus hcard t).symm⟩)
    · rcases hx with rfl
      exact Or.inr suzukiLeviHom_weyl
  · intro g hg
    rcases hg with (hg | hg) | hg
    · rcases hg with ⟨⟨a,b⟩,rfl⟩
      exact ⟨Atlas.SuzukiFamily.rootElement m a (b+a*theta F m a),
        Or.inl (Or.inl ⟨(a,b+a*theta F m a),rfl⟩),suzukiLeviHom_root m hcard a b⟩
    · rcases hg with ⟨b,rfl⟩
      obtain ⟨t,ht⟩ := suzukiLeviBeta_surjective hcard b
      refine ⟨Atlas.SuzukiFamily.torusElement m t,Or.inl (Or.inr ⟨t,rfl⟩),?_⟩
      rw [suzukiLeviHom_torus hcard, ht]
    · rcases hg with rfl
      exact ⟨Atlas.SuzukiFamily.weylElement,Or.inr rfl,suzukiLeviHom_weyl⟩

theorem suzukiLeviSubgroup_eq_map (m : ℕ)
    (hcard : Nat.card F = 2^(2*m+1)) :
    suzukiLeviSubgroup m hcard = (Atlas.SuzukiFamily.generated m).map suzukiLeviHom := by
  unfold Atlas.SuzukiFamily.generated
  rw [MonoidHom.map_closure, suzukiLeviHom_image_generators m hcard]
  rfl

def suzukiLeviEmbedding (m : ℕ) (hcard : Nat.card F = 2^(2*m+1)) :
    Atlas.SuzukiFamily.Group F m →* suzukiLeviSubgroup m hcard where
  toFun g := ⟨suzukiLeviHom g.val, by
    rw [suzukiLeviSubgroup_eq_map]
    exact ⟨g.val,g.property,rfl⟩⟩
  map_one' := by apply Subtype.ext; exact map_one suzukiLeviHom
  map_mul' g h := by apply Subtype.ext; exact map_mul suzukiLeviHom g.val h.val

theorem suzukiLeviEmbedding_bijective (m : ℕ)
    (hcard : Nat.card F = 2^(2*m+1)) :
    Function.Bijective (suzukiLeviEmbedding m hcard) := by
  constructor
  · intro g h he
    apply Subtype.ext
    apply suzukiLeviHom_injective
    exact congrArg Subtype.val he
  · intro g
    have hg : g.val ∈ (Atlas.SuzukiFamily.generated m).map suzukiLeviHom := by
      simpa only [suzukiLeviSubgroup_eq_map] using g.property
    obtain ⟨x,hx,he⟩ := hg
    exact ⟨⟨x,hx⟩,Subtype.ext he⟩

def suzukiLeviEquivalence (m : ℕ) (hcard : Nat.card F = 2^(2*m+1)) :
    Atlas.SuzukiFamily.Group F m ≃* suzukiLeviSubgroup m hcard :=
  MulEquiv.ofBijective (suzukiLeviEmbedding m hcard) (suzukiLeviEmbedding_bijective m hcard)

theorem suzukiLeviSubgroup_le_modelSubgroup {m : ℕ}
    (hcard : Nat.card F = 2^(2*m+1)) :
    suzukiLeviSubgroup m hcard ≤ modelSubgroup F m := by
  apply (Subgroup.closure_le (modelSubgroup F m)).mpr
  intro g hg
  rcases hg with (hg | hg) | hg
  · rcases hg with ⟨⟨a,b⟩,rfl⟩
    exact shortRootPairEquiv_mem_modelSubgroup hcard a b
  · rcases hg with ⟨b,rfl⟩
    exact torusEquiv_mem_modelSubgroup hcard 1 b
  · rcases hg with rfl
    exact weylOperator_mem_modelSubgroup m 0

def modelSuzukiEmbedding (m : ℕ) (hcard : Nat.card F = 2^(2*m+1)) :
    Atlas.SuzukiFamily.Group F m →* Model F m :=
  (Subgroup.inclusion (suzukiLeviSubgroup_le_modelSubgroup hcard)).comp
    (suzukiLeviEmbedding m hcard)

theorem modelSuzukiEmbedding_injective (m : ℕ)
    (hcard : Nat.card F = 2^(2*m+1)) :
    Function.Injective (modelSuzukiEmbedding m hcard) := by
  intro g h he
  apply (suzukiLeviEmbedding_bijective m hcard).injective
  apply Subtype.ext
  exact congrArg (fun z : Model F m => z.val) he

end Atlas.ReeF4
