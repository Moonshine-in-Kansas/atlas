import Mathlib.Data.ZMod.QuotientGroup

/-! Counting points of a specified period by actual cyclic-action orbits. -/

namespace Atlas.GroupTheory

variable {G X : Type*} [Group G] [MulAction G X]

/-- Actual orbits of the cyclic subgroup generated by g, restricted by size. -/
abbrev CyclesOfLength (g : G) (X : Type*) [MulAction G X] (n : ℕ) :=
  {O : MulAction.orbitRel.Quotient (Subgroup.zpowers g) X // Nat.card O.orbit = n}

theorem card_zpowers_orbit_eq_minimalPeriod (g : G) (x : X) :
    Nat.card (MulAction.orbit (Subgroup.zpowers g) x) =
      Function.minimalPeriod (g • ·) x := by
  rw [Nat.card_congr (MulAction.orbitZPowersEquiv g x),Nat.card_zmod]

noncomputable def periodPointsEquivSigmaCycles (g : G) (n : ℕ) :
    {x : X // Function.minimalPeriod (g • ·) x = n} ≃
      Σ O : CyclesOfLength g X n, O.val.orbit :=
  (Equiv.subtypeEquiv (MulAction.selfEquivSigmaOrbits' (Subgroup.zpowers g) X)
    (fun x => by
      change Function.minimalPeriod (g • ·) x = n ↔
        Nat.card (MulAction.orbit (Subgroup.zpowers g) x) = n
      rw [card_zpowers_orbit_eq_minimalPeriod])).trans
    (Equiv.subtypeSigmaEquiv (fun O : MulAction.orbitRel.Quotient (Subgroup.zpowers g) X => O.orbit)
      (fun O => Nat.card O.orbit = n))

/-- The number of points of period n is n times the number of actual n-cycles. -/
theorem card_period_points [Finite X] (g : G) (n : ℕ) :
    Nat.card {x : X // Function.minimalPeriod (g • ·) x = n} =
      Nat.card (CyclesOfLength g X n) * n := by
  classical
  letI := Fintype.ofFinite (CyclesOfLength g X n)
  rw [Nat.card_congr (periodPointsEquivSigmaCycles g n),Nat.card_sigma]
  have hc (O : CyclesOfLength g X n) : Nat.card O.val.orbit = n := O.prop
  simp only [hc,Finset.sum_const,Finset.card_univ,smul_eq_mul,← Nat.card_eq_fintype_card]

end Atlas.GroupTheory
