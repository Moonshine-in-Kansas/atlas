import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Tactic

/-! Finite left-invariant sets cover the subgroup generated by their preservers. -/
namespace Atlas.GroupTheory
variable {G : Type*} [Group G] [Finite G]

def leftPreservers (S : Set G) : Subgroup G where
  carrier := {g | ∀ x ∈ S, g*x ∈ S}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb x hx
    simpa only [mul_assoc] using ha (b*x) (hb x hx)
  inv_mem' := by
    intro a ha x hx
    let f : S → S := fun y => ⟨a*y.val,ha y.val y.property⟩
    have hf : Function.Injective f := by
      intro y z hyz
      exact Subtype.ext (mul_left_cancel (congrArg Subtype.val hyz))
    obtain ⟨y,hy⟩ := (Finite.surjective_of_injective hf) ⟨x,hx⟩
    have he : a*y.val=x := congrArg Subtype.val hy
    have hy' : a⁻¹*x=y.val := by rw [← he]; group
    rw [hy']
    exact y.property

theorem mem_of_leftPreservers {S : Set G} (h1 : 1 ∈ S) {g : G}
    (hg : g ∈ leftPreservers S) : g ∈ S := by
  simpa using hg 1 h1

end Atlas.GroupTheory
