import Mathlib.Algebra.Category.Grp.Basic
import Mathlib.CategoryTheory.Limits.IsLimit
import Mathlib.GroupTheory.CoprodI
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# Universal completion of an arbitrary diagram of groups

The carrier is the free product of the vertex groups modulo the normal closure
of the edge relations. Neither finiteness nor injectivity is presumed.
-/

universe u v

open CategoryTheory CategoryTheory.Limits

namespace Atlas.GroupTheory.Amalgam

variable {J : Type u} [Category.{v} J] (A : J ⥤ GrpCat.{u})

/-- The free product of all vertex groups. -/
abbrev VertexProduct := Monoid.CoprodI (fun j => A.obj j)

/-- Every arrow identifies its source element with its image at the target. -/
def edgeRelations : Set (VertexProduct A) :=
  {r | ∃ (i j : J) (f : i ⟶ j) (x : A.obj i),
    r = Monoid.CoprodI.of (M := fun j => A.obj j) (i := j) (A.map f x) *
      (Monoid.CoprodI.of (M := fun j => A.obj j) (i := i) x)⁻¹}

/-- The universal completion, without any injectivity or finiteness claim. -/
abbrev Completion := VertexProduct A ⧸ Subgroup.normalClosure (edgeRelations A)

/-- Canonical map from a vertex group. -/
def inclusion (j : J) : A.obj j →* Completion A :=
  (QuotientGroup.mk' _).comp (Monoid.CoprodI.of (M := fun j => A.obj j) (i := j))

theorem inclusion_compatible {i j : J} (f : i ⟶ j) (x : A.obj i) :
    inclusion A j (A.map f x) = inclusion A i x := by
  apply eq_of_mul_inv_eq_one
  change QuotientGroup.mk' _ _ * (QuotientGroup.mk' _ _)⁻¹ = 1
  rw [← map_inv, ← map_mul]
  exact QuotientGroup.eq_one_iff _ |>.mpr
    (Subgroup.subset_normalClosure ⟨i, j, f, x, rfl⟩)

/-- A compatible family of homomorphisms into a group. -/
structure CompatibleMaps (G : Type u) [Group G] where
  map : ∀ j, A.obj j →* G
  compatible : ∀ {i j} (f : i ⟶ j) (x : A.obj i), map j (A.map f x) = map i x

variable {A} {G : Type u} [Group G]

/-- Extend any compatible family, by the free-product and quotient properties. -/
def lift (c : CompatibleMaps A G) : Completion A →* G :=
  QuotientGroup.lift _ (Monoid.CoprodI.lift c.map) <|
    Subgroup.normalClosure_le_normal <| by
      rintro _ ⟨i, j, f, x, rfl⟩
      change Monoid.CoprodI.lift c.map _ = 1
      simp only [map_mul, map_inv, Monoid.CoprodI.lift_of, c.compatible, mul_inv_cancel]

@[simp] theorem lift_inclusion (c : CompatibleMaps A G) (j : J) (x : A.obj j) :
    lift c (inclusion A j x) = c.map j x := by
  exact Monoid.CoprodI.lift_of c.map x

/-- Equality is determined on the canonical vertex images. -/
theorem hom_ext {f g : Completion A →* G}
    (h : ∀ j x, f (inclusion A j x) = g (inclusion A j x)) : f = g := by
  apply QuotientGroup.monoidHom_ext
  apply Monoid.CoprodI.ext_hom
  intro j
  ext x
  exact h j x

/-- Restrict a homomorphism to a compatible family on the vertex groups. -/
def restrict (f : Completion A →* G) : CompatibleMaps A G where
  map j := f.comp (inclusion A j)
  compatible h x := congrArg f (inclusion_compatible A h x)

/-- The universal Hom/compatible-family equivalence. -/
def homEquiv : (Completion A →* G) ≃ CompatibleMaps A G where
  toFun := restrict
  invFun := lift
  left_inv f := hom_ext fun _ _ => lift_inclusion _ _ _
  right_inv c := by
    cases c
    congr

/-- An injective concrete cocone certifies injectivity at each vertex. -/
theorem inclusion_injective (c : CompatibleMaps A G)
    (hc : ∀ j, Function.Injective (c.map j)) (j : J) :
    Function.Injective (inclusion A j) := by
  intro x y h
  apply hc j
  simpa only [lift_inclusion] using congrArg (lift c) h

/-- Every element is generated by vertex images (multiplicatively). -/
@[elab_as_elim] theorem induction_on (x : Completion A) {P : Completion A → Prop}
    (one : P 1) (vertex : ∀ j y, P (inclusion A j y))
    (mul : ∀ x y, P x → P y → P (x * y)) : P x := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective
    (Subgroup.normalClosure (edgeRelations A)) x
  induction x using Monoid.CoprodI.induction_on with
  | one => simpa using one
  | of j y => exact vertex j y
  | mul x y hx hy => simpa only [map_mul] using mul _ _ hx hy

/-- The canonical images generate the whole completion. -/
theorem iSup_range_inclusion : (⨆ j, (inclusion A j).range) = ⊤ := by
  apply top_unique
  intro x hx
  clear hx
  induction x using induction_on with
  | one => exact Subgroup.one_mem _
  | vertex j y => exact (le_iSup (fun j => (inclusion A j).range) j) ⟨y, rfl⟩
  | mul x y hx hy => exact Subgroup.mul_mem _ hx hy

/-- Precisely the subgroup generated by the given cocone is attained. -/
theorem range_lift (c : CompatibleMaps A G) :
    (lift c).range = ⨆ j, (c.map j).range := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    induction x using induction_on with
    | one => simpa only [map_one] using (Subgroup.one_mem (⨆ j, (c.map j).range))
    | vertex j y =>
      rw [lift_inclusion]
      exact (le_iSup (fun j => (c.map j).range) j) ⟨y, rfl⟩
    | mul x y hx hy => simpa only [map_mul] using Subgroup.mul_mem _ hx hy
  · apply iSup_le
    rintro j _ ⟨y, rfl⟩
    exact ⟨inclusion A j y, lift_inclusion c j y⟩

/-- Surjectivity holds exactly when the cocone generates its target. -/
theorem lift_surjective_iff (c : CompatibleMaps A G) :
    Function.Surjective (lift c) ↔ (⨆ j, (c.map j).range) = ⊤ := by
  rw [← MonoidHom.range_eq_top, range_lift]

variable (A)

/-- The categorical cocone uses the very same quotient carrier. -/
def completionCocone : Cocone A where
  pt := GrpCat.of (Completion A)
  ι :=
    { app j := GrpCat.ofHom (inclusion A j)
      naturality i j f := by
        ext x
        exact inclusion_compatible A f x }

/-- Convert a categorical cocone into the concrete compatible-family API. -/
def coconeMaps (c : Cocone A) : CompatibleMaps A c.pt where
  map j := (c.ι.app j).hom
  compatible f x := by
    have h := congrArg (fun k => k x) (c.w f)
    exact h

/-- The quotient construction satisfies the categorical colimit property. -/
def completionIsColimit : IsColimit (completionCocone A) where
  desc c := GrpCat.ofHom (lift (coconeMaps A c))
  fac c j := by
    ext x
    exact lift_inclusion (coconeMaps A c) j x
  uniq c m hm := by
    apply GrpCat.hom_ext
    apply hom_ext
    intro j x
    have h := congrArg (fun k => k x) (hm j)
    exact h.trans (lift_inclusion (coconeMaps A c) j x).symm

variable {A} {B C : J ⥤ GrpCat.{u}}

/-- A natural transformation induces a homomorphism of completions. -/
def map (f : A ⟶ B) : Completion A →* Completion B :=
  lift
    { map j := (inclusion B j).comp (f.app j).hom
      compatible := fun {i j} h x => by
        change inclusion B j (f.app j (A.map h x)) = _
        have hn := congrArg (fun k => k x) (f.naturality h)
        change f.app j (A.map h x) = B.map h (f.app i x) at hn
        rw [hn]
        exact inclusion_compatible B h (f.app i x) }

@[simp] theorem map_inclusion (f : A ⟶ B) (j : J) (x : A.obj j) :
    map f (inclusion A j x) = inclusion B j (f.app j x) :=
  lift_inclusion _ j x

@[simp] theorem map_id : map (𝟙 A) = MonoidHom.id (Completion A) := by
  apply hom_ext
  intro j x
  simp only [map_inclusion]
  rfl

@[simp] theorem map_comp (f : A ⟶ B) (g : B ⟶ C) :
    map (f ≫ g) = (map g).comp (map f) := by
  apply hom_ext
  intro j x
  simp only [MonoidHom.comp_apply, map_inclusion]
  rfl

/-- Natural isomorphisms transport the actual completion carriers. -/
def congr (e : A ≅ B) : Completion A ≃* Completion B :=
  MonoidHom.toMulEquiv (map e.hom) (map e.inv)
    (by rw [← map_comp, e.hom_inv_id, map_id])
    (by rw [← map_comp, e.inv_hom_id, map_id])

end Atlas.GroupTheory.Amalgam
