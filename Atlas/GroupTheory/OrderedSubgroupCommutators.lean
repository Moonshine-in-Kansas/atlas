import Atlas.GroupTheory.OrderedSubgroupCollection
import Mathlib.GroupTheory.Commutator.Basic

/-! A commutator criterion for the existing ordered-subgroup collection API.
The hypotheses are actual containment in the subgroup generated by each tail,
not a matrix-support or grading condition. No finite group is assumed. -/

namespace Atlas.GroupTheory
open scoped commutatorElement
variable {G : Type*} [Group G]

/-- Once the tail is collected, containment of each head/tail-generator
commutator in the tail subgroup permits the next collection step. -/
theorem collectsBefore_of_tail_commutators {H : Subgroup G} {L : List (Subgroup G)}
    (htail : HasOrderedCollection L)
    (hcomm : ∀ J ∈ L, ⁅H, J⁆ ≤ subgroupListJoin L) : CollectsBefore H L := by
  intro x hx J hJ y hy
  have hyK : y ∈ subgroupListJoin L :=
    ((subgroupListJoin_le_iff L (subgroupListJoin L)).mp le_rfl J hJ) hy
  have hc : ⁅x⁻¹, y⁆ ∈ subgroupListJoin L :=
    hcomm J hJ (Subgroup.commutator_mem_commutator (H.inv_mem hx) hy)
  refine ⟨⁅x⁻¹, y⁆ * y, ?_, ?_⟩
  · rw [orderedSubgroupProduct_eq_join L htail]
    exact (subgroupListJoin L).mul_mem hc hyK
  · simp [commutatorElement_def, mul_assoc]

/-- Collection already entails containment of all these commutators. -/
theorem tail_commutators_of_collectsBefore {H : Subgroup G} {L : List (Subgroup G)}
    (hcollect : CollectsBefore H L) :
    ∀ J ∈ L, ⁅H, J⁆ ≤ subgroupListJoin L := by
  have hnormal := collectsBefore_le_normalizer hcollect
  have hcomm := Subgroup.le_normalizer_iff_commutator_le_right.mp hnormal
  intro J hJ
  exact (Subgroup.commutator_mono le_rfl
    ((subgroupListJoin_le_iff L (subgroupListJoin L)).mp le_rfl J hJ)).trans hcomm

/-- An explicit algebraic obligation for every suffix: head-root commutators
with later generators must lie in the subgroup generated by that suffix. -/
def HasTailCommutators : List (Subgroup G) → Prop
  | [] => True
  | H :: L => (∀ J ∈ L, ⁅H, J⁆ ≤ subgroupListJoin L) ∧ HasTailCommutators L

/-- The recursive commutator criterion is equivalent to the existing ordered
collection condition. It supplies no root-specific commutator identity. -/
theorem hasOrderedCollection_iff_tail_commutators (L : List (Subgroup G)) :
    HasOrderedCollection L ↔ HasTailCommutators L := by
  induction L with
  | nil => exact Iff.rfl
  | cons H L ih =>
    constructor
    · intro h
      exact ⟨tail_commutators_of_collectsBefore h.1, ih.mp h.2⟩
    · intro h
      have htail := ih.mpr h.2
      exact ⟨collectsBefore_of_tail_commutators htail h.1, htail⟩

/-- Thus the literal ordered product is exactly the generated subgroup,
provided the specified suffix commutator containments have been proved. -/
theorem orderedSubgroupProduct_eq_join_of_tail_commutators
    (L : List (Subgroup G)) (hcomm : HasTailCommutators L) :
    orderedSubgroupProduct L = (subgroupListJoin L : Set G) :=
  orderedSubgroupProduct_eq_join L ((hasOrderedCollection_iff_tail_commutators L).mpr hcomm)

end Atlas.GroupTheory
