import Atlas.Tits.LocalOrders

namespace Atlas.Tits
open Atlas.Rudvalis

noncomputable def localT : Ambient :=
  localProjection ⟨localFusionT,localFusionT_mem_localFusionGroup⟩

noncomputable def pairT : pairStabilizer :=
  coupleProjection ⟨localFusionT,localFusionT_mem_coupleFusionGroup⟩

/-- The actual point stabilizer is generated by the monomial point group and t. -/
theorem ambient_generated_by_monomial_t :
    monomialPointGroup ⊔ Subgroup.zpowers localT=⊤ := by
  let M := monomialPointGroup ⊔ Subgroup.zpowers localT
  let π := QuotientGroup.mk' gaussianScalarSubgroup
  have h : localFusionGroup≤(M.map ambientStabilizer.subtype).comap π := by
    apply (Subgroup.closure_le _).mpr
    rintro g (⟨a,rfl⟩|rfl)
    · exact ⟨codePointHom a,Subgroup.mem_sup_left ⟨a,rfl⟩,rfl⟩
    · exact ⟨localT,Subgroup.mem_sup_right (Subgroup.mem_zpowers _),rfl⟩
  apply top_unique
  intro g _
  obtain ⟨a,rfl⟩ := localProjection_surjective g
  obtain ⟨b,hb,he⟩ := h a.prop
  exact (show b=localProjection a from Subtype.ext he) ▸ hb

/-- The actual pair stabilizer is generated by its monomial subgroup and t. -/
theorem pair_generated_by_monomial_t :
    monomialPairGroup ⊔ Subgroup.zpowers pairT=⊤ := by
  let M := monomialPairGroup ⊔ Subgroup.zpowers pairT
  let π := QuotientGroup.mk' gaussianScalarSubgroup
  let ι := ambientStabilizer.subtype.comp pairStabilizer.subtype
  have h : coupleFusionGroup≤(M.map ι).comap π := by
    apply (Subgroup.closure_le _).mpr
    rintro g (⟨a,rfl⟩|rfl)
    · exact ⟨codePairHom a,Subgroup.mem_sup_left ⟨a,rfl⟩,rfl⟩
    · exact ⟨pairT,Subgroup.mem_sup_right (Subgroup.mem_zpowers _),rfl⟩
  apply top_unique
  intro g _
  obtain ⟨a,rfl⟩ := coupleProjection_surjective g
  obtain ⟨b,hb,he⟩ := h a.prop
  exact (show b=coupleProjection a from Subtype.ext (Subtype.ext he)) ▸ hb

end Atlas.Tits
