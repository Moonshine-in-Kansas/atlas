  positive_perfect : Group.IsPerfect PositiveModel
  positive_index : rootGeneratedRayParity.ker.index = 2
  positive_faithful : FaithfulSMul PositiveModel Points
  positive_transitive : MulAction.IsPretransitive PositiveModel Points
  no_solvable_normal : ∀ (N : Subgroup Model) [N.Normal] [Group.IsSolvable N], N = ⊥

