theorem not_simple : ¬IsSimpleGroup Model := by
  intro h
  letI := h
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal rootGeneratedRayParity.ker inferInstance
      with hk | hk
  · have hc := positive_card
    change Nat.card rootGeneratedRayParity.ker = 1255205709190661721292800 at hc
    rw [hk, Subgroup.card_bot] at hc
    norm_num at hc
  · have hi := positive_index
    rw [hk] at hi
    norm_num at hi
