noncomputable def frameStepNumerator (j i : SeedCoordinate) : ℤ :=
  (if j.1=0 ∨ j.1=4 ∨ j.1=5 then 1 else -1)*frameComparisonRaw i j

set_option maxRecDepth 2000 in
set_option maxHeartbeats 8000000 in
theorem framePowerNumerator_step (n : Fin 7) (r : Fin 7) (j : SeedCoordinate) :
    framePowerNumerator n.succ r j=∑i,frameStepNumerator j i*framePowerNumerator n.castSucc r i := by
  decide +kernel +revert

theorem framePowerNumerator_zero (r : Fin 7) (j : SeedCoordinate) :
    framePowerNumerator 0 r j=if j=(r,1) then 1 else 0 := by
  decide +kernel +revert

theorem framePowerNumerator_seven (r : Fin 7) (j : SeedCoordinate) :
    framePowerNumerator 7 r j=if j=(r,1) then -16384 else 0 := by
  decide +kernel +revert

end Atlas.Rudvalis
