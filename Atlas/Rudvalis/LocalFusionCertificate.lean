def localFusionSource (c : Fin 3) : SeedCoordinate := (0,![1,2,4] c)
def localFusionTarget (c : Fin 3) : SeedCoordinate := ![(0,1),(0,2),(4,7)] c

theorem localFusionNumerator_zero (c : Fin 3) (j : SeedCoordinate) :
    localFusionNumerator 0 c j=if j=localFusionSource c then 2 else 0 := by
  decide +kernel +revert

theorem localFusionNumerator_final (c : Fin 3) (j : SeedCoordinate) :
    localFusionNumerator 8 c j=if j=localFusionTarget c then -512 else 0 := by
  decide +kernel +revert

theorem localFusionNumerator_W (c : Fin 3) (j : SeedCoordinate) :
    liftedCoordinateHom seedWMonomial (localFusionNumerator 0 c) j=localFusionNumerator 1 c j := by
  decide +kernel +revert

theorem localFusionNumerator_V (c : Fin 3) (j : SeedCoordinate) :
    liftedCoordinateHom seedVMonomial (localFusionNumerator 4 c) j=localFusionNumerator 5 c j := by
  decide +kernel +revert

theorem localFusionNumerator_U (k : Fin 2) (c : Fin 3) (j : SeedCoordinate) :
    liftedCoordinateHom seedUMonomial (localFusionNumerator (![2,6] k) c) j=
      localFusionNumerator (![3,7] k) c j := by
  decide +kernel +revert

theorem localFusionNumerator_S (k : Fin 4) (c : Fin 3) (j : SeedCoordinate) :
    localFusionNumerator (![2,4,6,8] k) c j=
      ∑i,frameComparisonRaw i j*localFusionNumerator (![1,3,5,7] k) c i := by
  decide +kernel +revert

end Atlas.Rudvalis
