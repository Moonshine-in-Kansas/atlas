import Atlas.Rudvalis.FrameTranslationConjugation
import Atlas.Rudvalis.FrameSignCommutators

namespace Atlas.Rudvalis
open scoped commutatorElement

noncomputable def translationPreimage (S : Subgroup codeGroup) : Submodule Bit BinaryMatrix where
  carrier := {M | coordinateTranslationHom (Multiplicative.ofAdd M)∈S.map codePermutationHom}
  zero_mem' := by
    change coordinateTranslationHom 1∈S.map codePermutationHom
    rw [map_one]; exact Subgroup.one_mem _
  add_mem' := by
    intro a b ha hb
    change coordinateTranslationHom (Multiplicative.ofAdd a*Multiplicative.ofAdd b)∈S.map codePermutationHom
    rw [map_mul]; exact Subgroup.mul_mem _ ha hb
  smul_mem' := by
    intro t a ha
    rcases Atlas.Codes.bit_cases t with rfl|rfl
    · simp only [zero_smul]
      change coordinateTranslationHom 1∈S.map codePermutationHom
      rw [map_one]; exact Subgroup.one_mem _
    · simpa only [one_smul] using ha

theorem codeI_translation_identity : codePermutationHom codeI=
    coordinateTranslationHom (Multiplicative.ofAdd (1 : BinaryMatrix)) := by
  have h := nineCodeGenerator_projection 0
  change codePermutationHom codeI=coordinateTranslationHom (Multiplicative.ofAdd (nineTranslationMatrix 0)) at h
  have he : nineTranslationMatrix 0=(1 : BinaryMatrix) := by decide +kernel
  rwa [he] at h

theorem translationPreimage_eq_top (S : Subgroup codeGroup)
    (hc : commutator codeGroup≤S) (hI : codeI∈S) : translationPreimage S=⊤ := by
  apply binaryMatrix_differences_scalar_span
  · exact ⟨codeI,hI,codeI_translation_identity⟩
  · intro i j hij M
    let A := binaryElementaryLinear i j hij
    choose t ht using section_difference_origin A
    obtain ⟨g,hg⟩ := codePermutationHom_surjective (binarySectionGroupLift A t ht)
    obtain ⟨k,hk⟩ := codePermutationHom_surjective (coordinateTranslationHom (Multiplicative.ofAdd M))
    have hm : ⁅g,k⁆∈S := hc (Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _))
    refine ⟨⁅g,k⁆,hm,?_⟩
    rw [map_commutatorElement,hg,hk,binarySection_translation_commutator]
    rw [binaryMatrixConjugate_elementary]

theorem translations_le_commutator_scalars (S : Subgroup codeGroup)
    (hc : commutator codeGroup≤S) (hI : codeI∈S) :
    binaryTranslationSubgroup≤S.map codePermutationHom := by
  rintro _ ⟨M,rfl⟩
  change M.toAdd∈translationPreimage S
  rw [translationPreimage_eq_top S hc hI]
  trivial

/-- The actual full signed frame group is generated by its commutators and its Gaussian scalar. -/
theorem codeGroup_eq_top_of_commutator_and_I (S : Subgroup codeGroup)
    (hc : commutator codeGroup≤S) (hI : codeI∈S) : S=⊤ := by
  let : Group.IsPerfect (E ≃ₗ[Bit] E) := binaryLinearGroup_perfect
  have hd : (commutator codeGroup).map codeBlockLinearHom=⊤ := by
    rw [commutator,Subgroup.map_commutator,Subgroup.map_top_of_surjective _ codeBlockLinearHom_surjective]
    exact Group.IsPerfect.commutator_eq_top
  have hb : (S.map codePermutationHom).map binaryBlockLinearHom=⊤ := by
    have ht : S.map codeBlockLinearHom=⊤ := top_unique (hd ▸ Subgroup.map_mono hc)
    change S.map (binaryBlockLinearHom.comp codePermutationHom)=⊤ at ht
    rwa [Subgroup.map_map]
  have hk : binaryBlockLinearHom.ker≤S.map codePermutationHom := by
    rw [binaryBlockLinearHom_kernel_translations]
    exact translations_le_commutator_scalars S hc hI
  have hp : S.map codePermutationHom=⊤ := by
    have he := Subgroup.comap_map_eq_self hk
    rw [hb,Subgroup.comap_top] at he
    exact he.symm
  have he := Subgroup.comap_map_eq_self (signKernel_le_commutator_scalars S hc hI)
  rw [hp,Subgroup.comap_top] at he
  exact he.symm

theorem codeGroup_commutator_scalars_eq_top : commutator codeGroup⊔GaussianUnits=⊤ := by
  apply codeGroup_eq_top_of_commutator_and_I _ le_sup_left
  exact (show GaussianUnits≤commutator codeGroup⊔GaussianUnits from le_sup_right) (Subgroup.mem_zpowers codeI)

theorem projectiveCodeGroup_perfect : Group.IsPerfect ProjectiveCodeGroup := by
  let f : codeGroup →* ProjectiveCodeGroup := QuotientGroup.mk' GaussianUnits
  have hs : (commutator ProjectiveCodeGroup).comap f=⊤ := by
    apply codeGroup_eq_top_of_commutator_and_I
    · apply Subgroup.commutator_le.mpr
      intro a _ b _
      change f ⁅a,b⁆∈commutator ProjectiveCodeGroup
      rw [map_commutatorElement]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
    · change f codeI∈commutator ProjectiveCodeGroup
      have hi : f codeI=1 := (QuotientGroup.eq_one_iff codeI).mpr (Subgroup.mem_zpowers codeI)
      rw [hi]
      exact Subgroup.one_mem _
  constructor
  apply top_unique
  intro x _
  obtain ⟨g,rfl⟩ := QuotientGroup.mk'_surjective GaussianUnits x
  have hg : g∈(commutator ProjectiveCodeGroup).comap f := by rw [hs]; trivial
  exact hg

end Atlas.Rudvalis
