import Atlas.Rudvalis.CodeGroupOrder

/-! The full signed code group is generated by its sign kernel and six displayed maps. -/
namespace Atlas.Rudvalis

theorem codeGroup_eq_top_of_generators (S : Subgroup codeGroup)
    (hker : codePermutationHom.ker≤S)
    (hP : codeP∈S) (hI : codeI∈S) (hRho : codeRho∈S) (hSigma : codeSigma∈S)
    (hU : codeU∈S) (hR : codeR∈S) : S=⊤ := by
  have hn (i : Fin 9) : nineCodeGenerator i∈S := by
    unfold nineCodeGenerator
    split
    · rename_i hi
      interval_cases i.val
      · exact hI
      · exact hRho
      · exact hSigma
    · exact S.mul_mem (S.mul_mem (S.pow_mem hP _) hU) (S.inv_mem (S.pow_mem hP _))
  have ht : binaryTranslationSubgroup≤S.map codePermutationHom := by
    apply binaryTranslationSubgroup_le_of_nine
    intro i
    exact ⟨nineCodeGenerator i,hn i,nineCodeGenerator_projection i⟩
  have hb : (S.map codePermutationHom).map binaryBlockLinearHom=⊤ := by
    apply binaryPR_generate
    · exact ⟨codePermutationHom codeP,⟨codeP,hP,rfl⟩,codeP_block_image⟩
    · exact ⟨codePermutationHom codeR,⟨codeR,hR,rfl⟩,codeR_block_image⟩
  have hk : binaryBlockLinearHom.ker≤S.map codePermutationHom := by
    rw [binaryBlockLinearHom_kernel_translations]
    exact ht
  have hmap : S.map codePermutationHom=⊤ := by
    have he := Subgroup.comap_map_eq_self hk
    rw [hb,Subgroup.comap_top] at he
    exact he.symm
  have he := Subgroup.comap_map_eq_self hker
  rw [hmap,Subgroup.comap_top] at he
  exact he.symm

end Atlas.Rudvalis
