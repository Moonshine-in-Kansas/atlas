def seedP5Array (j : SeedCoordinate) : ℤ :=
  seedAArray (⟨(j.1.val+2)%7,Nat.mod_lt _ (by decide)⟩,j.2)

theorem seedP5Array_eq (j : SeedCoordinate) :
    seedP5Array j=(seedPOperator^5) seedAArray j := by decide +kernel +revert

theorem localExtraNumerator_zero (c : Fin 4) (j : SeedCoordinate) :
    localExtraNumerator 0 c j=if c=1 then seedP5Array j else
      if j=(![(1,1),(0,0),(4,4),(1,2)] c : SeedCoordinate) then 2 else 0 := by
  decide +kernel +revert

theorem localExtraNumerator_W (c : Fin 4) (j : SeedCoordinate) :
    liftedCoordinateHom seedWMonomial (localExtraNumerator 0 c) j=localExtraNumerator 1 c j := by
  decide +kernel +revert

theorem localExtraNumerator_V (c : Fin 4) (j : SeedCoordinate) :
    liftedCoordinateHom seedVMonomial (localExtraNumerator 4 c) j=localExtraNumerator 5 c j := by
  decide +kernel +revert

theorem localExtraNumerator_U (k : Fin 2) (c : Fin 4) (j : SeedCoordinate) :
    liftedCoordinateHom seedUMonomial (localExtraNumerator (![2,6] k) c) j=
      localExtraNumerator (![3,7] k) c j := by
  decide +kernel +revert

theorem localExtraNumerator_S (k : Fin 4) (c : Fin 4) (j : SeedCoordinate) :
    localExtraNumerator (![2,4,6,8] k) c j=
      ∑i,frameComparisonRaw i j*localExtraNumerator (![1,3,5,7] k) c i := by
  decide +kernel +revert

theorem localExtraNumerator_energy (c : Fin 2) (r : Fin 7) :
    (∑k : Fin 8,localExtraNumerator 8 c.castSucc.castSucc (r,k)^2)=
      (65536 : ℤ)*(![![0,1,1,1,0,0,1],![2,2,2,2,2,4,2]] c r) := by
  decide +kernel +revert

theorem localExtraNumerator_h_second (j : SeedCoordinate) :
    liftedCoordinateHom seedTMonomial (liftedCoordinateHom seedTMonomial (localExtraNumerator 8 2)) j=
      -256*liftedCoordinateHom (seedUnitMonomial 4) (fun i => if i=(0,2) then (2:ℤ) else 0) j := by
  decide +kernel +revert

theorem localExtraNumerator_h_third (j : SeedCoordinate) :
    liftedCoordinateHom seedTMonomial (liftedCoordinateHom seedTMonomial (localExtraNumerator 8 3)) j=
      -128*liftedCoordinateHom (seedUnitMonomial 4) seedP5Array j := by
  decide +kernel +revert

