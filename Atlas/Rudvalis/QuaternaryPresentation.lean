import Atlas.Rudvalis.SeedBasis
import Atlas.Rudvalis.QuaternarySelfDual

/-! The code is generated by the doubled torsion layer and nineteen pivot lifts. -/
namespace Atlas.Rudvalis
open Atlas.Codes.Quaternary

noncomputable def quaternaryPivot (i : Fin 19) : QuaternaryWord :=
  quaternarySeed (seedOrbitEnumerate (seedPivotIndex i))

noncomputable def quaternaryPivotSpan : Submodule (ZMod 4) QuaternaryWord :=
  quaternaryEvenLayer ⊔ Submodule.span (ZMod 4) (Set.range quaternaryPivot)

theorem quaternaryPivot_reduce (i : Fin 19) : reduce (quaternaryPivot i)=seedBasisResidue i :=
  quaternarySeed_reduce _

theorem quaternaryPivotSpan_le : quaternaryPivotSpan≤quaternaryCode := by
  apply sup_le
  · exact le_sup_left
  · apply Submodule.span_le.mpr
    rintro w ⟨i,rfl⟩
    exact quaternaryCode_seed _

theorem quaternaryPivotSpan_double (b : BinaryWord) (hb : b∈binaryTorsion) :
    double b∈quaternaryPivotSpan :=
  (show quaternaryEvenLayer≤quaternaryPivotSpan from le_sup_left)
    ((quaternaryEvenLayer_mem _).mpr ⟨b,hb,rfl⟩)

theorem quaternaryPivotSpan_pivot (i : Fin 19) : quaternaryPivot i∈quaternaryPivotSpan :=
  (show Submodule.span (ZMod 4) (Set.range quaternaryPivot)≤quaternaryPivotSpan from le_sup_right)
    (Submodule.subset_span ⟨i,rfl⟩)

theorem quaternaryPivotSpan_residue (d : BinaryWord) (hd : d∈binaryResidue) :
    ∃ q : QuaternaryWord, q∈quaternaryPivotSpan ∧ reduce q=d := by
  let R : Submodule Bit BinaryWord := AddSubgroup.toZModSubmodule 2
    (quaternaryPivotSpan.toAddSubgroup.map reduce)
  have hle : binaryResidue≤R := by
    rw [← seedBasisResidue_span]
    apply Submodule.span_le.mpr
    rintro d ⟨i,rfl⟩
    exact ⟨quaternaryPivot i,quaternaryPivotSpan_pivot i,quaternaryPivot_reduce i⟩
  exact hle hd

theorem quaternaryPivotSpan_eq : quaternaryPivotSpan=quaternaryCode := by
  apply le_antisymm quaternaryPivotSpan_le
  intro w hw
  have hd : reduce w∈binaryResidue := (quaternaryCode_residue _).mpr ⟨w,hw,rfl⟩
  obtain ⟨q,hq,hqd⟩ := quaternaryPivotSpan_residue (reduce w) hd
  have hz : reduce (w-q)=0 := by rw [map_sub,hqd,sub_self]
  obtain ⟨b,hb⟩ := (reduce_eq_zero _).mp hz
  have hbq : double b∈quaternaryCode := by
    rw [hb]
    exact quaternaryCode.sub_mem hw (quaternaryPivotSpan_le hq)
  have hbt := (quaternaryCode_torsion b).mp hbq
  have he : w=double b+q := by rw [hb,sub_add_cancel]
  rw [he]
  exact quaternaryPivotSpan.add_mem (quaternaryPivotSpan_double b hbt) hq

theorem quaternaryCode_le_of_pivots (Q : Submodule (ZMod 4) QuaternaryWord)
    (heven : ∀ b : BinaryWord, b∈binaryTorsion → double b∈Q)
    (hpivot : ∀ i : Fin 19, quaternaryPivot i∈Q) : quaternaryCode≤Q := by
  rw [← quaternaryPivotSpan_eq]
  apply sup_le
  · rintro w ⟨b,hb,rfl⟩
    exact heven b hb
  · apply Submodule.span_le.mpr
    rintro w ⟨i,rfl⟩
    exact hpivot i

theorem quaternaryCode_linear_preserves_of_pivots
    (L : QuaternaryWord →ₗ[ZMod 4] QuaternaryWord)
    (heven : ∀ b : BinaryWord, b∈binaryTorsion → L (double b)∈quaternaryCode)
    (hpivot : ∀ i : Fin 19, L (quaternaryPivot i)∈quaternaryCode) :
    ∀ w : QuaternaryWord, w∈quaternaryCode → L w∈quaternaryCode :=
  fun _ hw => quaternaryCode_le_of_pivots (quaternaryCode.comap L) heven hpivot hw

theorem quaternaryCode_mem_iff_pivot_pairings (w : QuaternaryWord) :
    w∈quaternaryCode ↔
      (∀ b : BinaryWord, b∈binaryTorsion → quaternaryForm w (double b)=0) ∧
      (∀ i : Fin 19, quaternaryForm w (quaternaryPivot i)=0) := by
  constructor
  · intro hw
    exact ⟨fun b hb => quaternaryCode_self_orthogonal (quaternaryCode_double b hb) w hw,
      fun i => quaternaryCode_self_orthogonal (quaternaryPivotSpan_le (quaternaryPivotSpan_pivot i)) w hw⟩
  · rintro ⟨heven,hpivot⟩
    rw [← quaternaryCode_self_dual]
    intro u hu
    rw [quaternaryForm_symmetric]
    exact quaternaryCode_le_of_pivots (quaternaryForm w).ker heven hpivot hu

theorem quaternaryCode_mem_iff_residue_pivots (w : QuaternaryWord) :
    w∈quaternaryCode ↔ reduce w∈binaryResidue ∧
      ∀ i : Fin 19, quaternaryForm w (quaternaryPivot i)=0 := by
  constructor
  · intro hw
    exact ⟨(quaternaryCode_residue _).mpr ⟨w,hw,rfl⟩,
      ((quaternaryCode_mem_iff_pivot_pairings w).mp hw).2⟩
  · rintro ⟨hr,hp⟩
    apply (quaternaryCode_mem_iff_pivot_pairings w).mpr
    refine ⟨?_,hp⟩
    intro b hb
    rw [quaternaryForm_symmetric,double_pairing_zero,binaryForm_symmetric]
    exact hb (reduce w) hr

end Atlas.Rudvalis

