import Atlas.Rudvalis.BinaryEvenness

/-! Eight-point block weights and the geometric balance mask of the Hamming weave. -/
namespace Atlas.Rudvalis
open scoped BigOperators

def blockWeight (a : Bit) (b c : E) : ℕ :=
  hammingNorm (fun x : E => a + dot b x + quadratic c x)

/-- Constant and nonconstant affine functions on the eight-point cube. -/
theorem blockWeight_affine (a : Bit) (b : E) :
    blockWeight a b 0 = if b = 0 then (if a = 0 then 0 else 8) else 4 := by
  decide +kernel +revert

/-- The nonzero quadratic class has radical generated by c. -/
theorem quadratic_radical (c x : E) : polar c c x = 0 := by
  simp [polar]
  ring_nf
  have htwo : (2 : Bit) = 0 := by decide
  simp [htwo]

/-- The radical derivative distinguishes balanced quadratic functions. -/
theorem blockWeight_quadratic (a : Bit) (b c : E) (hc : c ≠ 0) :
    if quadratic c c + dot b c = 1 then blockWeight a b c = 4
    else blockWeight a b c = 2 ∨ blockWeight a b c = 6 := by
  decide +kernel +revert

theorem blockWeight_complement (a : Bit) (b c : E) :
    blockWeight a b c + blockWeight (a+1) b c = 8 := by
  decide +kernel +revert

theorem matrixAt_transpose_pair (M : Matrix (Fin 3) (Fin 3) Bit) (p c : E) :
    dot (matrixAt M p) c = dot (matrixAt M.transpose c) p := by
  simp [dot, matrixAt, Fin.sum_univ_succ]
  ring

/-- The balanced block mask from the source, with no global weight enumeration. -/
theorem binary_balance_mask (M : Matrix (Fin 3) (Fin 3) Bit) (c : E) (p : Point) :
    quadratic c c + dot (matrixAt M p.val + eta p c) c =
      (if p.val = c then 1 else 0) + dot (matrixAt M.transpose c) p.val := by
  have hn := theta_normalization p c
  unfold theta at hn
  rw [dot_add_left, matrixAt_transpose_pair]
  rw [← hn]
  ring

set_option maxHeartbeats 1000000 in
-- Expand the row formula without enumerating binary-code words.
theorem binaryNormalMap_weight (a : BinaryParameters) :
    hammingNorm (binaryNormalMap a) =
      ∑ p : Point, blockWeight (a.1 p) (matrixAt a.2.1 p.val + eta p a.2.2) a.2.2 := by
  rw [Atlas.Codes.hammingNorm_prod]
  apply Finset.sum_congr rfl
  intro p _
  unfold blockWeight
  congr 1
  funext x
  simp [binaryNormalMap, theta, dot_add_left]
  ring

end Atlas.Rudvalis
