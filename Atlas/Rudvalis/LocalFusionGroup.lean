import Atlas.Rudvalis.LocalArithmeticFusion

namespace Atlas.Rudvalis

noncomputable abbrev localReferenceCross : MinimalCross := coordinateCross (localFusionSourceCoordinate 0)
noncomputable abbrev localThirdCross : MinimalCross := coordinateCross (localFusionSourceCoordinate 2)
noncomputable abbrev codeReferenceStabilizer := MulAction.stabilizer codeGroup localReferenceCross

noncomputable def codeReferenceGaussianHom : codeReferenceStabilizer →* gaussianLatticeGroup :=
  codeGaussianHom.comp codeReferenceStabilizer.subtype

/-- The concrete local subgroup generated by the actual code point stabilizer and t. -/
noncomputable def localFusionGroup : Subgroup gaussianLatticeGroup :=
  Subgroup.closure (Set.range codeReferenceGaussianHom ∪ {localFusionT})

theorem codeReferenceGaussianHom_mem (g : codeReferenceStabilizer) :
    codeReferenceGaussianHom g∈localFusionGroup :=
  Subgroup.subset_closure (Or.inl ⟨g,rfl⟩)

theorem localFusionT_mem_localFusionGroup : localFusionT∈localFusionGroup :=
  Subgroup.subset_closure (Or.inr rfl)

theorem localFusionGroup_le_generated : localFusionGroup≤generatedGaussianGroup := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨a,rfl⟩|rfl)
  · exact codeGaussianHom_mem_generated a.val
  · exact localFusionT_mem_generated

theorem localFusionGroup_le_stabilizer :
    localFusionGroup≤MulAction.stabilizer gaussianLatticeGroup localReferenceCross := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨a,rfl⟩|rfl)
  · change codeGaussianHom a.val • localReferenceCross=localReferenceCross
    rw [codeGaussianHom_cross]
    exact a.prop
  · exact localFusionT_fixes_first

theorem localFusionGroup_fix (g : localFusionGroup) : g • localReferenceCross=localReferenceCross :=
  localFusionGroup_le_stabilizer g.prop

/-- The same subgroup realized inside the actual generated group. -/
noncomputable def generatedLocalFusionGroup : Subgroup generatedGaussianGroup :=
  localFusionGroup.subgroupOf generatedGaussianGroup

theorem codeReferenceOrbit_subset_localFusionOrbit (y : MinimalCross) :
    MulAction.orbit codeReferenceStabilizer y ⊆ MulAction.orbit localFusionGroup y := by
  intro c hc
  obtain ⟨g,hg⟩ := MulAction.mem_orbit_iff.mp hc
  apply MulAction.mem_orbit_iff.mpr
  refine ⟨⟨codeReferenceGaussianHom g,codeReferenceGaussianHom_mem g⟩,?_⟩
  change codeGaussianHom g.val • y=c
  rw [codeGaussianHom_cross]
  exact hg

theorem localThirdCross_ne_reference : localThirdCross≠localReferenceCross := by
  intro h
  have ho := localFusion_first_third_orthogonal
  change CrossOrthogonal localReferenceCross localThirdCross at ho
  rw [h] at ho
  exact crossOrthogonal_irrefl _ ho

/-- The known 3- and 24-point code orbits are fused by the actual word t. -/
theorem localFusionGroup_coordinate_complement :
    coordinateFrame\{localReferenceCross} ⊆ MulAction.orbit localFusionGroup localThirdCross := by
  intro c hc
  by_cases hr : c∈coordinateRowFrame (localFusionSourceCoordinate 0).1
  · apply codeReferenceOrbit_subset_localFusionOrbit
    have ho := coordinateCross_same_row_orbit (localFusionSourceCoordinate 0).1
      (localFusionSourceCoordinate 0).2 (localFusionSourceCoordinate 2).2
      (show coordinateCross ((localFusionSourceCoordinate 0).1,(localFusionSourceCoordinate 2).2)≠
        coordinateCross ((localFusionSourceCoordinate 0).1,(localFusionSourceCoordinate 0).2) from
        localThirdCross_ne_reference)
    change MulAction.orbit codeReferenceStabilizer localThirdCross=_ at ho
    rw [ho]
    exact ⟨hr,hc.2⟩
  · have ho := coordinateCross_other_rows_orbit (localFusionSourceCoordinate 0).1
      (localFusionTargetCoordinate 2).1 localFusion_target_other_row
      (localFusionSourceCoordinate 0).2 (localFusionTargetCoordinate 2).2
    have hmem : c∈MulAction.orbit codeReferenceStabilizer
        (coordinateCross (localFusionTargetCoordinate 2)) := by
      rw [ho]
      exact ⟨hc.1,hr⟩
    obtain ⟨a,ha⟩ := MulAction.mem_orbit_iff.mp hmem
    apply MulAction.mem_orbit_iff.mpr
    refine ⟨(⟨codeReferenceGaussianHom a,codeReferenceGaussianHom_mem a⟩:localFusionGroup)*
      ⟨localFusionT,localFusionT_mem_localFusionGroup⟩,?_⟩
    rw [mul_smul]
    change codeGaussianHom a.val • (localFusionT • localThirdCross)=c
    rw [localFusionT_cross_action,codeGaussianHom_cross]
    exact ha

/-- Only the geometric orbit-size alternatives remain as hypotheses here. -/
theorem localFusionGroup_full_orthogonal_orbit
    (hsizes : Nat.card (MulAction.orbit localFusionGroup localThirdCross)=27 ∨
      Nat.card (MulAction.orbit localFusionGroup localThirdCross)=219 ∨
      Nat.card (MulAction.orbit localFusionGroup localThirdCross)=1563 ∨
      Nat.card (MulAction.orbit localFusionGroup localThirdCross)=1755) :
    MulAction.orbit localFusionGroup localThirdCross=
      {c : MinimalCross | CrossOrthogonal localReferenceCross c} :=
  localFusion_full_orthogonal_orbit localFusionGroup localFusionGroup_fix
    localFusionT_mem_localFusionGroup localFusionGroup_coordinate_complement hsizes

end Atlas.Rudvalis
