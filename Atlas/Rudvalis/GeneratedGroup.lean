import Atlas.Rudvalis.LatticeReflection

namespace Atlas.Rudvalis

/-- The actual group generated by the full code-frame stabilizer and the glue reflection. -/
noncomputable def generatedGaussianGroup : Subgroup gaussianLatticeGroup :=
  Subgroup.closure (Set.range codeGaussianHom ∪ {rudvalisReflection})

theorem codeGaussianHom_mem_generated (g : codeGroup) : codeGaussianHom g∈generatedGaussianGroup :=
  Subgroup.subset_closure (Or.inl ⟨g,rfl⟩)

theorem rudvalisReflection_mem_generated : rudvalisReflection∈generatedGaussianGroup :=
  Subgroup.subset_closure (Or.inr rfl)

noncomputable def codeGeneratedHom : codeGroup →* generatedGaussianGroup :=
  codeGaussianHom.codRestrict generatedGaussianGroup codeGaussianHom_mem_generated

theorem codeGeneratedHom_injective : Function.Injective codeGeneratedHom := by
  intro g h he
  exact codeGaussianHom_injective (congrArg Subtype.val he)

noncomputable def generatedReflection : generatedGaussianGroup :=
  ⟨rudvalisReflection,rudvalisReflection_mem_generated⟩

theorem generatedGaussianGroup_finite : Finite generatedGaussianGroup := inferInstance

theorem generatedGaussianGroup_induction {P : gaussianLatticeGroup→Prop}
    (hcode : ∀g : codeGroup,P (codeGaussianHom g)) (hreflection : P rudvalisReflection)
    (hone : P 1) (hmul : ∀g h,P g → P h → P (g*h)) (hinv : ∀g,P g → P g⁻¹)
    (g : gaussianLatticeGroup) (hg : g∈generatedGaussianGroup) : P g := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with ⟨h,rfl⟩ | rfl
    · exact hcode h
    · exact hreflection
  | one => exact hone
  | mul g h _ _ hg hh => exact hmul g h hg hh
  | inv g _ hg => exact hinv g hg

end Atlas.Rudvalis
