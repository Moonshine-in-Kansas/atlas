import ComparisonWork.J1SignGroup
import ComparisonWork.J1SignConjugation
import Mathlib.Algebra.Group.Subgroup.Finite

/-!
Source-only checkpoint: the existing sign subgroup is generated by the actual
P-conjugates of R, lies in H, and is normalized by H.

All groups remain subgroups of the installed split-octonion automorphism group.
There are no assumptions of J1/G2 order, simplicity, or J1 perfectness. This
does not identify the full normalizer, prove a Sylow statement, or give the
order/unique normal form of H. This candidate has not been elaborated.
-/
namespace Atlas.Janko1

theorem signElement_add (a b : SignParameters) :
    signElement (a + b) = signElement a * signElement b := by
  exact signHom.map_mul (Multiplicative.ofAdd a) (Multiplicative.ofAdd b)

theorem signElement_nsmul (n : ℕ) (a : SignParameters) :
    signElement (n • a) = signElement a ^ n := by
  exact map_pow signHom (Multiplicative.ofAdd a) n

theorem signElement_mem_signSubgroup (a : SignParameters) :
    signElement a ∈ signSubgroup := by
  change ∃ b : Multiplicative SignParameters, signHom b = signElement a
  exact ⟨Multiplicative.ofAdd a, rfl⟩

theorem signParameters_decompose (a : SignParameters) :
    a = (a 0).val • ![1,0,0] + (a 1).val • ![0,1,0] +
      (a 2).val • ![0,0,1] := by
  funext i
  fin_cases i <;> simp [nsmul_eq_mul, ZMod.natCast_zmod_val]

theorem signElement_basis_one :
    signElement ![0,1,0] = P * R * P⁻¹ := by
  have h : signShift ![1,0,0] = ![0,1,0] := by decide
  simpa only [h, signElement_basis_zero] using
    (P_conjugates_sign ![1,0,0]).symm

theorem signElement_basis_two :
    signElement ![0,0,1] = P ^ 2 * R * (P ^ 2)⁻¹ := by
  have h : signShift ![0,1,0] = ![0,0,1] := by decide
  calc
    signElement ![0,0,1] = P * signElement ![0,1,0] * P⁻¹ := by
      simpa only [h] using (P_conjugates_sign ![0,1,0]).symm
    _ = P ^ 2 * R * (P ^ 2)⁻¹ := by
      rw [signElement_basis_one]
      simp only [pow_two, mul_inv_rev, mul_assoc]

theorem signElement_factorization (a : SignParameters) :
    signElement a = R ^ (a 0).val * (P * R * P⁻¹) ^ (a 1).val *
      (P ^ 2 * R * (P ^ 2)⁻¹) ^ (a 2).val := by
  calc
    signElement a = signElement ((a 0).val • ![1,0,0] +
        (a 1).val • ![0,1,0] + (a 2).val • ![0,0,1]) :=
      congrArg signElement (signParameters_decompose a)
    _ = _ := by
      simp only [signElement_add, signElement_nsmul, signElement_basis_zero,
        signElement_basis_one, signElement_basis_two]

theorem R_mem_signSubgroup : R ∈ signSubgroup := by
  rw [← signElement_basis_zero]
  exact signElement_mem_signSubgroup ![1,0,0]

theorem signSubgroup_le_iff (K : Subgroup (G2.Model Field)) :
    signSubgroup ≤ K ↔ R ∈ K ∧ P * R * P⁻¹ ∈ K ∧
      P ^ 2 * R * (P ^ 2)⁻¹ ∈ K := by
  constructor
  · intro h
    refine ⟨h R_mem_signSubgroup, ?_, ?_⟩
    · apply h
      rw [← signElement_basis_one]
      exact signElement_mem_signSubgroup ![0,1,0]
    · apply h
      rw [← signElement_basis_two]
      exact signElement_mem_signSubgroup ![0,0,1]
  · rintro ⟨h0, h1, h2⟩ x hx
    change ∃ a : Multiplicative SignParameters, signHom a = x at hx
    obtain ⟨a, rfl⟩ := hx
    change signElement a.toAdd ∈ K
    rw [signElement_factorization]
    exact K.mul_mem (K.mul_mem (K.pow_mem h0 _) (K.pow_mem h1 _)) (K.pow_mem h2 _)

theorem signSubgroup_eq_closure_three :
    signSubgroup = Subgroup.closure
      ({R, P * R * P⁻¹, P ^ 2 * R * (P ^ 2)⁻¹} : Set (G2.Model Field)) := by
  apply le_antisymm
  · apply (signSubgroup_le_iff _).mpr
    exact ⟨Subgroup.subset_closure (by simp),
      Subgroup.subset_closure (by simp), Subgroup.subset_closure (by simp)⟩
  · apply (Subgroup.closure_le signSubgroup).mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact R_mem_signSubgroup
    · rw [← signElement_basis_one]
      exact signElement_mem_signSubgroup ![0,1,0]
    · rw [← signElement_basis_two]
      exact signElement_mem_signSubgroup ![0,0,1]

theorem signSubgroup_le_H : signSubgroup ≤ H := by
  have hP : P ∈ H := Subgroup.subset_closure (by simp)
  have hR : R ∈ H := Subgroup.subset_closure (by simp)
  have hP2 : P ^ 2 ∈ H := H.pow_mem hP 2
  exact (signSubgroup_le_iff H).mpr ⟨hR,
    H.mul_mem (H.mul_mem hP hR) (H.inv_mem hP),
    H.mul_mem (H.mul_mem hP2 hR) (H.inv_mem hP2)⟩

theorem signSubgroup_le_generated : signSubgroup ≤ generated :=
  signSubgroup_le_H.trans H_le_generated

theorem P_mem_signSubgroup_normalizer :
    P ∈ Subgroup.normalizer (signSubgroup : Set (G2.Model Field)) := by
  apply Subgroup.mem_normalizer_fintype
  intro x hx
  change ∃ a : Multiplicative SignParameters, signHom a = x at hx
  obtain ⟨a, rfl⟩ := hx
  change P * signElement a.toAdd * P⁻¹ ∈ signSubgroup
  rw [P_conjugates_sign]
  exact signElement_mem_signSubgroup (signShift a.toAdd)

theorem Q_mem_signSubgroup_normalizer :
    Q ∈ Subgroup.normalizer (signSubgroup : Set (G2.Model Field)) := by
  apply Subgroup.mem_normalizer_fintype
  intro x hx
  change ∃ a : Multiplicative SignParameters, signHom a = x at hx
  obtain ⟨a, rfl⟩ := hx
  change Q * signElement a.toAdd * Q⁻¹ ∈ signSubgroup
  rw [Q_conjugates_sign]
  exact signElement_mem_signSubgroup (signDouble a.toAdd)

theorem H_le_signSubgroup_normalizer :
    H ≤ Subgroup.normalizer (signSubgroup : Set (G2.Model Field)) := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl
  · exact P_mem_signSubgroup_normalizer
  · exact Q_mem_signSubgroup_normalizer
  · exact signSubgroup.le_normalizer R_mem_signSubgroup

theorem signSubgroup_normal_in_H : (signSubgroup.subgroupOf H).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer signSubgroup_le_H).mpr
    H_le_signSubgroup_normalizer

theorem signSubgroup_eq_closure_conjugates :
    signSubgroup = Subgroup.closure
      (Set.range (fun j : Fin 7 => P ^ j.val * R * (P ^ j.val)⁻¹)) := by
  apply le_antisymm
  · have h (j : Fin 7) : P ^ j.val * R * (P ^ j.val)⁻¹ ∈
        Subgroup.closure (Set.range
          (fun k : Fin 7 => P ^ k.val * R * (P ^ k.val)⁻¹)) :=
      Subgroup.subset_closure (Set.mem_range_self j)
    apply (signSubgroup_le_iff _).mpr
    refine ⟨?_, ?_, ?_⟩
    · simpa using h (0 : Fin 7)
    · simpa using h (1 : Fin 7)
    · simpa using h (2 : Fin 7)
  · apply (Subgroup.closure_le signSubgroup).mpr
    rintro x ⟨j, rfl⟩
    have hPpow : P ^ j.val ∈
        Subgroup.normalizer (signSubgroup : Set (G2.Model Field)) :=
      (Subgroup.normalizer (signSubgroup : Set (G2.Model Field))).pow_mem
        P_mem_signSubgroup_normalizer j.val
    exact (Subgroup.mem_normalizer_iff.mp hPpow R).mp R_mem_signSubgroup

end Atlas.Janko1
