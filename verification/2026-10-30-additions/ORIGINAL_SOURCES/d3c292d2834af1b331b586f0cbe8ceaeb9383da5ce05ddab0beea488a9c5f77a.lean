def basisMatrix (i : Fin 14) : Matrix (Fin 8) (Fin 8) ℤ :=
  fun r c => ((basisTable[i.val]!)[r.val]!)[c.val]!

def rootPivot : Fin 12 → Fin 8 × Fin 8 × ℤ :=
  ![(1,2,1),(2,3,1),(2,1,-1),(0,5,-1),(1,4,1),(1,0,1),(5,0,-1),(1,7,-1),(1,5,1),(2,0,-1),(6,0,-1),(3,0,-1)]

/-- Literal coordinate left inverse. It uses integer coefficients only. -/
def readCoordinates {R : Type*} [CommRing R]
    (M : Matrix (Fin 8) (Fin 8) R) (i : Fin 14) : R :=
  if h : i.val < 2 then
    (![M 0 0 + M 1 1, -M 0 0] : Fin 2 → R) ⟨i.val,h⟩
  else
    let p := rootPivot ⟨i.val-2,by omega⟩
    (p.2.2 : R) * M p.1 p.2.1

end Atlas.Chevalley.Comparison.G2
