import ComparisonWork.ReeThreeBoundaryRootStructure
import Atlas.LinearGroups.ReeG2.NormAnisotropy
import Mathlib.Algebra.Group.Action.End
import Mathlib.Algebra.Group.Subgroup.Ker

/-!
Source-only draft, 27 October 2026. No build or audit has been run.

The faithful 28-point action, expressed in the original affine coordinates.
The homomorphism uses inverse matrices, exactly as the existing left action
does. The Weyl formula uses compatible-vector reconstruction; it does not
import the preserved unsuccessful WeylCoordinates draft.
-/

noncomputable section
namespace Atlas.Comparisons.ReeThree.Boundary
open Atlas.ReeG2

variable {F : Type*} [Field F] [Finite F] [CharP F 3]

abbrev Coordinates (F : Type*) := Option (F × F × F)

/-- The existing projective point action transported along its actual chart. -/
def coordinateAction (hF : Nat.card F = 3) :
    Model F 0 →* Equiv.Perm (Coordinates F) := by
  letI := pointAction 0 (smallParameter_card_condition hF)
  exact ((pointEquiv (F := F) 0).symm.permCongrHom).toMonoidHom.comp
    (MulAction.toPermHom (Model F 0) (pointSet (F := F) 0))

theorem coordinateAction_injective (hF : Nat.card F = 3) :
    Function.Injective (coordinateAction hF) := by
  letI := pointAction 0 (smallParameter_card_condition hF)
  letI := pointAction_faithful 0 (smallParameter_card_condition hF)
  exact ((pointEquiv (F := F) 0).symm.permCongrHom).injective.comp
    (MulAction.toPerm_injective (α := Model F 0) (β := pointSet (F := F) 0))

theorem coordinateAction_coherence (hF : Nat.card F = 3)
    (g : Model F 0) (p : Coordinates F) :
    pointParam 0 (coordinateAction hF g p) = pointRight g.val⁻¹ (pointParam 0 p) := by
  letI := pointAction 0 (smallParameter_card_condition hF)
  change ((pointEquiv (F := F) 0)
    ((pointEquiv (F := F) 0).symm (g • (pointEquiv (F := F) 0 p)))).val = _
  rw [Equiv.apply_symm_apply]
  rfl

theorem coordinates_card (hF : Nat.card F = 3) : Nat.card (Coordinates F) = 28 := by
  rw [Nat.card_congr (pointEquiv (F := F) 0)]
  exact smallParameter_point_count hF

def rootModel (hF : Nat.card F = 3) (a b c : F) : Model F 0 :=
  ⟨rootElement 0 a b c,
    rootSubgroup_le_generated 0 (smallParameter_card_condition hF) ⟨(a, b, c), rfl⟩⟩

def uModel (hF : Nat.card F = 3) : Model F 0 := rootModel hF 1 1 0
def vModel (hF : Nat.card F = 3) : Model F 0 := rootModel hF 0 1 0
def tModel : Model F 0 :=
  ⟨t, Subgroup.subset_closure (Or.inl (Or.inr ⟨-1, rfl⟩))⟩
def wModel : Model F 0 := ⟨upsilon, upsilon_mem_generated 0⟩

theorem uModel_order (hF : Nat.card F = 3) : orderOf (uModel hF) = 9 := by
  have h := orderOf_injective (generated F 0).subtype
    (generated F 0).subtype_injective (uModel hF)
  exact h.symm.trans (u_order hF)

theorem model_generated_by_four (hF : Nat.card F = 3) :
    Subgroup.closure ({uModel hF, vModel hF, tModel, wModel} : Set (Model F 0)) = ⊤ := by
  apply Subgroup.map_injective (generated F 0).subtype_injective
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  simpa [Set.image_insert_eq, Set.image_singleton, uModel, vModel,
    rootModel, tModel, wModel, u, v, t] using (generated_eq_four hF).symm

/-- The full permutation image is generated by the four explicit permutations
whose coordinate formulas follow. This is suitable input for a later image
comparison, but supplies no target-side containment. -/
theorem coordinateAction_range (hF : Nat.card F = 3) :
    (coordinateAction hF).range = Subgroup.closure
      ({coordinateAction hF (uModel hF), coordinateAction hF (vModel hF),
        coordinateAction hF tModel, coordinateAction hF wModel} :
        Set (Equiv.Perm (Coordinates F))) := by
  rw [MonoidHom.range_eq_map, ← model_generated_by_four hF, MonoidHom.map_closure]
  simp only [Set.image_insert_eq, Set.image_singleton]

theorem pointRight_root_affine (hF : Nat.card F = 3) (a b c d e f : F) :
    pointRight (rootElement 0 d e f) (affinePoint 0 a b c) =
      affinePoint 0 (a + d) (b + e - a * d)
        (c + f - d * b + a * d ^ 2 - a ^ 2 * d) := by
  simpa [theta_apply, cube_eq hF, pow_two, mul_assoc] using
    pointRight_affine_root 0 (smallParameter_card_condition hF) a b c d e f

theorem coordinate_root_none (hF : Nat.card F = 3) (a b c : F) :
    coordinateAction hF (rootModel hF a b c) none = none := by
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (rootElement 0 a b c)⁻¹ infinityPoint = infinityPoint
  rw [root_inv hF, pointRight_infinity_root]

/-- A formula for every root element in the left-action convention. -/
theorem coordinate_root_affine (hF : Nat.card F = 3) (d e f a b c : F) :
    coordinateAction hF (rootModel hF d e f) (some (a, b, c)) =
      some (a - d, b - e - d ^ 2 + a * d,
        c - f - d * e + d + d * b + a * d ^ 2 + a ^ 2 * d) := by
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (rootElement 0 d e f)⁻¹ (affinePoint 0 a b c) = _
  rw [root_inv hF, pointRight_root_affine hF]
  change affinePoint 0 _ _ _ = affinePoint 0 _ _ _
  congr 1 <;> ring

theorem coordinate_u_affine (hF : Nat.card F = 3) (a b c : F) :
    coordinateAction hF (uModel hF) (some (a, b, c)) =
      some (a - 1, b + 1 + a, c + b + a + a ^ 2) := by
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (u : Ambient F)⁻¹ (affinePoint 0 a b c) = _
  rw [u_inv hF, pointRight_root_affine hF]
  change affinePoint 0 _ _ _ = affinePoint 0 _ _ _
  congr 1 <;> ring

theorem coordinate_v_affine (hF : Nat.card F = 3) (a b c : F) :
    coordinateAction hF (vModel hF) (some (a, b, c)) = some (a, b - 1, c) := by
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (v : Ambient F)⁻¹ (affinePoint 0 a b c) = _
  rw [v_inv hF, pointRight_root_affine hF]
  simp [pointParam, sub_eq_add_neg]

theorem coordinate_t_none (hF : Nat.card F = 3) :
    coordinateAction hF (tModel (F := F)) none = none := by
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (t : Ambient F)⁻¹ infinityPoint = infinityPoint
  rw [t_inv]
  exact pointRight_infinity_torus 0 (-1)

theorem coordinate_t_affine (hF : Nat.card F = 3) (a b c : F) :
    coordinateAction hF (tModel (F := F)) (some (a, b, c)) = some (-a, b, -c) := by
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (t : Ambient F)⁻¹ (affinePoint 0 a b c) = affinePoint 0 (-a) b (-c)
  rw [t_inv]
  simpa [t, theta_apply, cube_eq hF, div_neg] using
    pointRight_affine_torus 0 (smallParameter_card_condition hF) (-1) a b c

theorem coordinate_w_none (hF : Nat.card F = 3) :
    coordinateAction hF (wModel (F := F)) none = some (0, 0, 0) := by
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (upsilon : Ambient F)⁻¹ infinityPoint = affinePoint 0 0 0 0
  rw [upsilon_inv, pointRight_infinity_upsilon 0]

theorem coordinate_w_origin (hF : Nat.card F = 3) :
    coordinateAction hF (wModel (F := F)) (some (0, 0, 0)) = none := by
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (upsilon : Ambient F)⁻¹ (affinePoint 0 0 0 0) = infinityPoint
  rw [upsilon_inv, pointRight_zero_upsilon 0]

/-- The seven coordinates used in the Weyl formula, specialized without
enumerating points or matrices. -/
theorem affineVector_coordinates (hF : Nat.card F = 3) (a b c : F) :
    affineVector 0 a b c =
      ![1, a, -b, a * b - c, -a * c - b - a ^ 2,
        -b * c - a * b ^ 2 - c - a,
        -c ^ 2 - a * b * c + c * a - b ^ 2 - a ^ 2 * b + a ^ 2] := by
  have ha4 : a ^ 4 = a ^ 2 := by rw [pow_succ, cube_eq hF, pow_two]
  ext i
  fin_cases i <;>
    simp [affineVector, rootMatrix_expanded, rootExpanded, theta_apply,
      cube_eq hF, ha4] <;>
    ring_nf <;> simp only [cube_eq hF, ha4] <;> ring

/-- Forced coordinates of the Weyl image, with the denominator kept visible. -/
def oppositeParameters (a b c : F) : F × F × F :=
  let r := affineVector 0 a b c
  (r 5 / r 6, -(r 4 / r 6), -(r 5 / r 6) * (r 4 / r 6) - r 3 / r 6)

/-- Recover the Weyl image from compatible-vector reconstruction, rather than
expanding the seven coordinate identities into large polynomials. -/
theorem pointRight_w_affine (hF : Nat.card F = 3) (a b c : F)
    (hn : affineVector 0 a b c 6 ≠ 0) :
    pointRight (upsilon : Ambient F) (affinePoint 0 a b c) =
      affinePoint 0 (oppositeParameters a b c).1
        (oppositeParameters a b c).2.1 (oppositeParameters a b c).2.2 := by
  let r := affineVector 0 a b c
  let z := negativeReverse r
  have hz : z 0 ≠ 0 := by simpa [z, negativeReverse] using hn
  have hc := pointCompatibility_reverse 0
    (affine_pointCompatibility 0 (smallParameter_card_condition hF) a b c)
  have hs := pointCompatibility_scale 0 hc ((z 0)⁻¹) (inv_ne_zero hz)
  have hr := compatible_affine_reconstruction 0 (smallParameter_card_condition hF)
    hs (inv_mul_cancel₀ hz)
  have hr' : (fun i => (z 0)⁻¹ * z i) =
      affineVector 0 ((z 0)⁻¹ * z 1) (-((z 0)⁻¹ * z 2))
        (-((z 0)⁻¹ * z 1 * ((z 0)⁻¹ * z 2)) - (z 0)⁻¹ * z 3) := by
    simpa only [sigma_apply, Nat.zero_add, pow_one, cube_eq hF] using hr
  have h1 : (z 0)⁻¹ * z 1 = r 5 / r 6 := by
    simp [z, negativeReverse, div_eq_mul_inv, mul_comm]
  have h2 : (z 0)⁻¹ * z 2 = r 4 / r 6 := by
    simp [z, negativeReverse, div_eq_mul_inv, mul_comm]
  have h3 : (z 0)⁻¹ * z 3 = r 3 / r 6 := by
    simp [z, negativeReverse, div_eq_mul_inv, mul_comm]
  rw [h1, h2, h3] at hr'
  have hnrm : (fun i => (z 0)⁻¹ * z i) =
      affineVector 0 (oppositeParameters a b c).1
        (oppositeParameters a b c).2.1 (oppositeParameters a b c).2.2 := by
    simpa only [oppositeParameters, neg_mul] using hr'
  unfold pointRight affinePoint
  rw [Projectivization.map_mk]
  apply (Projectivization.mk_eq_mk_iff F _ _ _ _).mpr
  refine ⟨Units.mk0 (z 0) hz, ?_⟩
  ext i
  simp only [Units.smul_def, Units.val_mk0, Pi.smul_apply, smul_eq_mul]
  change z 0 * (affineVector 0 (oppositeParameters a b c).1
    (oppositeParameters a b c).2.1 (oppositeParameters a b c).2.2 i) =
      rowEquiv (upsilon : Ambient F) r i
  rw [← congrFun hnrm i, rowEquiv_upsilon]
  change z 0 * ((z 0)⁻¹ * z i) = z i
  rw [← mul_assoc, mul_inv_cancel₀ hz, one_mul]

theorem coordinate_w_affine (hF : Nat.card F = 3) (a b c : F)
    (hp : (a, b, c) ≠ (0, 0, 0)) :
    coordinateAction hF (wModel (F := F)) (some (a, b, c)) =
      some (oppositeParameters a b c) := by
  have hn : affineVector 0 a b c 6 ≠ 0 := by
    intro h
    obtain ⟨ha, hb, hc⟩ :=
      (affine_last_zero_iff 0 (smallParameter_card_condition hF) a b c).mp h
    exact hp (by simp [ha, hb, hc])
  apply pointParam_injective (F := F) 0
  rw [coordinateAction_coherence]
  change pointRight (upsilon : Ambient F)⁻¹ (affinePoint 0 a b c) = _
  rw [upsilon_inv]
  exact pointRight_w_affine hF a b c hn

/-- The order-nine element has exactly the distinguished fixed point. -/
theorem coordinate_u_fixed_iff (hF : Nat.card F = 3) (p : Coordinates F) :
    coordinateAction hF (uModel hF) p = p ↔ p = none := by
  cases p with
  | none =>
    simp only [uModel, coordinate_root_none, iff_self]
  | some p =>
    obtain ⟨a, b, c⟩ := p
    constructor
    · intro h
      rw [coordinate_u_affine] at h
      have ha : a - 1 = a := congrArg Prod.fst (Option.some.inj h)
      have hz : (1 : F) = 0 := by linear_combination -ha
      exact False.elim (one_ne_zero hz)
    · intro h
      cases h

end Atlas.Comparisons.ReeThree.Boundary
