import Atlas.LinearGroups.ReeF4.PositiveRootOrderedCollection
import Atlas.LinearGroups.ReeF4.AlternatingRootWordInjective
import Mathlib.Data.Fin.Tuple.Basic
import Mathlib.GroupTheory.Solvable

/-!
Unverified draft, 27 October 2026. No Lean or Lake invocation has checked this file.

The subgroup generated by the seven-factor tail of the positive-root list.
Its proposed normal form has four long parameters and three short parameter pairs.
All statements concern this tail and its inclusion in the positive-root subgroup.
No normalization by the full Suzuki Levi or parabolic identification is asserted.
-/

noncomputable section

namespace Atlas.ReeF4

open Atlas.GroupTheory
open scoped Pointwise

variable {F : Type*} [Field F] [Finite F] [CharP F 2]

/-- The actual tail subgroup: omit the initial two-parameter short-root factor. -/
def positiveRootTailSubgroup {m : ℕ} (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    Subgroup (Model F m) :=
  subgroupListJoin ((positiveRootFactorList hcard).tail)

theorem positiveRoot_head_sup_tail {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    (alternatingShortRootHom hcard 0).range ⊔ positiveRootTailSubgroup hcard =
      positiveRootSubgroup hcard := by
  change subgroupListJoin (positiveRootFactorList hcard) = positiveRootSubgroup hcard
  exact positiveRootFactorList_join hcard

theorem positiveRootTailSubgroup_le_positiveRootSubgroup {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    positiveRootTailSubgroup hcard ≤ positiveRootSubgroup hcard := by
  rw [← positiveRoot_head_sup_tail hcard]
  exact le_sup_right

theorem positiveRootTail_hasOrderedCollection {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    HasOrderedCollection ((positiveRootFactorList hcard).tail) :=
  (positiveRoot_hasOrderedCollection hcard).2

theorem positiveRootTail_orderedProduct_eq {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    orderedSubgroupProduct ((positiveRootFactorList hcard).tail) =
      (positiveRootTailSubgroup hcard : Set (Model F m)) :=
  orderedSubgroupProduct_eq_join _ (positiveRootTail_hasOrderedCollection hcard)

/-- The omitted positive short-root factor normalizes the tail. -/
theorem positiveRoot_head_le_tail_normalizer {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    (alternatingShortRootHom hcard 0).range ≤
      Subgroup.normalizer (positiveRootTailSubgroup hcard) := by
  change (alternatingShortRootHom hcard 0).range ≤
    Subgroup.normalizer (subgroupListJoin ((positiveRootFactorList hcard).tail))
  exact collectsBefore_le_normalizer ((positiveRoot_hasOrderedCollection hcard).1)

theorem positiveRootSubgroup_le_tail_normalizer {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    positiveRootSubgroup hcard ≤ Subgroup.normalizer (positiveRootTailSubgroup hcard) := by
  rw [← positiveRoot_head_sup_tail hcard]
  exact sup_le (positiveRoot_head_le_tail_normalizer hcard)
    (positiveRootTailSubgroup hcard).le_normalizer

/-- Normality is asserted inside U, not inside the full intrinsic group. -/
theorem positiveRootTailSubgroup_normal_in_positiveRootSubgroup {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    ((positiveRootTailSubgroup hcard).subgroupOf (positiveRootSubgroup hcard)).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer
    (positiveRootTailSubgroup_le_positiveRootSubgroup hcard)).mpr
      (positiveRootSubgroup_le_tail_normalizer hcard)

theorem positiveRootTailSubgroup_isSolvable {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    Group.IsSolvable (positiveRootTailSubgroup hcard) := by
  letI := positiveRootSubgroup_isSolvable hcard
  exact Group.isSolvable_of_isSolvable_injective
    (Subgroup.inclusion_injective (positiveRootTailSubgroup_le_positiveRootSubgroup hcard))

/-- The literal seven-factor product, in the inherited collection order. -/
def positiveRootTailWord {m : ℕ} (hcard : Nat.card F = 2 ^ (2 * m + 1))
    (u : Fin 4 → F) (v : Fin 3 → F × F) : Model F m :=
  positiveLongFactor hcard 0 (u 0) *
    (positiveShortFactor hcard 1 (v 0).1 (v 0).2 *
    (positiveLongFactor hcard 1 (u 1) *
    (positiveShortFactor hcard 2 (v 1).1 (v 1).2 *
    (positiveLongFactor hcard 2 (u 2) *
    (positiveShortFactor hcard 3 (v 2).1 (v 2).2 *
      positiveLongFactor hcard 3 (u 3))))))

private theorem tail_short_factor_zero {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) (k : Fin 4) :
    positiveShortFactor hcard k 0 0 = 1 := by
  have hz : shortRootParameters m hcard ((0 : F), 0) = 1 := by
    apply Subtype.ext
    change shortRootPairEquiv m hcard 0 0 = 1
    exact shortRootPairEquiv_zero m hcard
  change alternatingShortRootHom hcard k (shortRootParameters m hcard (0, 0)) = 1
  rw [hz, map_one]

/-- Insert a zero short-root pair at the head of the twelve-parameter word. -/
theorem positiveRootTailWord_eq_alternatingRootWord {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1))
    (u : Fin 4 → F) (v : Fin 3 → F × F) :
    positiveRootTailWord hcard u v =
      alternatingRootWord hcard u (Fin.cons (0, 0) v) := by
  rw [positiveRootWord_expand]
  change positiveRootTailWord hcard u v =
    positiveShortFactor hcard 0 0 0 * positiveRootTailWord hcard u v
  rw [tail_short_factor_zero, one_mul]

theorem positiveRootTailWord_injective {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    Function.Injective (fun p : (Fin 4 → F) × (Fin 3 → F × F) =>
      positiveRootTailWord hcard p.1 p.2) := by
  intro p q hpq
  have he : alternatingRootWord hcard p.1 (Fin.cons ((0 : F), 0) p.2) =
      alternatingRootWord hcard q.1 (Fin.cons ((0 : F), 0) q.2) :=
    (positiveRootTailWord_eq_alternatingRootWord hcard p.1 p.2).symm.trans
      (hpq.trans (positiveRootTailWord_eq_alternatingRootWord hcard q.1 q.2))
  have hparams := alternatingRootWord_parameters_injective hcard p.1 q.1
    (Fin.cons ((0 : F), 0) p.2) (Fin.cons ((0 : F), 0) q.2) he
  apply Prod.ext
  · exact hparams.1
  · funext i
    have hv := congrFun hparams.2 i.succ
    simpa only [Fin.cons_succ] using hv

/-- The literal tail word fills exactly the ordered tail product, before collection. -/
theorem positiveRootTailWord_range_eq_orderedProduct {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    Set.range (fun p : (Fin 4 → F) × (Fin 3 → F × F) =>
      positiveRootTailWord hcard p.1 p.2) =
      orderedSubgroupProduct ((positiveRootFactorList hcard).tail) := by
  change Set.range (fun p : (Fin 4 → F) × (Fin 3 → F × F) =>
    positiveRootTailWord hcard p.1 p.2) =
      orderedSubgroupProduct
        [(alternatingLongRootHom hcard 0).range,
         (alternatingShortRootHom hcard 1).range, (alternatingLongRootHom hcard 1).range,
         (alternatingShortRootHom hcard 2).range, (alternatingLongRootHom hcard 2).range,
         (alternatingShortRootHom hcard 3).range, (alternatingLongRootHom hcard 3).range]
  ext g
  constructor
  · rintro ⟨⟨u, v⟩, rfl⟩
    dsimp only [positiveRootTailWord]
    refine ⟨_, ⟨Multiplicative.ofAdd (u 0), rfl⟩, _, ?_, rfl⟩
    refine ⟨_, ⟨shortRootParameters m hcard (v 0), rfl⟩, _, ?_, rfl⟩
    refine ⟨_, ⟨Multiplicative.ofAdd (u 1), rfl⟩, _, ?_, rfl⟩
    refine ⟨_, ⟨shortRootParameters m hcard (v 1), rfl⟩, _, ?_, rfl⟩
    refine ⟨_, ⟨Multiplicative.ofAdd (u 2), rfl⟩, _, ?_, rfl⟩
    refine ⟨_, ⟨shortRootParameters m hcard (v 2), rfl⟩, _, ?_, rfl⟩
    exact ⟨_, ⟨Multiplicative.ofAdd (u 3), rfl⟩, 1,
      by simp [orderedSubgroupProduct], by simp⟩
  · intro hg
    rcases hg with ⟨l0, ⟨y0, rfl⟩, g1, h1, rfl⟩
    rcases h1 with ⟨s1, ⟨x1, rfl⟩, g2, h2, rfl⟩
    rcases h2 with ⟨l1, ⟨y1, rfl⟩, g3, h3, rfl⟩
    rcases h3 with ⟨s2, ⟨x2, rfl⟩, g4, h4, rfl⟩
    rcases h4 with ⟨l2, ⟨y2, rfl⟩, g5, h5, rfl⟩
    rcases h5 with ⟨s3, ⟨x3, rfl⟩, g6, h6, rfl⟩
    rcases h6 with ⟨l3, ⟨y3, rfl⟩, g7, h7, rfl⟩
    have h7' : g7 = 1 := h7
    subst g7
    obtain ⟨v0, rfl⟩ := (shortRootParameters m hcard).surjective x1
    obtain ⟨v1, rfl⟩ := (shortRootParameters m hcard).surjective x2
    obtain ⟨v2, rfl⟩ := (shortRootParameters m hcard).surjective x3
    refine ⟨(![y0.toAdd, y1.toAdd, y2.toAdd, y3.toAdd], ![v0, v1, v2]), ?_⟩
    simp only [positiveRootTailWord, mul_one] <;> rfl

theorem positiveRootTailWord_range_eq {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    Set.range (fun p : (Fin 4 → F) × (Fin 3 → F × F) =>
      positiveRootTailWord hcard p.1 p.2) =
      (positiveRootTailSubgroup hcard : Set (Model F m)) := by
  rw [positiveRootTailWord_range_eq_orderedProduct hcard,
    positiveRootTail_orderedProduct_eq hcard]

theorem positiveRootTailWord_mem {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1))
    (u : Fin 4 → F) (v : Fin 3 → F × F) :
    positiveRootTailWord hcard u v ∈ positiveRootTailSubgroup hcard := by
  change positiveRootTailWord hcard u v ∈ (positiveRootTailSubgroup hcard : Set (Model F m))
  rw [← positiveRootTailWord_range_eq hcard]
  exact ⟨(u, v), rfl⟩

/-- Ten independent field parameters for the actual tail subgroup. -/
def positiveRootTailParameters {m : ℕ} (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    ((Fin 4 → F) × (Fin 3 → F × F)) ≃ positiveRootTailSubgroup hcard :=
  (Equiv.ofInjective _ (positiveRootTailWord_injective hcard)).trans
    (Equiv.setCongr (positiveRootTailWord_range_eq hcard))

/-- Uniform tail order, including the binary field, from its actual normal form. -/
theorem card_positiveRootTailSubgroup {m : ℕ}
    (hcard : Nat.card F = 2 ^ (2 * m + 1)) :
    Nat.card (positiveRootTailSubgroup hcard) = (Nat.card F) ^ 10 := by
  rw [← Nat.card_congr (positiveRootTailParameters hcard)]
  simp only [Nat.card_prod, Nat.card_fun, Nat.card_fin]
  ring

end Atlas.ReeF4
