/-- E0,E1,F0,F1 in the existing octonion coordinate model. -/
def simpleMatrix (i : Fin 4) : Matrix (Fin 8) (Fin 8) ℤ :=
  fun r c => ((simpleTable[i.val]!)[r.val]!)[c.val]!

def simpleSecondMatrix (i : Fin 4) : Matrix (Fin 8) (Fin 8) ℤ :=
  fun r c => ((simpleSecondTable[i.val]!)[r.val]!)[c.val]!

/-- Candidate simple Geck matrices, to be identified with the actual operators. -/
def geckMatrix (i : Fin 4) : Matrix (Fin 14) (Fin 14) ℤ :=
  fun r c => ((geckTable[i.val]!)[r.val]!)[c.val]!

def geckSecondMatrix (i : Fin 4) : Matrix (Fin 14) (Fin 14) ℤ :=
  fun r c => ((geckSecondTable[i.val]!)[r.val]!)[c.val]!

def geckThirdMatrix (i : Fin 4) : Matrix (Fin 14) (Fin 14) ℤ :=
  fun r c => ((geckThirdTable[i.val]!)[r.val]!)[c.val]!

def basisCombination (v : Fin 14 → ℤ) : Matrix (Fin 8) (Fin 8) ℤ :=
  ∑ j : Fin 14, v j • basisMatrix j

end Atlas.Chevalley.Comparison.G2
