import Atlas.Sporadic.Janko1.Relations
import Mathlib.Algebra.Group.Conj
import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.GroupTheory.Index

/-!
Source-only candidate for the actual subgroup generated by P and Q.
The existing exact generator orders and Q P Q⁻¹ = P² give a unique
P^i Q^j normal form. No sign-group draft, J1 order, or simplicity is used.
This file has not been elaborated or verified.
-/
namespace Atlas.Janko1
open scoped Pointwise

def pqSubgroup : Subgroup (G2.Model Field) := Subgroup.closure {P, Q}

theorem P_mem_pqSubgroup : P ∈ pqSubgroup :=
  Subgroup.subset_closure (by simp)

theorem Q_mem_pqSubgroup : Q ∈ pqSubgroup :=
  Subgroup.subset_closure (by simp)

theorem pqSubgroup_le_H : pqSubgroup ≤ H := by
  apply (Subgroup.closure_le H).mpr
  intro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl
  · exact Subgroup.subset_closure (by simp)
  · exact Subgroup.subset_closure (by simp)

theorem pqSubgroup_eq_sup_zpowers :
    pqSubgroup = Subgroup.zpowers P ⊔ Subgroup.zpowers Q := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact (le_sup_left : Subgroup.zpowers P ≤
        Subgroup.zpowers P ⊔ Subgroup.zpowers Q) (Subgroup.mem_zpowers P)
    · exact (le_sup_right : Subgroup.zpowers Q ≤
        Subgroup.zpowers P ⊔ Subgroup.zpowers Q) (Subgroup.mem_zpowers Q)
  · exact sup_le (Subgroup.zpowers_le.mpr P_mem_pqSubgroup)
      (Subgroup.zpowers_le.mpr Q_mem_pqSubgroup)

theorem Q_mem_normalizer_zpowers_P :
    Q ∈ Subgroup.normalizer (Subgroup.zpowers P : Set (G2.Model Field)) := by
  apply Subgroup.mem_normalizer_fintype
  intro x hx
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  rw [← conj_zpow, Q_conjugates_P]
  exact (Subgroup.zpowers P).zpow_mem (Subgroup.npow_mem_zpowers P 2) n

theorem zpowers_Q_le_normalizer_zpowers_P :
    Subgroup.zpowers Q ≤
      Subgroup.normalizer (Subgroup.zpowers P : Set (G2.Model Field)) :=
  Subgroup.zpowers_le.mpr Q_mem_normalizer_zpowers_P

theorem zpowers_P_normal_in_pqSubgroup :
    ((Subgroup.zpowers P).subgroupOf pqSubgroup).Normal := by
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer
    (Subgroup.zpowers_le.mpr P_mem_pqSubgroup)).mpr
  rw [pqSubgroup_eq_sup_zpowers]
  exact sup_le (Subgroup.zpowers P).le_normalizer zpowers_Q_le_normalizer_zpowers_P

noncomputable def pPowerEquiv : Fin 7 ≃ Subgroup.zpowers P :=
  (finCongr orderOf_P.symm).trans (finEquivZPowers (isOfFinOrder_of_finite P))

noncomputable def qPowerEquiv : Fin 3 ≃ Subgroup.zpowers Q :=
  (finCongr orderOf_Q.symm).trans (finEquivZPowers (isOfFinOrder_of_finite Q))

theorem pPowerEquiv_apply (i : Fin 7) :
    (pPowerEquiv i : G2.Model Field) = P ^ i.val := rfl

theorem qPowerEquiv_apply (j : Fin 3) :
    (qPowerEquiv j : G2.Model Field) = Q ^ j.val := rfl

theorem card_zpowers_P : Nat.card (Subgroup.zpowers P) = 7 := by
  simpa only [Nat.card_fin] using (Nat.card_congr pPowerEquiv).symm

theorem card_zpowers_Q : Nat.card (Subgroup.zpowers Q) = 3 := by
  simpa only [Nat.card_fin] using (Nat.card_congr qPowerEquiv).symm

theorem disjoint_zpowers_P_Q : Disjoint (Subgroup.zpowers P) (Subgroup.zpowers Q) := by
  apply Subgroup.disjoint_of_coprime_natCard
  rw [card_zpowers_P, card_zpowers_Q]
  decide

/-- Actual multiplication of the two cyclic factors, not an abstract group model. -/
def pqMultiply (x : Subgroup.zpowers P × Subgroup.zpowers Q) : pqSubgroup :=
  ⟨(x.1 : G2.Model Field) * (x.2 : G2.Model Field),
    pqSubgroup.mul_mem
      ((Subgroup.zpowers_le.mpr P_mem_pqSubgroup) x.1.property)
      ((Subgroup.zpowers_le.mpr Q_mem_pqSubgroup) x.2.property)⟩

theorem pqMultiply_bijective : Function.Bijective pqMultiply := by
  constructor
  · intro x y hxy
    apply Subgroup.mul_injective_of_disjoint disjoint_zpowers_P_Q
    exact congrArg (fun z : pqSubgroup => (z : G2.Model Field)) hxy
  · intro g
    have hg : (g : G2.Model Field) ∈
        (Subgroup.zpowers P : Set (G2.Model Field)) *
          (Subgroup.zpowers Q : Set (G2.Model Field)) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left
        (Subgroup.zpowers P) (Subgroup.zpowers Q) zpowers_Q_le_normalizer_zpowers_P]
      rw [← pqSubgroup_eq_sup_zpowers]
      exact g.property
    obtain ⟨p, hp, q, hq, hpq⟩ := hg
    exact ⟨(⟨p, hp⟩, ⟨q, hq⟩), Subtype.ext hpq⟩

noncomputable def pqProductEquiv :
    (Subgroup.zpowers P × Subgroup.zpowers Q) ≃ pqSubgroup :=
  Equiv.ofBijective pqMultiply pqMultiply_bijective

noncomputable def pqNormalFormEquiv : (Fin 7 × Fin 3) ≃ pqSubgroup :=
  (Equiv.prodCongr pPowerEquiv qPowerEquiv).trans pqProductEquiv

theorem pqNormalFormEquiv_apply (ij : Fin 7 × Fin 3) :
    (pqNormalFormEquiv ij : G2.Model Field) = P ^ ij.1.val * Q ^ ij.2.val := rfl

theorem pq_normal_form (g : pqSubgroup) :
    ∃! ij : Fin 7 × Fin 3, P ^ ij.1.val * Q ^ ij.2.val = (g : G2.Model Field) := by
  refine ⟨pqNormalFormEquiv.symm g, ?_, ?_⟩
  · simpa only [pqNormalFormEquiv_apply] using
      congrArg (fun z : pqSubgroup => (z : G2.Model Field))
        (pqNormalFormEquiv.apply_symm_apply g)
  · intro ij hij
    apply pqNormalFormEquiv.injective
    have hij' : pqNormalFormEquiv ij = g := Subtype.ext (by
      simpa only [pqNormalFormEquiv_apply] using hij)
    exact hij'.trans (pqNormalFormEquiv.apply_symm_apply g).symm

theorem card_pqSubgroup : Nat.card pqSubgroup = 21 := by
  calc
    Nat.card pqSubgroup = Nat.card (Fin 7 × Fin 3) :=
      (Nat.card_congr pqNormalFormEquiv).symm
    _ = 21 := by rw [Nat.card_prod, Nat.card_fin, Nat.card_fin]

end Atlas.Janko1
