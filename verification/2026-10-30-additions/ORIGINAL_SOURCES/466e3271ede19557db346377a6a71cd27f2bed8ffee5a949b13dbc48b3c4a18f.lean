/-- E0,...,E3,F0,...,F3. F uses minus the old Wilson negative parameter. -/
def simpleMatrix (i : Fin 8) : Matrix (Fin 27) (Fin 27) ℤ :=
  fun r c => ((simpleTable[i.val]!)[r.val]!)[c.val]!

def simpleSecondMatrix (i : Fin 8) : Matrix (Fin 27) (Fin 27) ℤ :=
  fun r c => ((simpleSecondTable[i.val]!)[r.val]!)[c.val]!

/-- Candidate simple Geck matrices, to be identified with the actual operators. -/
def geckMatrix (i : Fin 8) : Matrix (Fin 52) (Fin 52) ℤ :=
  fun r c => ((geckTable[i.val]!)[r.val]!)[c.val]!

def geckSecondMatrix (i : Fin 8) : Matrix (Fin 52) (Fin 52) ℤ :=
  fun r c => ((geckSecondTable[i.val]!)[r.val]!)[c.val]!

def basisCombination (v : Fin 52 → ℤ) : Matrix (Fin 27) (Fin 27) ℤ :=
  ∑ j : Fin 52, v j • basisMatrix j

