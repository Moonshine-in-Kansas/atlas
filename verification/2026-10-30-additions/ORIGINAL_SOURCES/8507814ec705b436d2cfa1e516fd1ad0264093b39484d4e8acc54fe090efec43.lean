import FamilyWork.PositiveFixedOrder
import Atlas.LinearGroups.Chevalley.PositiveRootSubsetParameters
import Atlas.LinearGroups.Chevalley.PositiveRootWeylSubsetTransport

/-! The actual left inversion factor of an E6 Bruhat cell, and its full fixed part.

The existing cell convention uses positive roots made negative by w inverse.
We retain that convention and the existing `positiveRootSubsetSubgroup` carrier.
Compatible root homomorphisms have the same subgroup ranges as its chosen
root homomorphisms; no equality of their parameter markings is asserted.

If the actual Weyl root permutation commutes with the actual diagram, the
inversion set is diagram stable and its entire subgroup is twist stable.
The fixed carrier is the literal intersection with `companionFixedSubgroup`.
This file does not assert a fixed-point count, a fixed lift of w, or fixed
Bruhat generation. Exact staged verification receipts are separate. -/

noncomputable section
set_option backward.isDefEq.respectTransparency false
namespace Atlas.Chevalley.TwistedE6

/-- The actual root diagram preserves positivity in both directions. -/
theorem e6Inversion_rootDiagram_isPos_iff (β : E6Data.Root) :
    E6Data.base.IsPos (rootDiagram β) ↔ E6Data.base.IsPos β := by
  constructor
  · intro hβ
    have h := (e6PositiveRootDiagram ⟨rootDiagram β, hβ⟩).property
    rw [e6PositiveRootDiagram_root, rootDiagram_involutive] at h
    exact h
  · intro hβ
    have h := (e6PositiveRootDiagram ⟨β, hβ⟩).property
    rw [e6PositiveRootDiagram_root] at h
    exact h

/-- Exactly the root subset used for the left coordinate in the existing B*n(w)*B cell. -/
def e6CellInversionRoots (w : (rootDatum .E6).pairing.weylGroupToPerm.range) :
    Set {β : E6Data.Root // E6Data.base.IsPos β} :=
  RootData.positiveRootInversionSubset (rootDatum .E6).pairing (rootDatum .E6).base w⁻¹

theorem e6CellInversionRoots_coneClosed
    (w : (rootDatum .E6).pairing.weylGroupToPerm.range) :
    RootData.PositiveRootConeClosed (rootDatum .E6).pairing (rootDatum .E6).base
      (e6CellInversionRoots w) :=
  RootData.positiveRootConeClosed_inversionSubset
    (rootDatum .E6).pairing (rootDatum .E6).base w⁻¹

/-- Commutation is only an explicit condition on the actual root permutation.
No claim about generation of the diagram-fixed Weyl group enters this lemma. -/
theorem e6CellInversionRoots_diagram_iff
    (w : (rootDatum .E6).pairing.weylGroupToPerm.range)
    (hw : Commute w.val rootDiagram)
    (β : {β : E6Data.Root // E6Data.base.IsPos β}) :
    e6PositiveRootDiagram β ∈ e6CellInversionRoots w ↔ β ∈ e6CellInversionRoots w := by
  change (¬ E6Data.base.IsPos ((w⁻¹).val (e6PositiveRootDiagram β).val)) ↔
    ¬ E6Data.base.IsPos ((w⁻¹).val β.val)
  rw [e6PositiveRootDiagram_root]
  have hc : (w⁻¹).val (rootDiagram β.val) = rootDiagram ((w⁻¹).val β.val) :=
    congrArg (fun e : Equiv.Perm E6Data.Root => e β.val) hw.inv_left.eq
  rw [hc, e6Inversion_rootDiagram_isPos_iff]

section Companion

variable (K : Type*) [Field K]

/-- Range coherence identifies the actual compatible root subgroup with the
existing one. It does not identify the two scalar parametrizations. -/
theorem e6CompatiblePositiveRootHom_range
    (β : {β : E6Data.Root // E6Data.base.IsPos β}) :
    (e6CompatiblePositiveRootHom K β).range =
      positiveWeightCompanionRootSubgroup (rootDatum .E6).pairing (rootDatum .E6).base
        (selectedWeightOrbits .E6) (selectedWeightOrbits_closed .E6)
        (selectedWeightOrbits_minuscule .E6) K β :=
  rootLiftSubgroup_eq_positiveWeightCompanionRootSubgroup
    (rootDatum .E6).pairing (rootDatum .E6).base
    (selectedWeightOrbits .E6) (selectedWeightOrbits_closed .E6)
    (selectedWeightOrbits_minuscule .E6) K E6Data.simpleDiamondProducts β
    (e6CompatiblePositiveRootLift K β)

/-- A name for the exact existing left cell factor, with no new group carrier. -/
def e6CellInversionSubgroup (w : (rootDatum .E6).pairing.weylGroupToPerm.range) :
    Subgroup (SelectedWeightCompanion .E6 K) :=
  positiveRootSubsetSubgroup (rootDatum .E6).pairing (rootDatum .E6).base
    (selectedWeightOrbits .E6) (selectedWeightOrbits_closed .E6)
    (selectedWeightOrbits_minuscule .E6) K (e6CellInversionRoots w)

theorem e6CellInversionSubgroup_le_positive
    (w : (rootDatum .E6).pairing.weylGroupToPerm.range) :
    e6CellInversionSubgroup K w ≤ selectedWeightCompanionPositiveSubgroup .E6 K :=
  positiveRootSubsetSubgroup_le_witnessed
    (rootDatum .E6).pairing (rootDatum .E6).base
    (selectedWeightOrbits .E6) (selectedWeightOrbits_closed .E6)
    (selectedWeightOrbits_minuscule .E6) K (e6CellInversionRoots w)

/-- The same full subgroup is generated by the compatible root ranges. -/
theorem e6CellInversionSubgroup_eq_iSup_compatible
    (w : (rootDatum .E6).pairing.weylGroupToPerm.range) :
    e6CellInversionSubgroup K w =
      ⨆ β : e6CellInversionRoots w, (e6CompatiblePositiveRootHom K β.val).range := by
  simp only [e6CompatiblePositiveRootHom_range, e6CellInversionSubgroup,
    positiveRootSubsetSubgroup]

end Companion

variable (F K : Type*) [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]

/-- Covariance of compatible root ranges preserves the entire existing cell factor.
This is subgroup stability, not a generation theorem for its fixed points. -/
theorem e6CellInversionSubgroup_twist_mem
    (w : (rootDatum .E6).pairing.weylGroupToPerm.range)
    (hw : Commute w.val rootDiagram) (g : SelectedWeightCompanion .E6 K)
    (hg : g ∈ e6CellInversionSubgroup K w) :
    companionTwist F K g ∈ e6CellInversionSubgroup K w := by
  have hle : e6CellInversionSubgroup K w ≤
      (e6CellInversionSubgroup K w).comap (companionTwist F K).toMonoidHom := by
    refine (e6CellInversionSubgroup_eq_iSup_compatible K w).le.trans ?_
    apply iSup_le
    intro β
    rintro x ⟨t, rfl⟩
    change companionTwist F K (e6CompatiblePositiveRootHom K β.val t) ∈
      e6CellInversionSubgroup K w
    rw [e6CompatiblePositiveRootHom_twist K F]
    rw [e6CellInversionSubgroup_eq_iSup_compatible K w]
    apply Subgroup.mem_iSup_of_mem
      (⟨e6PositiveRootDiagram β.val,
        (e6CellInversionRoots_diagram_iff w hw β.val).mpr β.property⟩ : e6CellInversionRoots w)
    exact ⟨Multiplicative.ofAdd (Atlas.FiniteQuadratic.conjugation F K t.toAdd), rfl⟩
  exact hle hg

/-- Full fixed part of the inherited inversion subgroup, literally an intersection. -/
def e6CellInversionFixedSubgroup
    (w : (rootDatum .E6).pairing.weylGroupToPerm.range) :
    Subgroup (SelectedWeightCompanion .E6 K) :=
  e6CellInversionSubgroup K w ⊓ companionFixedSubgroup F K

theorem mem_e6CellInversionFixedSubgroup_iff
    (w : (rootDatum .E6).pairing.weylGroupToPerm.range) (g : SelectedWeightCompanion .E6 K) :
    g ∈ e6CellInversionFixedSubgroup F K w ↔
      g ∈ e6CellInversionSubgroup K w ∧ companionTwist F K g = g := Iff.rfl

theorem e6CellInversionFixedSubgroup_le_positiveFixed
    (w : (rootDatum .E6).pairing.weylGroupToPerm.range) :
    e6CellInversionFixedSubgroup F K w ≤ companionPositiveFixedSubgroup F K := by
  intro g hg
  exact ⟨e6CellInversionSubgroup_le_positive K w hg.1, hg.2⟩

end Atlas.Chevalley.TwistedE6
