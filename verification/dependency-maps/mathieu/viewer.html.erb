<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= data['group'] %> — proof dependency explorer</title>
<style>
*{box-sizing:border-box}body{margin:0;color:#23354f;background:#f5f7fb;font:14px system-ui,sans-serif;height:100vh;display:flex;flex-direction:column}header{padding:16px 22px 10px;background:#fff;border-bottom:1px solid #d9e1ec}h1{margin:0;font-size:24px}h2{font-size:17px;margin:12px 0}h3{font-size:14px}p{margin:7px 0;line-height:1.5;color:#586980}a{color:#285f9f}button,select,input{font:inherit;border:1px solid #bfccdc;border-radius:6px;background:#fff;color:#25476b;padding:7px 11px}button{cursor:pointer}button:hover{background:#edf3fb}button:focus-visible,a:focus-visible,summary:focus-visible,.node:focus-visible{outline:3px solid #e5a126;outline-offset:2px}button[aria-selected=true]{color:#fff;background:#2e659e;border-color:#2e659e}.bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px}.groups{margin-left:auto;display:flex;gap:12px}.groups a[aria-current=page]{font-weight:bold;text-decoration:none;color:#23354f}.muted{font-size:12px;color:#60728b}.tag{padding:3px 7px;border-radius:4px;background:#eaf3ff}.tag.simple{background:#f1edff}.tag.external{background:#fff5df}#workspace{flex:1;display:flex;min-height:0}main{flex:1;min-width:0;position:relative}.panel{height:100%;overflow:auto}#graph-panel{overflow:hidden}#canvas{height:100%;min-height:200px;touch-action:none;cursor:grab}svg{display:block;width:100%;height:100%}.edge{fill:none;stroke:#92a4bc;stroke-width:1.5;opacity:.6}.edge.shortcut{stroke-dasharray:4 5;opacity:.25}.node{cursor:pointer}.node rect{stroke:#658bb7;fill:#eef5ff;stroke-width:1.6}.node.simple rect{stroke:#9783b9;fill:#f3efff}.node.boundary rect{stroke:#b9904b;fill:#fff6e4;stroke-dasharray:6 4}.node.root rect{fill:#244b75;stroke:#244b75}.node.root text{fill:#fff}.node text{fill:#293f5c;pointer-events:none}.node.selected rect,.node.match rect{stroke:#d88b0b;stroke-width:3}.node.match rect{fill:#ffe7aa}.node.selected.root rect{fill:#244b75}.small{font-size:11px}.name{font-size:14px;font-weight:650}.number{font-size:12px}.dim{opacity:.12}.edge.focus{stroke:#286baa;stroke-width:2.8;opacity:1}#graph-tools{position:absolute;left:12px;top:12px;display:flex;gap:5px;background:#ffffffdf;padding:5px;border-radius:7px;z-index:1}aside{width:370px;flex:none;border-left:1px solid #d9e1ec;background:#fff;padding:16px;overflow:auto}aside code{font-size:12px;overflow-wrap:anywhere}aside ul{padding-left:18px}aside li{padding:7px 0;border-bottom:1px solid #eef1f7}#inspector-close{float:right}.decl-role{font-size:11px;color:#6f7d90}.tree{padding:16px 24px;margin:0}.tree ul{padding-left:23px}.tree li{list-style:none;border-left:1px solid #cfdae8;padding-left:12px;margin:5px 0}.tree summary{cursor:pointer;padding:6px}.tree button{padding:3px 7px;font-size:12px;margin-left:7px}.tree .ref{font-size:13px}.tree .target{background:#fff0ca}#tree-tools{padding:12px 22px 0}#files-panel{padding:16px 22px}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:9px;border-bottom:1px solid #dfe6f0;text-align:left}th{position:sticky;top:0;background:#f5f7fb}td.num,th.num{text-align:right}td button{padding:0;border:0;background:none;color:#285f9f;text-align:left;overflow-wrap:anywhere}.notice{padding:8px 22px;background:#fff;border-top:1px solid #d9e1ec;color:#60728b;font-size:12px}[hidden]{display:none!important}@media(max-width:850px){aside{position:absolute;right:0;top:0;bottom:0;z-index:3;width:min(90vw,370px);box-shadow:-4px 0 20px #20344b25}#workspace{position:relative}.groups{margin-left:0}h1{font-size:20px}}
</style></head><body>
<header>
<div class="bar" style="margin-top:0"><h1><%= data['group'] %> · Order &amp; simplicity</h1><nav class="groups" aria-label="Mathieu groups"><% GROUPS.each do |other| %><a href="../m<%=other%>/M<%=other%>.html" <%=other==g ? 'aria-current="page"' : ''%>>M<%=other%></a><%end%></nav></div>
<p id="stats"></p>
<div class="bar"><div role="tablist" aria-label="Display"><button id="tab-graph" role="tab" aria-controls="graph-panel" aria-selected="true" tabindex="0" data-tab="graph">Graph</button> <button id="tab-tree" role="tab" aria-controls="tree-panel" aria-selected="false" tabindex="-1" data-tab="tree">Tree</button> <button id="tab-files" role="tab" aria-controls="files-panel" aria-selected="false" tabindex="-1" data-tab="files">Files &amp; counts</button></div>
<label>Proof <select id="scope"><option value="all">Order + simplicity</option><option value="order">Order only</option><option value="simplicity">Simplicity only</option></select></label><input id="search" aria-label="Search file or group" placeholder="Find file or group…"><label><input id="all-arrows" type="checkbox"> All arrows</label><button id="csv">Download counts</button><button id="json">Download data</button><button id="about">About this map</button></div>
<div class="bar muted"><span class="tag">Order + simplicity / order</span><span class="tag simple">Simplicity only</span><span class="tag external">Reused group / foundation</span><span>Arrows → prerequisites · Select a box for exact declarations · Scroll to zoom; drag to pan</span></div>
</header>
<div id="workspace"><main>
<section id="graph-panel" class="panel" role="tabpanel" aria-labelledby="tab-graph"><div id="graph-tools"><button id="fit">Fit</button><button id="top">Readable view</button><button id="plus" aria-label="Zoom in">＋</button><button id="minus" aria-label="Zoom out">−</button><button id="clear">Clear highlight</button></div><div id="canvas"><svg xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Directed proof dependency graph"><defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10Z" fill="#8297b2"/></marker></defs><g id="edges"></g><g id="nodes"></g></svg></div></section>
<section id="tree-panel" class="panel" role="tabpanel" aria-labelledby="tab-tree" hidden><div id="tree-tools"><button id="expand">Expand all</button> <button id="collapse">Collapse all</button><p class="muted">Shared dependencies link to their first appearance. Reused groups are terminal nodes; select Details to see the exact results used.</p></div><ul id="tree" class="tree"></ul></section>
<section id="files-panel" class="panel" role="tabpanel" aria-labelledby="tab-files" hidden><p>Counts cover expanded source files only. Reused groups and shared foundations are excluded. Source totals count all named theorem/lemma commands in a file; compiled counts include generated helpers used in the selected proof.</p><table><thead><tr><th>Source file</th><th class="num">All named source theorems</th><th class="num">Used compiled theorems</th><th class="num">Used declarations</th></tr></thead><tbody id="file-rows"></tbody></table></section>
</main><aside id="inspector" hidden><button id="inspector-close" aria-label="Close details">×</button><div id="details"></div></aside></div>
<footer class="notice" id="footer"></footer>
<script id="data" type="application/json"><%=payload%></script>
<script>
'use strict';
const D=JSON.parse(document.getElementById('data').textContent),$=id=>document.getElementById(id),NS='http://www.w3.org/2000/svg';
const byId=new Map(D.nodes.map(n=>[n.id,n]));const ids=new Map(D.nodes.map((n,i)=>[n.id,'node-'+i]));let scope='all',active='graph',selected=null,shown=[],shownEdges=[],pos=new Map(),W=1200,H=800,box=[0,0,W,H];
const svg=document.querySelector('svg'),canvas=$('canvas');
function el(tag,text,cls){const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e}
function se(tag,attrs){const e=document.createElementNS(NS,tag);Object.entries(attrs||{}).forEach(([k,v])=>e.setAttribute(k,v));return e}
function roles(x){return x.order&&x.simplicity?'Order + simplicity':x.order?'Order':'Simplicity'}
function relevant(x){return scope==='all'||x[scope]}
function decls(n){return n.declarations.filter(relevant)}
function compiled(n){return decls(n).filter(d=>d.kind==='theorem').length}
function fileLink(path,text){const a=el('a',text||path);a.href='../../../'+path;return a}
function draw(){svg.setAttribute('viewBox',box.join(' '))}
function fit(){if(!canvas.clientHeight||!canvas.clientWidth)return;const ratio=canvas.clientWidth/canvas.clientHeight;let w=W,h=H;if(w/h<ratio)w=h*ratio;else h=w/ratio;box=[(W-w)/2,-30,w,h+60];draw()}
function readable(){if(!canvas.clientWidth)return;const w=Math.min(W+80,1450);box=[(W-w)/2,-15,w,w*canvas.clientHeight/canvas.clientWidth];draw()}
function zoom(f,x=.5,y=.5){const [a,b,w,h]=box,nw=Math.max(300,Math.min(W*4,w*f)),nh=nw*h/w;box=[a+(w-nw)*x,b+(h-nh)*y,nw,nh];draw()}
function renderGraph(){
 const red=shownEdges.filter(e=>e['reduced_'+scope]),parents=new Map(),children=new Map();
 shownEdges.forEach(e=>{if(!parents.has(e.to))parents.set(e.to,[]);parents.get(e.to).push(e.from)});
 const depth=new Map();function lev(id){if(depth.has(id))return depth.get(id);const p=parents.get(id)||[];const v=p.length?Math.max(...p.map(x=>lev(x)+1)):0;depth.set(id,v);return v}shown.forEach(n=>lev(n.id));
 const layers=[];shown.forEach(n=>(layers[depth.get(n.id)]||=([])).push(n.id));let order=new Map();layers.forEach(a=>a.forEach((id,i)=>order.set(id,i)));
 for(let sweep=0;sweep<6;sweep++)layers.forEach(a=>{const score=id=>{const ps=parents.get(id)||[];return ps.length?ps.reduce((s,p)=>s+order.get(p),0)/ps.length:order.get(id)};a.sort((a,b)=>score(a)-score(b));a.forEach((n,i)=>order.set(n,i))});
 const nw=365,nh=90,gap=28,stride=165;W=Math.max(900,Math.max(...layers.map(a=>a.length))*(nw+gap)+70);H=layers.length*stride+65;pos=new Map();layers.forEach((a,d)=>a.forEach((id,i)=>pos.set(id,[(W-a.length*(nw+gap))/2+i*(nw+gap),45+d*stride])));
 $('edges').replaceChildren();$('nodes').replaceChildren();
 ( $('all-arrows').checked?shownEdges:red).forEach(e=>{const [x,y]=pos.get(e.from),[xx,yy]=pos.get(e.to);let a=x+nw/2,b=y+nh,c=xx+nw/2,z=yy-4,m=(b+z)/2;const p=se('path',{d:`M${a},${b}C${a},${m} ${c},${m} ${c},${z}`,class:'edge'+(e['reduced_'+scope]?'':' shortcut'),'marker-end':'url(#arrow)'});p.dataset.from=e.from;p.dataset.to=e.to;$('edges').append(p)});
 shown.forEach(n=>{const [x,y]=pos.get(n.id),g=se('g',{class:'node '+n.kind+(!n.order&&n.simplicity?' simple':''),transform:`translate(${x} ${y})`,tabindex:0,role:'button','aria-label':n.label});g.dataset.id=n.id;g.append(se('rect',{width:nw,height:nh,rx:9}));
 const title=se('title');title.textContent=n.file||n.label;g.append(title);
 const text=(str,y,cls)=>{const t=se('text',{x:14,y,class:cls});t.textContent=str.length>51?str.slice(0,48)+'…':str;g.append(t)};
 text(n.kind==='root'?'Public theorem':n.kind==='boundary'?'EXTERNAL · proof not expanded':n.folder,20,'small');text(n.label,45,'name');
 text(n.kind==='file'?`${n.source_theorems} named · ${compiled(n)} used compiled`:n.kind==='boundary'?`${decls(n).length} exact reused declarations · ${roles(n)}`:roles(n),70,'number');
 g.onclick=()=>inspect(n.id);g.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();inspect(n.id)}};$('nodes').append(g)});
 highlight();readable();
}
function clear(){selected=null;highlight()}
function highlight(){const seen=new Set();if(selected&&byId.has(selected)){seen.add(selected);let change=true;while(change){change=false;shownEdges.forEach(e=>{if(seen.has(e.from)&&!seen.has(e.to)){seen.add(e.to);change=true}})}}document.querySelectorAll('.node').forEach(n=>{n.classList.toggle('dim',!!selected&&!seen.has(n.dataset.id));n.classList.toggle('selected',n.dataset.id===selected)});document.querySelectorAll('.edge').forEach(e=>{const yes=seen.has(e.dataset.from)&&seen.has(e.dataset.to);e.classList.toggle('dim',!!selected&&!yes);e.classList.toggle('focus',!!selected&&yes)})}
function detailsBase(title){$('inspector').hidden=false;$('details').replaceChildren(el('h2',title));return $('details')}
function inspect(id){const n=byId.get(id);selected=id;highlight();const p=detailsBase(n.label);p.append(el('p',roles(n),'muted'));
 if(n.kind==='file'){p.append(fileLink(n.file),el('p',`${n.source_theorems} named source theorems in the whole file; ${compiled(n)} compiled theorem declarations used in the selected scope. This includes generated helpers.`));}
 if(n.kind==='boundary'){p.append(el('p','Reused prerequisite. Its proofs are not expanded here. The declarations below specify precisely what is used; this does not assume all results about this group.'));
 if(/^M(24|23|22|12|11)$/.test(n.label)){const a=el('a','Open '+n.label+' diagram');a.href='../'+n.label.toLowerCase()+'/'+n.label+'.html';p.append(a)}}
 p.append(el('h3','Exact compiled declarations'));const ul=el('ul');decls(n).forEach(d=>{const li=el('li');li.append(el('code',d.name),el('div',`${d.kind} · ${roles(d)}`,'decl-role'),fileLink(d.file,'Source file'));ul.append(li)});p.append(ul);
}
function renderTree(){const root=$('tree');root.replaceChildren();const ch=new Map();shownEdges.filter(e=>e['reduced_'+scope]).forEach(e=>{if(!ch.has(e.from))ch.set(e.from,[]);ch.get(e.from).push(e.to)});const seen=new Set();
 function build(id,depth){const n=byId.get(id),li=el('li'),anchor='tree-'+ids.get(id);if(seen.has(id)){const a=el('a','↳ '+n.label+' (shared)');a.href='#'+anchor;a.className='ref';a.onclick=e=>{e.preventDefault();const target=$(anchor);for(let p=target.parentElement;p;p=p.parentElement)if(p.tagName==='DETAILS')p.open=true;document.querySelectorAll('.tree .target').forEach(x=>x.classList.remove('target'));target.classList.add('target');target.scrollIntoView({block:'center'})};li.append(a);return li}seen.add(id);li.id=anchor;const detail=el('details');detail.open=depth<2;const sum=el('summary',n.label+(n.kind==='file'?` — ${n.source_theorems} named; ${compiled(n)} compiled used`:n.kind==='boundary'?' — external dependency':''));const button=el('button','Details');button.onclick=e=>{e.preventDefault();inspect(id)};sum.append(button);detail.append(sum);if(n.kind==='boundary'){detail.append(el('p',`${decls(n).length} reused declarations; proofs not expanded.`,'muted'))}const ul=el('ul');(ch.get(id)||[]).sort().forEach(c=>ul.append(build(c,depth+1)));detail.append(ul);li.append(detail);return li}
 shown.filter(n=>n.kind==='root').forEach(n=>root.append(build(n.id,0)));
}
function renderFiles(){const q=$('search').value.toLowerCase(),body=$('file-rows');body.replaceChildren();shown.filter(n=>n.kind==='file'&&n.file.toLowerCase().includes(q)).sort((a,b)=>a.file.localeCompare(b.file)).forEach(n=>{const tr=el('tr'),td=el('td'),b=el('button',n.file);b.onclick=()=>inspect(n.id);td.append(b);tr.append(td);[n.source_theorems,compiled(n),decls(n).length].forEach(v=>tr.append(el('td',v,'num')));body.append(tr)})}
function update(){shown=D.nodes.filter(relevant);shownEdges=D.edges.filter(relevant);if(selected&&!shown.some(n=>n.id===selected))selected=null;const files=shown.filter(n=>n.kind==='file'),boundaries=shown.filter(n=>n.kind==='boundary');$('stats').textContent=`${files.length} expanded files · ${files.reduce((s,n)=>s+n.source_theorems,0)} named source theorems · ${boundaries.length} collapsed prerequisite packages`;renderGraph();renderTree();renderFiles();$('footer').textContent=`Actual compiled dependencies · Source-bound audit ${D.audit_date} · ${shownEdges.filter(e=>e['reduced_'+scope]).length} essential arrows / ${shownEdges.length} all arrows · No new Lean verification run`;if(selected)inspect(selected)}
function about(){const p=detailsBase('Scope and provenance');p.append(el('p','This map follows the actual compiled type/value dependencies of the two public theorems. Lean and mathlib are omitted. Definitions and instances participate in the traversal.'));
 p.append(el('p','Other Mathieu groups stop at named-module boundaries. Dodecad modules belong to M12; Golay/hexacode and reused M24 construction geometry are shared foundations. The M24 map expands that shared construction. Generic criteria and target-specific supporting files stay visible. Boundary nodes expose exact consumed declarations.'));
 p.append(el('p','M12 simplicity uses M11 simplicity, whereas M11 uses M12 structure/order/action—not M12 simplicity. Group names alone can suggest a cycle; the underlying declaration dependencies are acyclic.'));
 p.append(el('p','Named counts cover entire files, including private theorem/lemma commands. Used compiled counts also include generated proof helpers and may be larger. Counts overlap between groups; they must not be added. Collapsed prerequisites are excluded from local counts.'));
 p.append(el('p','Redundant shortcut arrows are hidden by default. All dependency paths are preserved, checked separately for both proofs and each individual proof. The tree uses these reduced edges; shared branches link to existing nodes.'));
 const a=el('a','Existing audit certificate');a.href='../../../'+D.audit_link;p.append(a,el('p',`Generated ${D.date}; checkout ${D.commit}. All ${D.full_closure_files} files in the complete ATLAS closure match the current evidence hashes. ${D.release_header_binding ? 'The historical dependency extraction matches after the verified release licence-header substitution; mathematical source is unchanged.' : 'They also match the dependency-audit snapshot exactly.'} No Lean proof recheck was performed.`));
 p.append(el('p','This file embeds all graph data and needs no network. Source links and links to other groups work when adjacent repository files are available.'));}
function search(){const q=$('search').value.toLowerCase();let first;document.querySelectorAll('.node').forEach(e=>{const n=byId.get(e.dataset.id),yes=!!q&&(n.file||n.label).toLowerCase().includes(q);e.classList.toggle('match',yes);if(yes&&!first)first=n});renderFiles();if(first&&active==='graph'){const [x,y]=pos.get(first.id),w=1300,h=w*canvas.clientHeight/canvas.clientWidth;box=[x+182-w/2,y+45-h/2,w,h];draw()}}
function tab(name,focus=false){active=name;document.querySelectorAll('[role=tab]').forEach(t=>{const yes=t.dataset.tab===name;t.setAttribute('aria-selected',yes);t.tabIndex=yes?0:-1;$(t.getAttribute('aria-controls')).hidden=!yes;if(yes&&focus)t.focus()});if(name==='graph')requestAnimationFrame(readable)}
const tabs=[...document.querySelectorAll('[role=tab]')];tabs.forEach((t,i)=>{t.onclick=()=>tab(t.dataset.tab);t.onkeydown=e=>{let j;if(e.key==='ArrowRight')j=(i+1)%3;else if(e.key==='ArrowLeft')j=(i+2)%3;else if(e.key==='Home')j=0;else if(e.key==='End')j=2;else return;e.preventDefault();tab(tabs[j].dataset.tab,true)}});
$('scope').onchange=e=>{scope=e.target.value;update();search()};$('all-arrows').onchange=()=>{renderGraph();search()};$('search').oninput=search;$('about').onclick=about;$('inspector-close').onclick=()=>$('inspector').hidden=true;$('fit').onclick=fit;$('top').onclick=readable;$('plus').onclick=()=>zoom(.75);$('minus').onclick=()=>zoom(1.33);$('clear').onclick=clear;$('expand').onclick=()=>document.querySelectorAll('#tree details').forEach(d=>d.open=true);$('collapse').onclick=()=>document.querySelectorAll('#tree details').forEach(d=>d.open=false);
canvas.addEventListener('wheel',e=>{e.preventDefault();const r=canvas.getBoundingClientRect();zoom(e.deltaY>0?1.12:.89,(e.clientX-r.left)/r.width,(e.clientY-r.top)/r.height)},{passive:false});let drag=null;canvas.onpointerdown=e=>{if(e.target.closest('.node'))return;drag=[e.clientX,e.clientY,...box];canvas.setPointerCapture(e.pointerId)};canvas.onpointermove=e=>{if(!drag)return;box=[drag[2]-(e.clientX-drag[0])*drag[4]/canvas.clientWidth,drag[3]-(e.clientY-drag[1])*drag[5]/canvas.clientHeight,drag[4],drag[5]];draw()};canvas.onpointerup=canvas.onpointercancel=()=>drag=null;
function download(name,text,type){const url=URL.createObjectURL(new Blob([text],{type})),a=el('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
$('json').onclick=()=>download(D.group+'-dependencies.json',JSON.stringify(D,null,2),'application/json');$('csv').onclick=()=>{const rows=[['file','named_source_theorems','used_compiled_theorems','used_declarations','scope'],...shown.filter(n=>n.kind==='file').map(n=>[n.file,n.source_theorems,compiled(n),decls(n).length,scope])];download(D.group+'-counts.csv',rows.map(r=>r.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\n'),'text/csv')};
window.addEventListener('resize',()=>{if(active==='graph')readable()});update();
</script></body></html>
