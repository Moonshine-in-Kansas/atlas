{
  "id": "family.B",
  "label": "B_n(q) / PΩ(2n+1,q)",
  "kind": "family",
  "audit_entry": "B",
  "proof_status": "construction_complete",
  "construction": "Actual scalar quotient of the Siegel-generated subgroup of the quadratic form Q(x,y,z)=sum x_i*y_i+z^2; identified with the determinant/spinor kernel in odd characteristic and the full orthogonal group in characteristic two",
  "parameters": "n is Lie rank, natural dimension 2*n+1; F arbitrary finite field, q=|F|; n>=1, every characteristic",
  "exceptions": "Nonsimple exactly (n,q)=(1,2),(1,3),(2,2); these actual groups remain constructed",
  "recognition": "No general recognition theorem or classification of family coincidences is claimed",
  "attribution": "ATLAS quadratic-form, Siegel, Wall/spinor and singular-line constructions; pinned mathlib finite-field and group infrastructure",
  "owner": "Gerald Höhn",
  "upstream_status": "No upstream acceptance claimed",
  "roles": {
    "model": {
      "declaration": "Atlas.Orthogonal.B",
      "source": "Atlas/LinearGroups/Orthogonal/BFamily.lean"
    },
    "finite": {
      "declaration": "Atlas.Orthogonal.B_finite",
      "source": "Atlas/LinearGroups/Orthogonal/BFamily.lean"
    },
    "order": {
      "declaration": "Atlas.Orthogonal.B_card_all_rank",
      "source": "Atlas/LinearGroups/Orthogonal/BAllRanks.lean",
      "formula": "q^(n*n) * product_(i=1)^n (q^(2*i)-1) / gcd(2,q-1)"
    },
    "simple": {
      "declaration": "Atlas.Orthogonal.B_simple_all_rank",
      "source": "Atlas/LinearGroups/Orthogonal/BAllRanksConstruction.lean"
    },
