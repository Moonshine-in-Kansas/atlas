   "Atlas/Rudvalis/CoordinateRowDozens.lean:3:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/--\nUnder the single reference exhaustion equality, each row-pair dozen is its three-row plane. -/\ntheorem coordinatePlaneSlice_dozen_eq_of_reference (hD : intrinsicDozen referenceCouple = referenceCoordinateDozen)\n    (p a : Point) (hap : dot a.val p.val = 0) (δ : Bit) :\n    intrinsicDozen (coordinatePlaneSlice p a δ) = coordinatePlaneDozen a := by\n  classical\n  apply Set.Subset.antisymm\n  · rintro x ⟨Q, hQ, hc, hx⟩\n    have hF : Q ⊆ coordinateFrame := by\n      intro y hy\n      exact\n        coordinateRow_couple_dozen_subset_of_reference hD p _ (coordinatePlaneSlice_isCouple p a hap δ)\n          (coordinatePlaneSlice_subset p a δ) ⟨Q, hQ, hc, hy⟩\n    obtain ⟨v, rfl⟩ := coordinateQuartet_classification Q hQ hF\n    obtain ⟨z, hz⟩ := dot_value_exists a δ\n    have hm := hc (show coordinateCross (p, z) ∈ coordinatePlaneSlice p a δ from ⟨z, hz, rfl⟩)\n    cases v with\n    | inl q =>\n      have hpq := (coordinateCross_mem_row_iff p q z).mp hm\n      subst q\n      exact ⟨p, hap, hx⟩\n    | inr v =>\n      have hp := (coordinatePlaneQuartetFromParameters_rows v p).mp ⟨_, hm, z, rfl⟩\n      have he : a = coordinateRowPairNormal v.1 :=\n        by\n        apply affine_plane_normal_unique a _ δ (v.2 ⟨p, hp⟩)\n        intro y hy\n        exact ((coordinatePlaneQuartetFromParameters_mem v.1 v.2 ⟨p, hp⟩ y).mp (hc ⟨y, hy, rfl⟩)).symm\n      obtain ⟨q, hq⟩ := hx\n      refine ⟨q.val, ?_, coordinatePlaneSlice_subset _ _ _ hq⟩\n      rw [he]\n      exact coordinateRowPairNormal_spec v.1 q.val q.prop\n  · rintro x ⟨q, hq, z, rfl⟩\n    by_cases hpq : p = q\n    · subst q\n      exact ⟨coordinateRowFrame p, coordinateRowFrame_isQuartet p, coordinatePlaneSlice_subset p a δ, z, rfl⟩\n    ·\n      exact\n        ⟨coordinatePlaneQuartet p q a δ (dot a.val z),\n          coordinatePlaneQuartet_isQuartet p q a hpq hap hq δ (dot a.val z), Set.subset_union_left,\n          Or.inr ⟨z, rfl, rfl⟩⟩`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
