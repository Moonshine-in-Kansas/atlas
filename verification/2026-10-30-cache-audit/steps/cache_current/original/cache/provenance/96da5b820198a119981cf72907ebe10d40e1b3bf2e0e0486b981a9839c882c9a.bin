   "Atlas/Rudvalis/CoordinateQuartetObstructions.lean:3:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/-- The forbidden (3,1) row pattern, stated without enumerating quartets. -/\ntheorem coordinateQuartet_not_three_one (p q : Point) (hpq : p ≠ q) (x : E) (Q : Set MinimalCross) (hQ : IsQuartet Q)\n    (hq : coordinateCross (q, x) ∈ Q) (hrest : ∀ z ∈ Q, z ≠ coordinateCross (q, x) → z ∈ coordinateRowFrame p) :\n    False :=\n  by\n  have sep : ∀ p q : Point, p ≠ q → ∃ a : Point, dot a.val p.val = 0 ∧ dot a.val q.val = 1 := by decide +kernel\n  obtain ⟨a, hap, haq⟩ := sep p q hpq\n  have hF : Q ⊆ coordinateFrame := by\n    intro z hz\n    by_cases he : z = coordinateCross (q, x)\n    · rw [he]\n      exact coordinateCross_mem _\n    · exact coordinateRowFrame_subset p (hrest z hz he)\n  apply coordinateQuartet_no_single_linear_label Q hQ hF a q x hq haq\n  intro z hz hne\n  obtain ⟨y, hy⟩ := hrest z hz hne\n  exact ⟨p, y, hy.symm, hap⟩`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
