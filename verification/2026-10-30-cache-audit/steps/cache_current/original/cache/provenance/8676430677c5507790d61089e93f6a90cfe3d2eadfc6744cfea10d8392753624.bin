   "Atlas/Rudvalis/ProjectiveCrossFaithful.lean:4:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/-- Strong scalar rigidity holds at every actual lattice cross. -/\ntheorem gaussian_perpendicular_kernel (x : MinimalCross) (g : gaussianLatticeGroup) (hx : g • x = x)\n    (hy : ∀ c : MinimalCross, CrossOrthogonal x c → g • c = c) : ∃ u : GaussianUnits, codeGaussianHom u.val = g :=\n  by\n  let := full_gaussian_cross_transitive\n  obtain ⟨a, ha⟩ := MulAction.exists_smul_eq gaussianLatticeGroup localReferenceCross x\n  have hf : (a⁻¹ * g * a) • localReferenceCross = localReferenceCross := by\n    rw [mul_smul, mul_smul, ha, hx, ← ha, inv_smul_smul]\n  have hh (c : MinimalCross) (hc : CrossOrthogonal localReferenceCross c) : (a⁻¹ * g * a) • c = c :=\n    by\n    rw [mul_smul, mul_smul, hy]\n    · exact inv_smul_smul a c\n    · rw [← ha]\n      exact (crossOrthogonal_gaussian a _ _).mpr hc\n  obtain ⟨u, hu⟩ := gaussian_reference_perpendicular_kernel (a⁻¹ * g * a) hf hh\n  have hs : codeGaussianHom u.val ∈ gaussianScalarSubgroup := ⟨u.val, u.prop, rfl⟩\n  have hc := Subgroup.mem_center_iff.mp (gaussianScalarSubgroup_le_center hs) a\n  refine ⟨u, ?_⟩\n  have he := congrArg (fun k : gaussianLatticeGroup => a * k * a⁻¹) hu\n  simpa only [← mul_assoc, mul_inv_cancel, one_mul, mul_assoc, inv_mul_cancel, mul_one, hc, mul_inv_cancel_left] using\n    he`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
