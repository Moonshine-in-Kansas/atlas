   "Atlas/Rudvalis/FourLocalSupports.lean:4:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/--\nThe point-fixing translations have two support orbits; Z joins their representatives. -/\ntheorem fourLocalConstants_translation (δ : Point → Bit) (hδ : ∀ p, dot (binaryLabel 1) p.val = 0 → δ p = 0)\n    (hs : (∑ p, δ p) = 1) :\n    ∃ b : Bool,\n      ∃ B : BinaryMatrix,\n        matrixAt B (rowLabel 0).val = 0 ∧\n          binaryNormalMap (δ, outerMatrix (binaryLabel 1) (binaryLabel 1), 0) =\n            binaryNormalMap (fourLocalBaseConstants b, outerMatrix (binaryLabel 1) (binaryLabel 1), 0) ∘\n              coordinateTranslation B :=\n  by\n  let b : Bool := decide (δ (rowLabel 1) + δ (rowLabel 3) = 0)\n  let ε := fourLocalBaseConstants b\n  have he :\n    (∀ p, dot (binaryLabel 1) p.val = 0 → ε p = 0) ∧\n      (∑ p, ε p) = 1 ∧ ε (rowLabel 1) + ε (rowLabel 3) = (if b then 0 else 1) :=\n    fourLocalBaseConstants_data b\n  have heq : δ (rowLabel 1) + δ (rowLabel 3) = ε (rowLabel 1) + ε (rowLabel 3) :=\n    by\n    rw [he.2.2]\n    have hb : ∀ a : Bit, a = (if decide (a = 0) then 0 else 1) := by decide +kernel\n    exact hb _\n  have hz : ∀ p, dot (binaryLabel 1) p.val = 0 → (δ + ε) p = 0 :=\n    by\n    intro p hp\n    simp [hδ p hp, he.1 p hp]\n  have hsum : (∑ p, (δ + ε) p) = 0 :=\n    by\n    simp only [Pi.add_apply, Finset.sum_add_distrib, hs, he.2.1]\n    decide +kernel\n  let a : Point := ⟨binaryLabel 1, by decide +kernel⟩\n  obtain ⟨u, hu⟩ := even_active_linear_restriction a (δ + ε) hz hsum\n  have h1 := hu (rowLabel 1) (by decide +kernel)\n  have h3 := hu (rowLabel 3) (by decide +kernel)\n  have hp : dot u (rowLabel 0).val = 0 :=\n    by\n    rw [show (rowLabel 0).val = (rowLabel 1).val + (rowLabel 3).val from by decide +kernel, dot_add_right, ← h1, ← h3]\n    change (δ (rowLabel 1) + ε (rowLabel 1)) + (δ (rowLabel 3) + ε (rowLabel 3)) = 0\n    calc\n      _ = (δ (rowLabel 1) + δ (rowLabel 3)) + (ε (rowLabel 1) + ε (rowLabel 3)) := by ring\n      _ = 0 := by rw [heq, CharTwo.add_self_eq_zero]\n  let B := outerMatrix (binaryLabel 1) u\n  refine ⟨b, B, ?_, ?_⟩\n  · rw [matrixAt_outer, hp, zero_smul]\n  · funext q\n    rcases q with ⟨p, x⟩\n    change\n      δ p + dot (matrixAt (outerMatrix (binaryLabel 1) (binaryLabel 1)) p.val) x + theta p 0 x =\n        ε p + dot (matrixAt (outerMatrix (binaryLabel 1) (binaryLabel 1)) p.val) (x + matrixAt B p.val) +\n          theta p 0 (x + matrixAt B p.val)\n    have haa : dot (binaryLabel 1) (binaryLabel 1) = 1 := by decide +kernel\n    simp only [B, theta_zero_parameter, add_zero, matrixAt_outer, dot_smul_left, dot_add_right, dot_smul_right, haa,\n      mul_one]\n    rcases Atlas.Codes.bit_cases (dot (binaryLabel 1) p.val) with h | h\n    · simp [h, hδ p h, he.1 p h]\n    · have hd := hu p h\n      change δ p + ε p = dot u p.val at hd\n      rw [h, one_mul, mul_one, ← hd]\n      have hh : ∀ a b c : Bit, a + c = b + (c + (a + b)) := by decide +kernel\n      exact hh _ _ _`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
