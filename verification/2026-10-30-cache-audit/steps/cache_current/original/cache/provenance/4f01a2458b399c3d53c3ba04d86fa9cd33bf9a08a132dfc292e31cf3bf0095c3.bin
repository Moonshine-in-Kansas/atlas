  {"message":
   "Atlas/LinearGroups/ReeF4/SpecialLeadingExistence.lean:4:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/-- Every intrinsic special vector has one of exactly the eight allowed\nleading root labels, with every higher coordinate zero. -/\ntheorem IsSpecialVector.exists_allowed_leading_root {m : ℕ} (hcard : Nat.card F = 2 ^ (2 * m + 1)) {u : TraceZero F}\n    (hu : IsSpecialVector m u) :\n    ∃ r : Fin 26,\n      allowedSpecialLeadingRoot r ∧\n        isotropyCoordinates u r ≠ 0 ∧\n          ∀ j, specialAbsoluteGrade r < specialAbsoluteGrade j → isotropyCoordinates u j = 0 :=\n  by\n  classical\n  let s : Finset (Fin 26) := Finset.univ.filter (fun i => isotropyCoordinates u i ≠ 0)\n  have hs : s.Nonempty := by\n    by_contra he\n    have hz : isotropyCoordinates u = 0 := by\n      funext i\n      by_contra hi\n      exact he ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩\n    apply hu.ne_zero\n    calc\n      u = isotropyPoint (isotropyCoordinates u) := (isotropyPoint_coordinates u).symm\n      _ = isotropyPoint (isotropyCoordinates (0 : TraceZero F)) := by rw [hz, _root_.map_zero]\n      _ = 0 := isotropyPoint_coordinates 0\n  obtain ⟨r, hr, hmax⟩ := Finset.exists_max_image s specialAbsoluteGrade hs\n  have hn : isotropyCoordinates u r ≠ 0 := (Finset.mem_filter.mp hr).2\n  have hz : ∀ j, specialAbsoluteGrade r < specialAbsoluteGrade j → isotropyCoordinates u j = 0 :=\n    by\n    intro j hj\n    by_contra hne\n    exact (not_lt_of_ge (hmax j (Finset.mem_filter.mpr ⟨Finset.mem_univ j, hne⟩))) hj\n  have hrroot : 2 ≤ r.val := by\n    by_contra h\n    have hi : r = 0 ∨ r = 1 := by\n      have hv : r.val = 0 ∨ r.val = 1 := by omega\n      rcases hv with hv | hv\n      · exact Or.inl (Fin.ext hv)\n      · exact Or.inr (Fin.ext hv)\n    have hg : specialAbsoluteGrade r = 0 := by rcases hi with rfl | rfl <;> rfl\n    have hd := hu.diagonal_zero_of_no_positive (by simpa only [hg] using hz)\n    rcases hi with rfl | rfl\n    · exact hn hd.1\n    · exact hn hd.2\n  exact ⟨r, hu.leading_root_allowed hcard r hrroot hn hz, hn, hz⟩`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
