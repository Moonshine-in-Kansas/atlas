   "Atlas/Rudvalis/CoordinatePlaneQuartets.lean:3:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `theorem coordinateQuartet_of_minimumWord_counts (Q : Set MinimalCross)\n    (hQ : Q ⊆ coordinateFrame) (h4 : Nat.card Q = 4)\n    (hcounts :\n      ∀ w : MinimumWords, Nat.card { c : Q // CrossOrthogonal (minimalCross (minimumWordShellLift w)) c.val } ≠ 3) :\n    IsQuartet Q := by\n  classical\n  refine ⟨h4, ?_, ?_⟩\n  · intro x hx y hy hxy\n    exact (coordinateFrame_orthogonal_iff _ _ (hQ hx) (hQ hy)).mpr hxy\n  · intro x hx q hq hall\n    induction x using Quotient.inductionOn with\n    | h v =>\n      rcases rudvalisLattice_shell_cases v.val.val v.val.prop v.prop with hv | ⟨w, hw⟩\n      · have hvf : minimalCross v ∈ coordinateFrame :=\n          (minimalCross_mem_coordinateFrame v).mpr ((coordinateShellPiece_iff v).mpr hv)\n        exact\n          (coordinateFrame_orthogonal_iff _ _ hvf (hQ hq)).mpr\n            (by intro he; apply hx; change minimalCross v ∈ Q; rwa [he])\n      · have he : v = minimumWordShellLift w := Subtype.ext (Subtype.ext hw)\n        subst v\n        by_contra hnq\n        have heq (y : Q) : CrossOrthogonal (minimalCross (minimumWordShellLift w)) y.val ↔ ¬y.val = q :=\n          by\n          constructor\n          · intro hy hyq\n            exact hnq (hyq ▸ hy)\n          · intro hy\n            exact hall y.val y.prop hy\n        let e :\n          { y : Q // CrossOrthogonal (minimalCross (minimumWordShellLift w)) y.val } ≃ { y : Q // ¬y = ⟨q, hq⟩ } :=\n          Equiv.subtypeEquivRight\n            (fun y =>\n              (heq y).trans\n                (not_congr\n                  (show y.val = q ↔ y = ⟨q, hq⟩ from ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩)))\n        apply hcounts w\n        let : Fintype Q := Fintype.ofFinite _\n        rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_subtype_compl]\n        have hc : Fintype.card Q = 4 := by simpa [Nat.card_eq_fintype_card] using h4\n        simp [hc]`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
