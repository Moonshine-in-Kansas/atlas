   "Atlas/Rudvalis/FrameMatrixDifferences.lean:4:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/--\nConjugation differences and the scalar identity span every three-by-three binary matrix. -/\ntheorem binaryMatrix_differences_scalar_span (W : Submodule Bit BinaryMatrix) (hI : (1 : BinaryMatrix) ∈ W)\n    (hD : ∀ i j : Fin 3, i ≠ j → ∀ A : BinaryMatrix, binaryMatrixDifference i j A ∈ W) : W = ⊤ :=\n  by\n  have hoff (i j : Fin 3) (hij : i ≠ j) : binaryMatrixUnit i j ∈ W :=\n    by\n    rw [← binaryMatrixDifference_offdiagonal i j hij]\n    exact hD i j hij _\n  have hdiag (i j : Fin 3) (hij : i ≠ j) : binaryMatrixUnit i i + binaryMatrixUnit j j ∈ W :=\n    by\n    have h := W.add_mem (hD i j hij (binaryMatrixUnit j i)) (hoff i j hij)\n    have hz : binaryMatrixUnit i j + binaryMatrixUnit i j = 0 := by ext r s; exact CharTwo.add_self_eq_zero _\n    rw [binaryMatrixDifference_diagonal i j hij, add_assoc, hz, add_zero] at h\n    exact h\n  have hunit (i j : Fin 3) : binaryMatrixUnit i j ∈ W :=\n    by\n    by_cases hij : i = j\n    · subst j\n      obtain ⟨j, hji⟩ := exists_ne i\n      obtain ⟨k, hki, hkj⟩ := Fin.exists_ne_and_ne_of_two_lt i j (by decide)\n      have he :\n        binaryMatrixUnit i i =\n          1 + (binaryMatrixUnit i i + binaryMatrixUnit j j) + (binaryMatrixUnit i i + binaryMatrixUnit k k) :=\n        by\n        have cert :\n          ∀ i j k : Fin 3,\n            j ≠ i →\n              k ≠ i →\n                k ≠ j →\n                  binaryMatrixUnit i i =\n                    1 + (binaryMatrixUnit i i + binaryMatrixUnit j j) + (binaryMatrixUnit i i + binaryMatrixUnit k k) :=\n          by decide +kernel\n        exact cert i j k hji hki hkj\n      rw [he]\n      exact W.add_mem (W.add_mem hI (hdiag i j hji.symm)) (hdiag i k hki.symm)\n    · exact hoff i j hij\n  apply Submodule.eq_top_iff'.mpr\n  intro M\n  rw [← binaryMatrix_single_expansion M]\n  exact W.sum_mem (fun i _ => W.sum_mem (fun j _ => W.smul_mem _ (hunit i j)))`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
