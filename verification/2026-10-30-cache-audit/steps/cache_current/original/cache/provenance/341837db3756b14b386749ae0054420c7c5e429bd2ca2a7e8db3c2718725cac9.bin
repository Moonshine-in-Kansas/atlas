   "Atlas/Rudvalis/CoordinateTwoRowRigidity.lean:3:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/--\nAny external test cross with exactly one supported member contradicts quartet closure. -/\ntheorem quartet_pair_test_obstruction (Q : Set MinimalCross) (hQ : IsQuartet Q) (u v a b w : MinimalCross) (hu : u ∈ Q)\n    (hv : v ∈ Q) (hw : w ∉ Q) (hpair : CrossOrthogonal w u ↔ ¬CrossOrthogonal w v) (ha : CrossOrthogonal w a)\n    (hb : CrossOrthogonal w b) (hrest : ∀ z ∈ Q, z ≠ u → z ≠ v → z = a ∨ z = b) : False := by\n  classical\n  by_cases ho : CrossOrthogonal w u\n  · apply hpair.mp ho\n    apply hQ.2.2 w hw v hv\n    intro z hz hzv\n    by_cases hzu : z = u\n    · rwa [hzu]\n    rcases hrest z hz hzu hzv with h | h <;> rw [h] <;> assumption\n  · apply ho\n    apply hQ.2.2 w hw u hu\n    intro z hz hzu\n    by_cases hzv : z = v\n    · rw [hzv]\n      by_contra hnv\n      exact ho (hpair.mpr hnv)\n    rcases hrest z hz hzu hzv with h | h <;> rw [h] <;> assumption`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
