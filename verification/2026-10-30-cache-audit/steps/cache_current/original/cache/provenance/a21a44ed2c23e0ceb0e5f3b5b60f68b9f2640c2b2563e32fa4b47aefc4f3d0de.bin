   "Atlas/Rudvalis/CoupleSupportTranslations.lean:4:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/--\nEqual affine-plane parity permits a translation fixing the entire reference row. -/\ntheorem four_support_pair_fixed_translation (a p₀ r s : Point) (hr : dot a.val r.val = 1) (hs : dot a.val s.val = 1)\n    (hrs : r.val + s.val = p₀.val) (ε δ : Point → Bit) (hε : ∀ p, dot a.val p.val = 0 → ε p = 0)\n    (hδ : ∀ p, dot a.val p.val = 0 → δ p = 0) (hpar : (∑ p, ε p) = (∑ p, δ p)) (hpair : ε r + ε s = δ r + δ s) :\n    ∃ B : BinaryMatrix,\n      matrixAt B p₀.val = 0 ∧\n        binaryNormalMap (δ, outerMatrix a.val a.val, 0) =\n          binaryNormalMap (ε, outerMatrix a.val a.val, 0) ∘ coordinateTranslation B :=\n  by\n  have hz : ∀ p, dot a.val p.val = 0 → (δ + ε) p = 0 := by intro p hp; simp [hε p hp, hδ p hp]\n  have he : (∑ p, (δ + ε) p) = 0 := by simp only [Pi.add_apply, Finset.sum_add_distrib, hpar, CharTwo.add_self_eq_zero]\n  obtain ⟨u, hu⟩ := even_active_linear_restriction a (δ + ε) hz he\n  have hp : dot u p₀.val = 0 := by\n    rw [← hrs, dot_add_right, ← hu r hr, ← hu s hs]\n    change (δ r + ε r) + (δ s + ε s) = 0\n    calc\n      _ = (δ r + δ s) + (ε r + ε s) := by ring\n      _ = 0 := by rw [hpair, CharTwo.add_self_eq_zero]\n  obtain ⟨i, hi⟩ := point_has_one a\n  let z := (basisPoint i).val\n  have haz : dot a.val z = 1 := by rw [dot_comm, dot_basisPoint]; exact hi\n  refine ⟨outerMatrix z u, ?_, ?_⟩\n  · rw [matrixAt_outer, hp, zero_smul]\n  · funext q\n    rcases q with ⟨p, x⟩\n    change\n      δ p + dot (matrixAt (outerMatrix a.val a.val) p.val) x + theta p 0 x =\n        ε p + dot (matrixAt (outerMatrix a.val a.val) p.val) (x + matrixAt (outerMatrix z u) p.val) +\n          theta p 0 (x + matrixAt (outerMatrix z u) p.val)\n    simp only [theta_zero_parameter, add_zero, matrixAt_outer, dot_smul_left, dot_add_right, dot_smul_right, haz,\n      mul_one]\n    rcases Atlas.Codes.bit_cases (dot a.val p.val) with hp | hp\n    · simp [hp, hε p hp, hδ p hp]\n    · have hd := hu p hp\n      change δ p + ε p = dot u p.val at hd\n      rw [hp, one_mul, mul_one, ← hd]\n      have hh : ∀ a b c : Bit, a + c = b + (c + (a + b)) := by decide +kernel\n      exact hh _ _ _`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
