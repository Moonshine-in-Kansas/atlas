   "Atlas/Rudvalis/CoupleQuartetOrbit.lean:3:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/--\nThe four non-row coordinate quartets through the reference couple form one actual stabilizer orbit. -/\ntheorem referenceCoordinateQuartets_nonrow_transitive (Q R : Set MinimalCross) (hQ : IsQuartet Q) (hR : IsQuartet R)\n    (hQF : Q ⊆ coordinateFrame) (hRF : R ⊆ coordinateFrame) (hcQ : referenceCouple ⊆ Q) (hcR : referenceCouple ⊆ R)\n    (hneQ : Q ≠ coordinateRowFrame (rowLabel 0)) (hneR : R ≠ coordinateRowFrame (rowLabel 0)) :\n    ∃ g : codeCoupleStabilizer, (fun c : MinimalCross => g.val • c) '' Q = R :=\n  by\n  obtain ⟨c, hc, hcn⟩ := referenceCoordinateQuartet_outside_row Q hQ hneQ\n  obtain ⟨d, hd, hdn⟩ := referenceCoordinateQuartet_outside_row R hR hneR\n  have hcD : c ∈ referenceCoordinateDozen := reference_quartet_coordinate_member_in_dozen Q hQ hcQ c hc (hQF hc)\n  have hdD : d ∈ referenceCoordinateDozen := reference_quartet_coordinate_member_in_dozen R hR hcR d hd (hRF hd)\n  obtain ⟨g, hg⟩ := couple_coordinate_dozen_other_rows_transitive c d ⟨hcD, hcn⟩ ⟨hdD, hdn⟩\n  refine ⟨g, ?_⟩\n  let S := (fun c : MinimalCross => g.val • c) '' Q\n  have hS : IsQuartet S := by\n    simpa only [S, gaussianImage, codeGaussianHom_cross] using\n      (isQuartet_gaussianImage (codeGaussianHom g.val) Q).mpr hQ\n  have hSF : S ⊆ coordinateFrame := by\n    rintro z ⟨w, hw, rfl⟩\n    exact coordinateFrame_code_stable g.val w (hQF hw)\n  have hcS : referenceCouple ⊆ S := by\n    intro z hz\n    refine ⟨z, hcQ hz, ?_⟩\n    rcases hz with rfl | rfl\n    · exact g.prop.1\n    · exact g.prop.2\n  exact referenceCoordinateQuartet_unique_outside_row S R hS hR hSF hRF hcS hcR d hdn ⟨c, hc, hg⟩ hd`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
