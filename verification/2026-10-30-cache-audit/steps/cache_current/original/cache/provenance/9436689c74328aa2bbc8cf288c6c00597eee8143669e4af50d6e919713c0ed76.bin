   "Atlas/LinearGroups/ReeF4/SpecialFourthPivot.lean:5:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/-- A genuine extra reduction case, without assuming that inner-root leading\ncoordinates are impossible. It lowers grade5 to at most4 and retains C−1≠0. -/\ntheorem specialVector_C2_strict_descent {m : ℕ} (hcard : Nat.card F = 2 ^ (2 * m + 1)) {u : TraceZero F}\n    (hu : IsSpecialVector m u) (hA4 : u.val.2 0 7 = 0) (hC4 : u.val.2 2 7 = 0) (hB4 : u.val.2 1 7 = 0)\n    (hB3 : u.val.2 1 6 = 0) (hC3 : u.val.2 2 6 = 0) (hB2 : u.val.2 1 5 = 0) (hA3 : u.val.2 0 6 = 0)\n    (hC2 : u.val.2 2 5 ≠ 0) :\n    let z := (fourthPivotDescent hcard u).val u\n    IsSpecialVector m z ∧\n      z.val.2 0 7 = 0 ∧\n        z.val.2 2 7 = 0 ∧\n          z.val.2 1 7 = 0 ∧\n            z.val.2 1 6 = 0 ∧\n              z.val.2 2 6 = 0 ∧\n                z.val.2 1 5 = 0 ∧ z.val.2 0 6 = 0 ∧ z.val.2 2 5 = 0 ∧ z.val.2 2 3 = u.val.2 2 5 ∧ z.val.2 2 3 ≠ 0 :=\n  by\n  let w := (fourthPivot hcard u).val u\n  have hwa : w.val.2 0 7 = 0 := hA4\n  have hwc4 : w.val.2 2 7 = 0 := hC4\n  have hwb4 : w.val.2 1 7 = 0 := by\n    change u.val.2 1 7 + fourthPivotA m u * u.val.2 2 7 = 0\n    simp only [hB4, hC4, mul_zero, add_zero]\n  have hwb3 : w.val.2 1 6 = 0 :=\n    by\n    change (u.val.2 1 6 + fourthPivotB u * u.val.2 2 7) + theta F m (fourthPivotA m u) * u.val.2 1 7 = 0\n    simp only [hB3, hB4, hC4, mul_zero, add_zero]\n  have hwc3 : w.val.2 2 6 = 0 :=\n    by\n    change\n      (u.val.2 2 6 + fourthPivotB u * u.val.2 1 7 + theta F m (fourthPivotB u) * u.val.2 2 7) +\n              fourthPivotA m u * (u.val.2 1 6 + fourthPivotB u * u.val.2 2 7) +\n            fourthPivotA m u * theta F m (fourthPivotA m u) * u.val.2 1 7 +\n          (fourthPivotA m u) ^ 2 * theta F m (fourthPivotA m u) * u.val.2 2 7 =\n        0\n    simp only [hC3, hB3, hB4, hC4, mul_zero, zero_add, add_zero]\n  have hwb1 : w.val.2 1 4 = 0 := fourthPivot_B1_zero hcard u hB2 hC2\n  have hwcm1 : w.val.2 2 3 = 0 := fourthPivot_Cminus1_zero hcard u hB2 hC2\n  have hwc2 : w.val.2 2 5 = u.val.2 2 5 :=\n    by\n    change u.val.2 2 5 + fourthPivotA m u * u.val.2 1 5 = u.val.2 2 5\n    rw [hB2, mul_zero, add_zero]\n  refine ⟨hu.map_model (fourthPivotDescent hcard u), hwa, hwc3, hwb3, hwb4, hwc4, hwb1, hA3, hwcm1, hwc2, ?_⟩\n  change w.val.2 2 5 ≠ 0\n  rw [hwc2]\n  exact hC2`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
