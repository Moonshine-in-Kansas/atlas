   "Atlas/Rudvalis/HeavySignTransitivity.lean:4:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `theorem heavy_signedLift_sign_transitive (d : BinaryWord)\n    (hd : hasNonzeroQuadraticPart d) (hd16 : hammingNorm d = 16) (v w : SignedLift quaternaryCode d) :\n    ∃ k : codeGroup, k.val.right = 1 ∧ monomialHom k.val v.val.val = w.val.val :=\n  by\n  obtain ⟨a, hc, ha⟩ := hd\n  obtain ⟨p, hp⟩ := heavySupport_seed_orbit a.1 a.2.1 a.2.2 hc (ha ▸ hd16)\n  have hr : d = heavySeedResidue ∘ p.val := ha.symm.trans hp\n  obtain ⟨g, hg⟩ := codePermutationHom_surjective p⁻¹\n  have he : g.val.right = p.val⁻¹ := congrArg Subtype.val hg\n  have hr2 : d = heavySeedResidue ∘ g.val.right.symm := by rw [he]; exact hr\n  clear ha hr\n  subst d\n  let e := signedLiftActionEquiv g heavySeedResidue\n  obtain ⟨s, hs⟩ := heavySeed_signedLift_sign_transitive (e.symm v) (e.symm w)\n  let h : codeGroup := ⟨SemidirectProduct.inl (Multiplicative.ofAdd s.val), (codeGroup_sign_mem s.val).mpr s.prop⟩\n  have hh : monomialHom h.val (e.symm v).val.val = (e.symm w).val.val := hs\n  refine ⟨g * h * g⁻¹, ?_, ?_⟩\n  · change g.val.right * 1 * g.val.right⁻¹ = 1\n    simp\n  · have hv : monomialHom g.val (e.symm v).val.val = v.val.val := congrArg (fun u => u.val.val) (e.apply_symm_apply v)\n    have hw : monomialHom g.val (e.symm w).val.val = w.val.val := congrArg (fun u => u.val.val) (e.apply_symm_apply w)\n    change monomialHom (g.val * h.val * g.val⁻¹) v.val.val = w.val.val\n    rw [map_mul, map_mul]\n    change monomialHom g.val (monomialHom h.val (monomialHom g.val⁻¹ v.val.val)) = w.val.val\n    rw [← hv]\n    simp only [map_inv]\n    change\n      monomialHom g.val (monomialHom h.val ((monomialHom g.val).symm (monomialHom g.val (e.symm v).val.val))) =\n        w.val.val\n    rw [LinearEquiv.symm_apply_apply]\n    rw [hh, hw]`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
