   "Atlas/Rudvalis/CoordinateTripleFrame.lean:3:0: The module doc-string for a file should be the first command after the imports.\nPlease, add a module doc-string before `/--\nThe same triple-in-frame principle holds in every actual Gaussian translate. -/\ntheorem quartet_three_in_gaussian_coordinateFrame (g : gaussianLatticeGroup) (Q : Set MinimalCross) (hQ : IsQuartet Q)\n    (w : MinimalCross) (hw : w ∈ Q) (hthree : ∀ q ∈ Q, q ≠ w → q ∈ gaussianImage g coordinateFrame) :\n    w ∈ gaussianImage g coordinateFrame :=\n  by\n  have hQ' := (isQuartet_gaussianImage g⁻¹ Q).mpr hQ\n  have hw' : g⁻¹ • w ∈ gaussianImage g⁻¹ Q := Set.mem_image_of_mem _ hw\n  have hthree' : ∀ q ∈ gaussianImage g⁻¹ Q, q ≠ g⁻¹ • w → q ∈ coordinateFrame :=\n    by\n    rintro q ⟨z, hz, rfl⟩ hne\n    have hz' := hthree z hz (by intro he; subst z; exact hne rfl)\n    obtain ⟨u, hu, he⟩ := hz'\n    rw [← he]\n    change g⁻¹ • (g • u) ∈ coordinateFrame\n    rwa [inv_smul_smul]\n  have h := quartet_three_in_coordinateFrame _ hQ' _ hw' hthree'\n  have hh : g • (g⁻¹ • w) ∈ gaussianImage g coordinateFrame := Set.mem_image_of_mem _ h\n  simpa only [smul_inv_smul] using hh`.\n\nNote: This linter can be disabled with `set_option linter.style.header false`",
